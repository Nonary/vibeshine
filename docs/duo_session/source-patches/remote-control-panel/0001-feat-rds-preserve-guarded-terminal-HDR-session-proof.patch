+
+$ErrorActionPreference = "Stop"
+$TaskName = "Sunshine-TermService-Compatibility-Rollback"
+$ProofRoot = Join-Path $env:ProgramData "Sunshine\RdpHdrProof"
+$StagedScript = Join-Path $ProofRoot "termservice_compat_guard.ps1"
+$StatePath = Join-Path $ProofRoot "termservice-compat-state.json"
+$LogPath = Join-Path $ProofRoot "termservice-compat-guard.log"
