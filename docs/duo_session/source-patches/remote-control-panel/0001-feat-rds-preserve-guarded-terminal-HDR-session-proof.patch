+    if (FAILED(hr)) {
+      DestroyWindow(window);
+      LogState(L"d3d9-after-failure", monitor_info.szDevice);
+      return 23;
+    }
+
+    for (UINT frame = 0; frame < 300; ++frame) {
+      MSG message = {};
+      while (PeekMessageW(&message, nullptr, 0, 0, PM_REMOVE)) {
+        TranslateMessage(&message);
+        DispatchMessageW(&message);
+      }
+      device->Clear(0, nullptr, D3DCLEAR_TARGET, D3DCOLOR_XRGB(255, 64, 16), 1.0f, 0);
+      const HRESULT present_hr = device->PresentEx(nullptr, nullptr, nullptr, nullptr, 0);
+      if (frame == 0 || frame == 30 || frame == 120 || frame == 299) {
+        Log(L"D3D9Ex PresentEx frame=%lu hr=0x%08lx", frame, present_hr);
+        LogState(L"d3d9-during", monitor_info.szDevice);
+      }
+      Sleep(10);
+    }
+
+    device.Reset();
+    DestroyWindow(window);
+    LogState(L"d3d9-after", monitor_info.szDevice);
+    Log(L"D3D9Ex complete");
+    return 0;
+  }
+
+  int Run(bool legacy_exclusive) {
+    DWORD session = 0xffffffff;
+    ProcessIdToSessionId(GetCurrentProcessId(), &session);
+    Log(L"begin authentic process session=%lu", session);
+
+    ComPtr<IDXGIFactory6> factory;
+    HRESULT hr = CreateDXGIFactory1(IID_PPV_ARGS(&factory));
+    if (FAILED(hr)) {
+      Log(L"CreateDXGIFactory1 failed hr=0x%08lx", hr);
+      return 2;
+    }
+
+    ComPtr<IDXGIAdapter1> selected_adapter;
+    ComPtr<IDXGIOutput> selected_output;
+    DXGI_OUTPUT_DESC output_desc = {};
+    for (UINT adapter_index = 0; ; ++adapter_index) {
+      ComPtr<IDXGIAdapter1> adapter;
+      if (factory->EnumAdapters1(adapter_index, &adapter) == DXGI_ERROR_NOT_FOUND) {
+        break;
+      }
+      DXGI_ADAPTER_DESC1 adapter_desc = {};
+      adapter->GetDesc1(&adapter_desc);
+      for (UINT output_index = 0; ; ++output_index) {
+        ComPtr<IDXGIOutput> output;
+        if (adapter->EnumOutputs(output_index, &output) == DXGI_ERROR_NOT_FOUND) {
+          break;
+        }
+        DXGI_OUTPUT_DESC desc = {};
+        output->GetDesc(&desc);
+        Log(
+          L"output adapter=%s device=%s attached=%d rect=%ld,%ld-%ld,%ld",
+          adapter_desc.Description,
+          desc.DeviceName,
+          desc.AttachedToDesktop,
+          desc.DesktopCoordinates.left,
+          desc.DesktopCoordinates.top,
+          desc.DesktopCoordinates.right,
+          desc.DesktopCoordinates.bottom
+        );
+        if (!selected_output && desc.AttachedToDesktop) {
+          selected_adapter = adapter;
+          selected_output = output;
+          output_desc = desc;
+        }
+      }
+    }
+    if (!selected_adapter || !selected_output) {
+      Log(L"no attached DXGI output");
+      return 3;
+    }
+    LogState(L"before", output_desc.DeviceName);
+
+    ComPtr<ID3D11Device> device;
+    ComPtr<ID3D11DeviceContext> context;
+    D3D_FEATURE_LEVEL level = {};
+    hr = D3D11CreateDevice(
+      selected_adapter.Get(),
+      D3D_DRIVER_TYPE_UNKNOWN,
+      nullptr,
+      D3D11_CREATE_DEVICE_BGRA_SUPPORT,
+      nullptr,
+      0,
+      D3D11_SDK_VERSION,
+      &device,
+      &level,
+      &context
+    );
+    if (FAILED(hr)) {
+      Log(L"D3D11CreateDevice failed hr=0x%08lx", hr);
+      return 4;
+    }
+
+    WNDCLASSW window_class = {};
+    window_class.lpfnWndProc = WindowProc;
+    window_class.hInstance = GetModuleHandleW(nullptr);
+    window_class.lpszClassName = L"SunshineRdpFp16PinProof";
+    RegisterClassW(&window_class);
+    const LONG width = output_desc.DesktopCoordinates.right - output_desc.DesktopCoordinates.left;
+    const LONG height = output_desc.DesktopCoordinates.bottom - output_desc.DesktopCoordinates.top;
+    HWND window = CreateWindowExW(
+      WS_EX_TOPMOST,
+      window_class.lpszClassName,
+      L"FP16 source pin proof",
+      WS_POPUP | WS_VISIBLE,
+      output_desc.DesktopCoordinates.left,
+      output_desc.DesktopCoordinates.top,
+      width,
+      height,
+      nullptr,
+      nullptr,
+      window_class.hInstance,
+      nullptr
+    );
+    if (!window) {
+      Log(L"CreateWindowEx failed error=%lu", GetLastError());
+      return 5;
+    }
+
+    ComPtr<IDXGIFactory2> factory2;
+    selected_adapter->GetParent(IID_PPV_ARGS(&factory2));
+    DXGI_SWAP_CHAIN_DESC1 swap_desc = {};
+    swap_desc.Width = static_cast<UINT>(width);
+    swap_desc.Height = static_cast<UINT>(height);
+    swap_desc.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+    swap_desc.SampleDesc.Count = 1;
+    swap_desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+    swap_desc.BufferCount = 2;
+    swap_desc.Scaling = DXGI_SCALING_STRETCH;
+    swap_desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+    swap_desc.AlphaMode = DXGI_ALPHA_MODE_IGNORE;
+    ComPtr<IDXGISwapChain1> swap_chain;
+    bool fullscreen = false;
+    if (legacy_exclusive) {
+      DXGI_SWAP_CHAIN_DESC legacy_desc = {};
+      legacy_desc.BufferDesc.Width = static_cast<UINT>(width);
+      legacy_desc.BufferDesc.Height = static_cast<UINT>(height);
+      legacy_desc.BufferDesc.RefreshRate.Numerator = 60;
+      legacy_desc.BufferDesc.RefreshRate.Denominator = 1;
+      legacy_desc.BufferDesc.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+      legacy_desc.SampleDesc.Count = 1;
+      legacy_desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+      legacy_desc.BufferCount = 2;
+      legacy_desc.OutputWindow = window;
+      legacy_desc.Windowed = FALSE;
+      legacy_desc.SwapEffect = DXGI_SWAP_EFFECT_DISCARD;
+      legacy_desc.Flags = DXGI_SWAP_CHAIN_FLAG_ALLOW_MODE_SWITCH;
+      ComPtr<IDXGISwapChain> legacy_swap_chain;
+      hr = factory2->CreateSwapChain(device.Get(), &legacy_desc, &legacy_swap_chain);
+      Log(L"CreateSwapChain legacy-exclusive FP16 hr=0x%08lx", hr);
+      if (SUCCEEDED(hr)) {
+        legacy_swap_chain.As(&swap_chain);
+        BOOL actual_fullscreen = FALSE;
+        legacy_swap_chain->GetFullscreenState(&actual_fullscreen, nullptr);
+        fullscreen = actual_fullscreen != FALSE;
+        Log(L"legacy initial fullscreen=%d", fullscreen);
+      }
+    } else {
+      hr = factory2->CreateSwapChainForHwnd(device.Get(), window, &swap_desc, nullptr, selected_output.Get(), &swap_chain);
+      Log(L"CreateSwapChainForHwnd FP16 hr=0x%08lx", hr);
+    }
+    if (FAILED(hr)) {
+      DestroyWindow(window);
+      return 6;
+    }
+
+    ComPtr<IDXGISwapChain3> swap_chain3;
+    swap_chain.As(&swap_chain3);
+    UINT color_support = 0;
+    hr = swap_chain3->CheckColorSpaceSupport(DXGI_COLOR_SPACE_RGB_FULL_G10_NONE_P709, &color_support);
+    Log(L"CheckColorSpaceSupport scRGB hr=0x%08lx support=0x%08lx", hr, color_support);
+    hr = swap_chain3->SetColorSpace1(DXGI_COLOR_SPACE_RGB_FULL_G10_NONE_P709);
+    Log(L"SetColorSpace1 scRGB hr=0x%08lx", hr);
+
+    DXGI_MODE_DESC mode = {};
+    mode.Width = static_cast<UINT>(width);
+    mode.Height = static_cast<UINT>(height);
+    mode.RefreshRate.Numerator = 60;
+    mode.RefreshRate.Denominator = 1;
+    mode.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+    mode.ScanlineOrdering = DXGI_MODE_SCANLINE_ORDER_UNSPECIFIED;
+    mode.Scaling = DXGI_MODE_SCALING_UNSPECIFIED;
+    hr = swap_chain->ResizeTarget(&mode);
+    Log(L"ResizeTarget FP16 pre-fullscreen hr=0x%08lx", hr);
+    if (!fullscreen) {
+      hr = swap_chain->SetFullscreenState(TRUE, selected_output.Get());
+      Log(L"SetFullscreenState TRUE hr=0x%08lx", hr);
+      fullscreen = SUCCEEDED(hr);
+    }
+    if (fullscreen) {
+      hr = swap_chain->ResizeTarget(&mode);
+      Log(L"ResizeTarget FP16 fullscreen hr=0x%08lx", hr);
+      hr = swap_chain->ResizeBuffers(
+        swap_desc.BufferCount,
+        static_cast<UINT>(width),
+        static_cast<UINT>(height),
+        swap_desc.Format,
+        0
+      );
+      Log(L"ResizeBuffers FP16 fullscreen hr=0x%08lx", hr);
+      if (SUCCEEDED(hr)) {
+        hr = swap_chain3->SetColorSpace1(DXGI_COLOR_SPACE_RGB_FULL_G10_NONE_P709);
+        Log(L"SetColorSpace1 scRGB post-resize hr=0x%08lx", hr);
+      }
+    }
+
+    ComPtr<ID3D11Texture2D> back_buffer;
+    ComPtr<ID3D11RenderTargetView> render_target;
+    hr = swap_chain->GetBuffer(0, IID_PPV_ARGS(&back_buffer));
+    if (SUCCEEDED(hr)) {
+      hr = device->CreateRenderTargetView(back_buffer.Get(), nullptr, &render_target);
+    }
+    Log(L"CreateRenderTargetView hr=0x%08lx", hr);
+    const float clear[4] = {1.25f, 0.25f, 0.05f, 1.0f};
+    for (UINT frame = 0; frame < 300; ++frame) {
+      MSG message = {};
+      while (PeekMessageW(&message, nullptr, 0, 0, PM_REMOVE)) {
+        TranslateMessage(&message);
+        DispatchMessageW(&message);
+      }
+      if (render_target) {
+        context->ClearRenderTargetView(render_target.Get(), clear);
+      }
+      const HRESULT present_hr = swap_chain->Present(1, 0);
+      if (frame == 0 || frame == 30 || frame == 120 || frame == 299) {
+        Log(L"Present frame=%lu hr=0x%08lx", frame, present_hr);
+        LogState(L"during", output_desc.DeviceName);
+      }
+      Sleep(10);
+    }
+
+    if (fullscreen) {
+      hr = swap_chain->SetFullscreenState(FALSE, nullptr);
+      Log(L"SetFullscreenState FALSE hr=0x%08lx", hr);
+    }
+    DestroyWindow(window);
+    LogState(L"after", output_desc.DeviceName);
+    Log(L"complete");
+    return 0;
+  }
+
+  int RunD3dKmtOwnedDxgiExclusive() {
+    DWORD session = 0xffffffff;
+    ProcessIdToSessionId(GetCurrentProcessId(), &session);
+    Log(L"D3DKMT-owned DXGI exclusive begin process_session=%lu", session);
+
+    constexpr UINT32 flags = QDC_ONLY_ACTIVE_PATHS | QDC_VIRTUAL_MODE_AWARE;
+    UINT32 path_count = 0;
+    UINT32 mode_count = 0;
+    LONG result = GetDisplayConfigBufferSizes(flags, &path_count, &mode_count);
+    if (result != ERROR_SUCCESS || path_count != 1) {
+      Log(L"D3DKMT-owned DXGI GetDisplayConfigBufferSizes result=%ld paths=%lu", result, path_count);
+      return 60;
+    }
+    std::vector<DISPLAYCONFIG_PATH_INFO> paths(path_count);
+    std::vector<DISPLAYCONFIG_MODE_INFO> modes(mode_count);
+    result = QueryDisplayConfig(flags, &path_count, paths.data(), &mode_count, modes.data(), nullptr);
+    if (result != ERROR_SUCCESS || path_count != 1) {
+      Log(L"D3DKMT-owned DXGI QueryDisplayConfig result=%ld paths=%lu", result, path_count);
+      return 61;
+    }
+
+    D3DKMT_OPENADAPTERFROMLUID open = {};
+    open.AdapterLuid = paths[0].sourceInfo.adapterId;
+    NTSTATUS status = D3DKMTOpenAdapterFromLuid(&open);
+    Log(L"D3DKMT-owned DXGI OpenAdapter status=0x%08lx", status);
+    if (status < 0) {
+      return 62;
+    }
+    D3DKMT_CREATEDEVICE create = {};
+    create.hAdapter = open.hAdapter;
+    status = D3DKMTCreateDevice(&create);
+    Log(L"D3DKMT-owned DXGI CreateDevice status=0x%08lx", status);
+    if (status < 0) {
+      D3DKMT_CLOSEADAPTER close = {open.hAdapter};
+      D3DKMTCloseAdapter(&close);
+      return 63;
+    }
+
+    const D3DKMT_VIDPNSOURCEOWNER_TYPE owner_type = D3DKMT_VIDPNSOURCEOWNER_EXCLUSIVE;
+    const D3DDDI_VIDEO_PRESENT_SOURCE_ID source_id = paths[0].sourceInfo.id;
+    D3DKMT_SETVIDPNSOURCEOWNER owner = {};
+    owner.hDevice = create.hDevice;
+    owner.pType = &owner_type;
+    owner.pVidPnSourceId = &source_id;
+    owner.VidPnSourceCount = 1;
+    status = D3DKMTSetVidPnSourceOwner(&owner);
+    Log(
+      L"D3DKMT-owned DXGI SetVidPnSourceOwner status=0x%08lx global_exclusive=%d",
+      status,
+      D3DKMTCheckExclusiveOwnership()
+    );
+
+    int dxgi_result = 64;
+    if (status >= 0) {
+      dxgi_result = Run(true);
+      const NTSTATUS release = D3DKMTReleaseProcessVidPnSourceOwners(GetCurrentProcess());
+      Log(L"D3DKMT-owned DXGI ReleaseProcessVidPnSourceOwners status=0x%08lx", release);
+    }
+    D3DKMT_DESTROYDEVICE destroy = {create.hDevice};
+    const NTSTATUS destroy_status = D3DKMTDestroyDevice(&destroy);
+    D3DKMT_CLOSEADAPTER close = {open.hAdapter};
+    const NTSTATUS close_status = D3DKMTCloseAdapter(&close);
+    Log(
+      L"D3DKMT-owned DXGI complete dxgi_result=%d destroy=0x%08lx close=0x%08lx",
+      dxgi_result,
+      destroy_status,
+      close_status
+    );
+    return dxgi_result;
+  }
+}
+
+int wmain(int argc, wchar_t **argv) {
+  if (argc > 1 && _wcsicmp(argv[1], L"--d3dkmt-shared-primary-inspect") == 0) {
+    return RunD3dKmtSharedPrimaryInspect();
+  }
+  if (argc > 1 && _wcsicmp(argv[1], L"--d3dkmt-owned-dxgi-exclusive") == 0) {
+    return RunD3dKmtOwnedDxgiExclusive();
+  }
+  if (argc > 1 && _wcsicmp(argv[1], L"--d3dkmt-fp16-primary") == 0) {
+    return RunD3dKmtPrimary(false, DXGI_FORMAT_R16G16B16A16_FLOAT, true);
+  }
+  if (argc > 1 && _wcsicmp(argv[1], L"--d3dkmt-cloned-fp16-primary") == 0) {
+    return RunD3dKmtPrimary(true, DXGI_FORMAT_R16G16B16A16_FLOAT, false);
+  }
+  if (argc > 1 && _wcsicmp(argv[1], L"--d3dkmt-cloned-fp16-primary-then-scrgb") == 0) {
+    const int pin_result = RunD3dKmtPrimary(true, DXGI_FORMAT_R16G16B16A16_FLOAT, false);
+    if (pin_result != 0) {
+      return pin_result;
+    }
+    return Run(false);
+  }
+  if (argc > 1 && _wcsicmp(argv[1], L"--d3dkmt-cloned-fp16-primary-preserve") == 0) {
+    return RunD3dKmtPrimary(true, DXGI_FORMAT_R16G16B16A16_FLOAT, true);
+  }
+  if (argc > 1 && _wcsicmp(argv[1], L"--d3dkmt-cloned-bgra8-primary-preserve") == 0) {
+    return RunD3dKmtPrimary(true, DXGI_FORMAT_B8G8R8A8_UNORM, true);
+  }
+  if (argc > 1 && _wcsicmp(argv[1], L"--d3dkmt-owner-matrix") == 0) {
+    return RunD3dKmtOwnerMatrix();
+  }
+  if (argc > 1 && _wcsicmp(argv[1], L"--d3d9-exclusive") == 0) {
+    return RunD3d9Exclusive();
+  }
+  const bool legacy_exclusive = argc > 1 && _wcsicmp(argv[1], L"--legacy-exclusive") == 0;
+  return Run(legacy_exclusive);
+}
diff --git a/source/tools/rdp-protocol-provider/live_rdp_keeper.ps1 b/source/tools/rdp-protocol-provider/live_rdp_keeper.ps1
