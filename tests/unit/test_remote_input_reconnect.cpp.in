void check(bool condition, const char *message) {
  if (!condition) {
    throw std::runtime_error(message);
  }
}

struct log_t {
  template<class T>
  log_t &operator<<(const T &) {
    return *this;
  }
};

#define BOOST_LOG(level) \
  log_t {}
int config_clears = 0, draining = 0, finalizes = 0;
std::function<void()> after_disconnect;
std::function<void()> during_activity_check, before_cleanup_lock;
thread_local bool expiry_worker = false, retry_worker = false;
thread_local int cleanup_lock_depth = 0;

// Observe the lock attempt without changing the production critical sections.
struct observed_mutex_t {
  std::mutex mutex;

  void lock() {
    if (retry_worker && before_cleanup_lock) {
      before_cleanup_lock();
    }
    mutex.lock();
    ++cleanup_lock_depth;
  }

  void unlock() {
    --cleanup_lock_depth;
    mutex.unlock();
  }
};

void set_vulkan_hdr_layer_streaming_active(bool) {}
std::vector<std::function<void()>> timer_callbacks;
int timer_delay_ms = 0;
namespace boost::system { struct error_code { explicit operator bool() const { return false; } }; }
namespace boost::asio {
  struct steady_timer {
    steady_timer(int &, std::chrono::milliseconds delay) { timer_delay_ms = static_cast<int>(delay.count()); }
    template<class F> void async_wait(F &&fn) {
      timer_callbacks.emplace_back([fn = std::forward<F>(fn)] { fn(boost::system::error_code {}); });
    }
  };
}

namespace config {
  struct {
    std::chrono::seconds ping_timeout {30};
  } stream;

  struct {
    bool app_resume_terminate = true;
  } video;

  std::unordered_map<std::string, std::string> runtime_overrides;
  int sets = 0;
  std::atomic<int> applies {0};

  void set_runtime_config_overrides(std::unordered_map<std::string, std::string> overrides) {
    ++sets;
    runtime_overrides = std::move(overrides);
  }

  void clear_runtime_config_overrides() {
    ++config_clears;
    runtime_overrides.clear();
  }

  void apply_config_now() {
    check(cleanup_lock_depth == 0, "config apply must not retain the input cleanup lock");
    ++applies;
  }
}  // namespace config

