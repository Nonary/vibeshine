+
+  /**
+   * @brief Arm one exact seat-local WCG request in volatile machine state.
+   *
+   * The provider accepts this key only when the volatile proof marker is also
+   * present. The deadline rollback removes it explicitly, and Windows removes
+   * it automatically on reboot.
+   *
+   * @return Zero only when the bounded bootstrap command was armed.
+   */
+  int
+    ArmWcgTokenLaunch() {
+    const std::wstring transition = JoinPath(GetProofDirectory(), kRemoteTransitionName);
+    if (transition.empty() || GetFileAttributesW(transition.c_str()) == INVALID_FILE_ATTRIBUTES) {
+      return Fail(L"find staged session-local HDR transition", ERROR_FILE_NOT_FOUND);
+    }
+
+    wchar_t command[MAX_PATH * 2] = {};
+    if (FAILED(StringCchPrintfW(
+          command,
+          ARRAYSIZE(command),
+          L"\"%s\"",
+          transition.c_str()
+        ))) {
+      return Fail(L"format session-local WCG-to-HDR command", ERROR_INSUFFICIENT_BUFFER);
+    }
+
+    RegDeleteTreeW(HKEY_LOCAL_MACHINE, kTokenLaunchRuntimeArmPath);
+    PSECURITY_DESCRIPTOR security_descriptor = nullptr;
+    if (!ConvertStringSecurityDescriptorToSecurityDescriptorW(
+          L"D:P(A;;KA;;;SY)(A;;KA;;;BA)(A;;KR;;;NS)",
+          SDDL_REVISION_1,
+          &security_descriptor,
+          nullptr
+        )) {
+      return Fail(L"create WCG token-launch security descriptor", GetLastError());
+    }
+    SECURITY_ATTRIBUTES attributes = {sizeof(attributes), security_descriptor, FALSE};
+    HKEY key = nullptr;
+    DWORD disposition = 0;
+    LSTATUS status = RegCreateKeyExW(
+      HKEY_LOCAL_MACHINE,
+      kTokenLaunchRuntimeArmPath,
+      0,
+      nullptr,
+      REG_OPTION_VOLATILE,
+      KEY_SET_VALUE | KEY_QUERY_VALUE,
+      &attributes,
+      &key,
+      &disposition
+    );
+    LocalFree(security_descriptor);
+    if (status != ERROR_SUCCESS) {
+      return Fail(L"create volatile WCG token-launch arm", status);
+    }
+
+    status = SetDword(key, L"Armed", 1);
+    if (status == ERROR_SUCCESS) {
+      status = SetDword(key, kProofMarkerName, 1);
+    }
+    if (status == ERROR_SUCCESS) {
+      status = SetDword(key, L"DelayMs", 2500);
+    }
+    if (status == ERROR_SUCCESS) {
+      // Launch with the authentic seat token. The WCG proof driver alone opts
+      // its session-scoped control device into Builtin Users read/write; normal
+      // driver builds keep the default restricted WDF descriptor.
+      status = SetDword(key, L"UseSystemToken", 0);
+    }
+    if (status == ERROR_SUCCESS) {
+      status = SetString(key, L"CommandLine", command);
+    }
+    RegCloseKey(key);
+
+    if (status != ERROR_SUCCESS) {
+      RegDeleteTreeW(HKEY_LOCAL_MACHINE, kTokenLaunchRuntimeArmPath);
+      return Fail(L"write volatile WCG token-launch arm", status);
+    }
+    Log(L"armed volatile seat-local WCG bootstrap");
+    wprintf(L"armed volatile seat-local WCG bootstrap\n");
+    return 0;
+  }
+
+  /**
+   * @brief Verify the complete fail-closed machine state.
+   *
+   * @return Zero when every invariant holds.
+   */
+  int AssertSafeBaseline() {
+    const bool safe_provider = IsSafeProviderUnchanged();
+    const bool legacy_disabled = IsListenerDisabled(kLegacyListenerName, true);
+    const bool proof_listener_absent = IsListenerDisabled(kProofListenerName, false) &&
+                                       !RegistryKeyExists(HKEY_LOCAL_MACHINE, (std::wstring(kListenerRoot) + L"\\" + kProofListenerName).c_str());
+    const bool proof_provider_absent = !RegistryKeyExists(HKEY_LOCAL_MACHINE, kProofProviderRegistryPath);
+    const bool runtime_arm_absent = !RegistryKeyExists(HKEY_LOCAL_MACHINE, kRuntimeArmRegistryPath);
+    const bool token_launch_arm_absent = !RegistryKeyExists(HKEY_LOCAL_MACHINE, kTokenLaunchRuntimeArmPath);
+    const bool credential_absent = IsProofCredentialAbsent();
+    const bool proof_user_absent = !ProofUserExists() && !HasProofUserMarker();
+    const DWORD helpers = FindExpectedHelpers(false);
+
+    wprintf(
+      L"safe_provider=%d legacy_listener_disabled=%d proof_listener_absent=%d proof_provider_absent=%d runtime_arm_absent=%d token_launch_arm_absent=%d credential_absent=%d proof_user_absent=%d helper_count=%lu\n",
+      safe_provider,
+      legacy_disabled,
+      proof_listener_absent,
+      proof_provider_absent,
+      runtime_arm_absent,
+      token_launch_arm_absent,
+      credential_absent,
+      proof_user_absent,
+      helpers
+    );
+    return safe_provider && legacy_disabled && proof_listener_absent && proof_provider_absent && runtime_arm_absent && token_launch_arm_absent && credential_absent && proof_user_absent && helpers == 0 ? 0 : 1;
+  }
+
+  /**
+   * @brief Restore every proof-owned machine setting to the fail-closed state.
+   *
+   * @return Zero only when the safe baseline validates afterward.
+   */
+  int Rollback() {
+    Log(L"rollback begin");
+    FindExpectedHelpers(true);
+    const bool activation_was_armed = RegistryKeyExists(HKEY_LOCAL_MACHINE, kRuntimeArmRegistryPath);
+    if (!QuiesceProofSeat(activation_was_armed)) {
+      return 1;
+    }
+    RegDeleteTreeW(HKEY_LOCAL_MACHINE, kRuntimeArmRegistryPath);
+    RegDeleteTreeW(HKEY_LOCAL_MACHINE, kTokenLaunchRuntimeArmPath);
+    DisableLiveListener(kProofListenerName);
+    DisableListener(kProofListenerName);
+    DisableListener(kLegacyListenerName);
+    DeleteProofCredential();
+    const bool proof_user_deleted = DeleteProofUser();
+
+    const std::wstring listener_path = std::wstring(kListenerRoot) + L"\\" + kProofListenerName;
+    LSTATUS listener_delete = RegDeleteTreeW(HKEY_LOCAL_MACHINE, listener_path.c_str());
+    if (listener_delete == ERROR_FILE_NOT_FOUND || listener_delete == ERROR_PATH_NOT_FOUND) {
+      listener_delete = ERROR_SUCCESS;
+    }
+    LSTATUS provider_delete = RegDeleteTreeW(HKEY_LOCAL_MACHINE, kProofProviderRegistryPath);
+    if (provider_delete == ERROR_FILE_NOT_FOUND || provider_delete == ERROR_PATH_NOT_FOUND) {
+      provider_delete = ERROR_SUCCESS;
+    }
+
+    const int safe = AssertSafeBaseline();
+    wchar_t message[512] = {};
+    StringCchPrintfW(
+      message,
+      ARRAYSIZE(message),
+      L"rollback complete listener_delete=%ld provider_delete=%ld proof_user_deleted=%d safe=%d",
+      listener_delete,
+      provider_delete,
+      proof_user_deleted,
+      safe == 0
+    );
+    Log(message);
+    return listener_delete == ERROR_SUCCESS && provider_delete == ERROR_SUCCESS && proof_user_deleted && safe == 0 ? 0 : 1;
+  }
+
+  /**
+   * @brief Create harmless state for the external SYSTEM deadline test.
+   *
+   * @return Zero on success.
+   */
+  int CreateSelfTestFault() {
+    if (!EnsureProofDirectory()) {
+      return Fail(L"create proof directory", GetLastError());
+    }
+
+    HKEY key = nullptr;
+    LSTATUS status = RegCreateKeyExW(
+      HKEY_LOCAL_MACHINE,
+      kSelfTestRegistryPath,
+      0,
+      nullptr,
+      0,
+      KEY_WRITE,
+      nullptr,
+      &key,
+      nullptr
+    );
+    if (status != ERROR_SUCCESS) {
+      return Fail(L"create self-test registry fault", status);
+    }
+    status = SetDword(key, L"Armed", 1);
+    RegCloseKey(key);
+    if (status != ERROR_SUCCESS) {
+      return Fail(L"write self-test registry fault", status);
+    }
+
+    const std::wstring sentinel = JoinPath(GetProofDirectory(), L"rollback-self-test.sentinel");
+    const HANDLE file = CreateFileW(sentinel.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file == INVALID_HANDLE_VALUE) {
+      return Fail(L"create self-test sentinel", GetLastError());
+    }
+    CloseHandle(file);
+    Log(L"created harmless rollback self-test fault");
+    return 0;
+  }
+
+  /**
+   * @brief Remove harmless state for the external SYSTEM deadline test.
+   *
+   * @return Zero when the fault is absent afterward.
+   */
+  int RollbackSelfTest() {
+    LSTATUS status = RegDeleteTreeW(HKEY_LOCAL_MACHINE, kSelfTestRegistryPath);
+    if (status == ERROR_FILE_NOT_FOUND || status == ERROR_PATH_NOT_FOUND) {
+      status = ERROR_SUCCESS;
+    }
+    const std::wstring sentinel = JoinPath(GetProofDirectory(), L"rollback-self-test.sentinel");
+    const bool deleted = DeleteFileW(sentinel.c_str()) || GetLastError() == ERROR_FILE_NOT_FOUND;
+    Log(L"completed harmless rollback self-test");
+    return status == ERROR_SUCCESS && deleted ? 0 : 1;
+  }
+
+  /**
+   * @brief Verify harmless rollback test state is absent.
+   *
+   * @return Zero when clean.
+   */
+  int VerifySelfTestClean() {
+    const std::wstring sentinel = JoinPath(GetProofDirectory(), L"rollback-self-test.sentinel");
+    const bool clean = !RegistryKeyExists(HKEY_LOCAL_MACHINE, kSelfTestRegistryPath) &&
+                       GetFileAttributesW(sentinel.c_str()) == INVALID_FILE_ATTRIBUTES;
+    wprintf(L"rollback_self_test_clean=%d\n", clean);
+    return clean ? 0 : 1;
+  }
+
+  /**
+   * @brief Exercise newly-created volatile registry semantics without touching RDS.
+   *
+   * @return Zero when create, reopen, marker validation, and deletion succeed.
+   */
+  int RunVolatileRegistrySelfTest() {
+    RegDeleteTreeW(HKEY_LOCAL_MACHINE, kVolatileSelfTestRegistryPath);
+    HKEY key = nullptr;
+    DWORD disposition = 0;
+    LSTATUS status = RegCreateKeyExW(
+      HKEY_LOCAL_MACHINE,
+      kVolatileSelfTestRegistryPath,
+      0,
+      nullptr,
+      REG_OPTION_VOLATILE,
+      KEY_READ | KEY_WRITE,
+      nullptr,
+      &key,
+      &disposition
+    );
+    if (status != ERROR_SUCCESS || disposition != REG_CREATED_NEW_KEY) {
+      if (key) {
+        RegCloseKey(key);
+      }
+      return Fail(L"create volatile self-test key", status == ERROR_SUCCESS ? ERROR_INVALID_STATE : status);
+    }
+    status = SetDword(key, kProofMarkerName, 1);
+    RegCloseKey(key);
+    if (status != ERROR_SUCCESS) {
+      return Fail(L"write volatile self-test marker", status);
+    }
+
+    status = RegOpenKeyExW(HKEY_LOCAL_MACHINE, kVolatileSelfTestRegistryPath, 0, KEY_QUERY_VALUE, &key);
+    DWORD marker = 0;
+    const bool valid = status == ERROR_SUCCESS && QueryDword(key, kProofMarkerName, &marker) && marker == 1;
+    if (key) {
+      RegCloseKey(key);
+    }
+    const LSTATUS delete_status = RegDeleteTreeW(HKEY_LOCAL_MACHINE, kVolatileSelfTestRegistryPath);
+    wprintf(L"volatile_registry_self_test=%d\n", valid && delete_status == ERROR_SUCCESS);
+    return valid && delete_status == ERROR_SUCCESS ? 0 : 1;
+  }
+
+  /**
+   * @brief Print proof identity constants for script-side verification.
+   */
+  void
+    PrintIdentity() {
+    wprintf(
+      L"safe_clsid=%s\nproof_clsid=%s\nproof_listener=%s\nproof_provider=%s\nproof_helper=%s\nwcg_bootstrap=%s\nremote_probe=%s\nremote_transition=%s\n",
+      kSafeProviderClsid,
+      kProofProviderClsid,
+      kProofListenerName,
+      kProofProviderName,
+      kProofHelperName,
+      kWcgBootstrapName,
+      kRemoteProbeName,
+      kRemoteTransitionName
+    );
+  }
+
+}  // namespace
+
+/**
+ * @brief Manage the fail-closed native RdpIdd HDR proof boundary.
+ *
+ * @param argc Argument count.
+ * @param argv Argument vector.
+ * @return Zero on success.
+ */
+int wmain(int argc, wchar_t **argv) {
+  if (argc != 2) {
+    fwprintf(
+      stderr,
+      L"usage: SunshineRdpHdrProofControl.exe --identity|--assert-safe|--create-proof-user|--create-volatile-listener-disabled|--create-persistent-listener-disabled|--arm-wcg-token-launch|--enable-listener-for-current-boot|--enable-duo-listener-for-current-boot|--rollback|--create-self-test-fault|--rollback-self-test|--verify-self-test-clean|--volatile-registry-self-test\n"
+    );
+    return 2;
+  }
+
+  if (_wcsicmp(argv[1], L"--identity") == 0) {
+    PrintIdentity();
+    return 0;
+  }
+  if (_wcsicmp(argv[1], L"--assert-safe") == 0) {
+    return AssertSafeBaseline();
+  }
+  if (_wcsicmp(argv[1], L"--create-volatile-listener-disabled") == 0) {
+    return CreateVolatileListenerDisabled();
+  }
+  if (_wcsicmp(argv[1], L"--create-persistent-listener-disabled") == 0) {
+    return CreatePersistentListenerDisabled();
+  }
+  if (_wcsicmp(argv[1], L"--create-proof-user") == 0) {
+    return CreateProofUser();
+  }
+  if (_wcsicmp(argv[1], L"--arm-wcg-token-launch") == 0) {
+    return ArmWcgTokenLaunch();
+  }
+  if (_wcsicmp(argv[1], L"--enable-listener-for-current-boot") == 0) {
+    return EnableListenerForCurrentBoot(kProofProviderClsid);
+  }
+  if (_wcsicmp(argv[1], L"--enable-duo-listener-for-current-boot") == 0) {
+    return EnableListenerForCurrentBoot(kDuoProviderClsid);
+  }
+  if (_wcsicmp(argv[1], L"--rollback") == 0) {
+    return Rollback();
+  }
+  if (_wcsicmp(argv[1], L"--create-self-test-fault") == 0) {
+    return CreateSelfTestFault();
+  }
+  if (_wcsicmp(argv[1], L"--rollback-self-test") == 0) {
+    return RollbackSelfTest();
+  }
+  if (_wcsicmp(argv[1], L"--verify-self-test-clean") == 0) {
+    return VerifySelfTestClean();
+  }
+  if (_wcsicmp(argv[1], L"--volatile-registry-self-test") == 0) {
+    return RunVolatileRegistrySelfTest();
+  }
+
+  return 2;
+}
