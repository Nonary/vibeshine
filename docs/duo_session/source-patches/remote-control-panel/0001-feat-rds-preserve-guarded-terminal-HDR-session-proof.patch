+  LONG FindAdvancedColorPath(const DisplayConfigApi &api, AdvancedColorPath *selected) {
+    constexpr UINT32 query_flags = QDC_ONLY_ACTIVE_PATHS | QDC_VIRTUAL_MODE_AWARE;
+    for (DWORD attempt = 0; attempt < kDisplayConfigRetryCount; ++attempt) {
+      UINT32 path_count = 0;
+      UINT32 mode_count = 0;
+      LONG result = api.get_buffer_sizes(query_flags, &path_count, &mode_count);
+      if (result != ERROR_SUCCESS) {
+        Sleep(kDisplayConfigRetryDelayMs);
+        continue;
+      }
+
+      std::vector<DISPLAYCONFIG_PATH_INFO> paths(path_count);
+      std::vector<DISPLAYCONFIG_MODE_INFO> modes(mode_count);
+      result = api.query(
+        query_flags,
+        &path_count,
+        paths.data(),
+        &mode_count,
+        modes.data(),
+        nullptr
+      );
+      if (result == ERROR_INSUFFICIENT_BUFFER) {
+        --attempt;
+        continue;
+      }
+      if (result != ERROR_SUCCESS) {
+        Sleep(kDisplayConfigRetryDelayMs);
+        continue;
+      }
+
+      for (UINT32 index = 0; index < path_count; ++index) {
+        DISPLAYCONFIG_GET_ADVANCED_COLOR_INFO_2 state {};
+        result = QueryAdvancedColor(api, paths[index], &state);
+        if (result != ERROR_SUCCESS || !state.highDynamicRangeSupported || !state.wideColorSupported) {
+          continue;
+        }
+
+        selected->path = paths[index];
+        selected->state = state;
+        const UINT32 source_mode_index = paths[index].sourceInfo.sourceModeInfoIdx;
+        if (source_mode_index != DISPLAYCONFIG_PATH_SOURCE_MODE_IDX_INVALID &&
+            source_mode_index < mode_count &&
+            modes[source_mode_index].infoType == DISPLAYCONFIG_MODE_INFO_TYPE_SOURCE) {
+          selected->source_pixel_format = static_cast<UINT32>(modes[source_mode_index].sourceMode.pixelFormat);
+        }
+        return ERROR_SUCCESS;
+      }
+      Sleep(kDisplayConfigRetryDelayMs);
+    }
+    return ERROR_NOT_FOUND;
