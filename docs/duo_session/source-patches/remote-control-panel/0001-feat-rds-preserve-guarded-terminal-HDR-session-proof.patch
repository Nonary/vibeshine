+enum class RemoteIddDesktopModePolicy {
+  DriverOnly,  ///< Trust the Remote IDD Update2 request and do not call ChangeDisplaySettingsExW.
+  PositionOnly,  ///< Attach an inactive target using only DM_POSITION.
+  LegacyGdi,  ///< Retain the original width, height, refresh, position, and 32-bpp request.
+};
