+  /**
+   * @brief Return the proof staging directory under ProgramData.
+   *
+   * @return Absolute directory or an empty string on failure.
+   */
+  std::wstring
+    GetProofDirectory() {
+    wchar_t program_data[MAX_PATH] = {};
+    if (!GetEnvironmentVariableW(L"ProgramData", program_data, ARRAYSIZE(program_data))) {
+      return {};
+    }
+
+    wchar_t path[MAX_PATH] = {};
+    if (FAILED(StringCchPrintfW(path, ARRAYSIZE(path), L"%s\\%s", program_data, kProofDirectorySuffix))) {
+      return {};
+    }
+    return path;
+  }
+
+  /**
+   * @brief Join a directory and filename.
+   *
+   * @param directory Parent directory.
+   * @param name Filename.
+   * @return Joined path or an empty string on failure.
+   */
+  std::wstring
+    JoinPath(const std::wstring &directory, const wchar_t *name) {
+    wchar_t path[MAX_PATH] = {};
+    if (FAILED(StringCchPrintfW(path, ARRAYSIZE(path), L"%s\\%s", directory.c_str(), name))) {
+      return {};
+    }
+    return path;
+  }
+
+  /**
+   * @brief Create the proof log directory without altering its ACL.
+   *
+   * @return True when the directory exists.
+   */
+  bool
+    EnsureProofDirectory() {
+    wchar_t program_data[MAX_PATH] = {};
+    if (!GetEnvironmentVariableW(L"ProgramData", program_data, ARRAYSIZE(program_data))) {
+      return false;
+    }
+
+    wchar_t sunshine[MAX_PATH] = {};
+    if (FAILED(StringCchPrintfW(sunshine, ARRAYSIZE(sunshine), L"%s\\Sunshine", program_data))) {
+      return false;
+    }
+    CreateDirectoryW(sunshine, nullptr);
+
+    const std::wstring proof = GetProofDirectory();
+    if (proof.empty()) {
+      return false;
+    }
+    return CreateDirectoryW(proof.c_str(), nullptr) || GetLastError() == ERROR_ALREADY_EXISTS;
+  }
