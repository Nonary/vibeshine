+/**
+ * @brief Parse a Remote IDD desktop-mode policy argument.
+ *
+ * @param value Command-line policy value.
+ * @param policy Receives the parsed policy.
+ * @return True when the policy name is recognized.
+ */
+static bool ParseRemoteIddDesktopModePolicy(const wchar_t *value, RemoteIddDesktopModePolicy &policy) {
+  if (_wcsicmp(value, L"driver-only") == 0) {
+    policy = RemoteIddDesktopModePolicy::DriverOnly;
+    return true;
+  }
+  if (_wcsicmp(value, L"position-only") == 0) {
+    policy = RemoteIddDesktopModePolicy::PositionOnly;
+    return true;
+  }
+  if (_wcsicmp(value, L"legacy-gdi") == 0) {
+    policy = RemoteIddDesktopModePolicy::LegacyGdi;
+    return true;
+  }
+  return false;
+}
