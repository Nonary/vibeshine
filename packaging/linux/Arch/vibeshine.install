# shellcheck shell=bash

do_setcap() {
  systemd-sysusers /usr/lib/sysusers.d/vibeshine.conf
  setcap cap_sys_admin,cap_sys_nice+p "$(readlink -f usr/bin/vibeshine)"
  chown root:vibeshine usr/libexec/vibeshine/vibeshine-session-exec
  chmod 0750 usr/libexec/vibeshine/vibeshine-session-exec
  setcap cap_setgid,cap_setuid=ep usr/libexec/vibeshine/vibeshine-session-exec
}

do_udev_reload() {
  udevadm control --reload-rules
  udevadm trigger --property-match=DEVNAME=/dev/uinput
  udevadm trigger --property-match=DEVNAME=/dev/uhid
  modprobe uinput || true
  modprobe uhid || true
}

do_install_vibeshine_drm() {
  if /usr/libexec/vibeshine/vibeshine-drm-install install-package; then
    return 0
  else
    local install_rc=$?
  fi
  case $install_rc in
    4)
      echo "warning: Vibeshine DRM was updated, but the loaded module is stale; reboot before using managed virtual displays."
      ;;
    5)
      echo "Vibeshine DRM authorization is queued. Reboot and approve the pending MOK confirmations once."
      ;;
    *)
      echo "warning: Vibeshine DRM installation failed; managed virtual displays are unavailable."
      ;;
  esac
}

do_prepare_kwin() {
  local helper=/usr/libexec/vibeshine/vibeshine-kwin-capability
  [[ -x "$helper" ]] || return 0
  "$helper" prepare || echo 'warning: could not prepare capability-free KWin for the Vibeshine GPU bridge.'
}

do_install_prelogin() {
  local helper=/usr/libexec/vibeshine/vibeshine-machine-host
  [[ -x "$helper" ]] || return 0
  if "$helper" configure-auto; then
    if ! "$helper" install-pam; then
      echo 'warning: could not install the Plasma Login Manager handoff hook.'
      return 0
    fi
    systemctl daemon-reload
    systemctl disable --now vibeshine-prelogin.service 2>/dev/null || true
    systemctl enable vibeshine.service || echo 'warning: could not enable the Vibeshine machine host.'
  else
    echo 'warning: Vibeshine needs an explicit machine profile owner.'
    echo "         Run: sudo $helper configure USER"
  fi
}

post_install() {
  do_setcap
  do_udev_reload
  modprobe uhid
  do_prepare_kwin
  do_install_vibeshine_drm
  do_install_prelogin
}

post_upgrade() {
  do_setcap
  do_udev_reload
  modprobe uhid
  do_prepare_kwin
  do_install_vibeshine_drm
  do_install_prelogin
}

pre_remove() {
  systemctl disable --now vibeshine.service vibeshine-prelogin.service 2>/dev/null || true
  /usr/libexec/vibeshine/vibeshine-machine-host remove-pam 2>/dev/null || true
  systemctl stop vibeshine-vkms.service 2>/dev/null || true
  systemctl stop vibeshine-drm-setup.service 2>/dev/null || true
  /usr/libexec/vibeshine/vibeshine-kwin-capability restore 2>/dev/null || true
  /usr/libexec/vibeshine/vibeshine-drm-install remove || \
    echo "warning: could not remove the Vibeshine HDR DRM module cleanly."
}
