[Unit]
Description=Vibeshine session execution broker socket
Documentation=https://github.com/Nonary/vibeshine
BindsTo=vibeshine-session-controller.service
After=vibeshine-session-controller.service
PartOf=vibeshine-session-controller.service

[Socket]
ListenSequentialPacket=/run/vibeshine/session-broker.sock
SocketMode=0660
SocketUser=root
SocketGroup=vibeshine
DirectoryMode=0755
Accept=yes
RemoveOnStop=yes
Backlog=16
MaxConnections=32
MaxConnectionsPerSource=16
