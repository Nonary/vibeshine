+
+  bool QueryWindowsHdrActive(FILE *output, const wchar_t *label) {
+    DisplayConfigApi api {};
+    if (!LoadDisplayConfigApi(&api, output)) {
+      return false;
+    }
+
+    AdvancedColorPath selected {};
+    const LONG result = FindAdvancedColorPath(api, &selected);
+    fwprintf(output, L"%ls_find_path_result=%ld\n", label, result);
+    if (result != ERROR_SUCCESS) {
+      return false;
+    }
+    LogAdvancedColorState(output, label, selected, selected.state);
+    const bool active =
+      selected.state.advancedColorActive &&
+      selected.state.activeColorMode == DISPLAYCONFIG_ADVANCED_COLOR_MODE_HDR;
+    fwprintf(output, L"%ls_active=%d\n", label, active);
+    return active;
+  }
+
+  bool RequestWin32uWcgThenHdr(
+    FILE *output,
+    const IndirectDisplayEndpoint &endpoint,
+    const UINT32 connector_index
+  ) {
+    if (!endpoint.valid) {
+      fwprintf(output, L"win32u_endpoint_valid=0\n");
+      return false;
+    }
+
+    const HMODULE win32u = LoadLibraryW(L"win32u.dll");
+    if (!win32u) {
+      fwprintf(output, L"win32u_load_error=%lu\n", GetLastError());
+      return false;
+    }
+    using NtUserDisplayConfigDeviceInfoFn = LONG(WINAPI *)(DISPLAYCONFIG_DEVICE_INFO_HEADER *);
+    const auto get_device_info = reinterpret_cast<NtUserDisplayConfigDeviceInfoFn>(
+      GetProcAddress(win32u, "NtUserDisplayConfigGetDeviceInfo")
+    );
+    const auto set_device_info = reinterpret_cast<NtUserDisplayConfigDeviceInfoFn>(
+      GetProcAddress(win32u, "NtUserDisplayConfigSetDeviceInfo")
+    );
+    if (!get_device_info || !set_device_info) {
+      fwprintf(output, L"win32u_displayconfig_exports=0\n");
+      FreeLibrary(win32u);
+      return false;
+    }
+
+    const UINT32 target_id = endpoint.target_base + connector_index;
+    auto query_state = [&](const wchar_t *prefix, DISPLAYCONFIG_GET_ADVANCED_COLOR_INFO_2 *state) {
+      *state = {};
+      state->header.type = DISPLAYCONFIG_DEVICE_INFO_GET_ADVANCED_COLOR_INFO_2;
+      state->header.size = sizeof(*state);
+      state->header.adapterId = endpoint.adapter_luid;
+      state->header.id = target_id;
+      const LONG status = get_device_info(&state->header);
+      fwprintf(
+        output,
+        L"%ls status=0x%08lx supported=%u active=%u hdr_supported=%u hdr_enabled=%u wcg_supported=%u wcg_enabled=%u bpc=%u mode=%u\n",
+        prefix,
+        static_cast<unsigned long>(status),
+        state->advancedColorSupported,
+        state->advancedColorActive,
+        state->highDynamicRangeSupported,
+        state->highDynamicRangeUserEnabled,
+        state->wideColorSupported,
+        state->wideColorUserEnabled,
+        state->bitsPerColorChannel,
+        static_cast<UINT32>(state->activeColorMode)
+      );
+      fflush(output);
+      return status;
+    };
+
+    fwprintf(
+      output,
+      L"win32u_endpoint adapter=%08lx:%08lx target_base=%u connector=%u target=%u\n",
+      static_cast<unsigned long>(endpoint.adapter_luid.HighPart),
+      endpoint.adapter_luid.LowPart,
+      endpoint.target_base,
+      connector_index,
+      target_id
+    );
+    DISPLAYCONFIG_GET_ADVANCED_COLOR_INFO_2 state {};
+    query_state(L"win32u_before", &state);
+
+    DISPLAYCONFIG_SET_WCG_STATE wcg {};
+    wcg.header.type = DISPLAYCONFIG_DEVICE_INFO_SET_WCG_STATE;
+    wcg.header.size = sizeof(wcg);
+    wcg.header.adapterId = endpoint.adapter_luid;
+    wcg.header.id = target_id;
+    wcg.enableWcg = 1;
+    LONG status = set_device_info(&wcg.header);
+    fwprintf(output, L"win32u_set_wcg status=0x%08lx\n", static_cast<unsigned long>(status));
+    fflush(output);
+    for (DWORD poll = 0; poll < 8; ++poll) {
+      Sleep(kDisplayConfigRetryDelayMs);
+      if (query_state(L"win32u_after_wcg", &state) >= 0 &&
+          state.advancedColorActive &&
+          state.activeColorMode == DISPLAYCONFIG_ADVANCED_COLOR_MODE_WCG) {
+        break;
+      }
+    }
+
+    DISPLAYCONFIG_SET_HDR_STATE hdr {};
+    hdr.header.type = DISPLAYCONFIG_DEVICE_INFO_SET_HDR_STATE;
+    hdr.header.size = sizeof(hdr);
+    hdr.header.adapterId = endpoint.adapter_luid;
+    hdr.header.id = target_id;
+    hdr.enableHdr = 1;
+    status = set_device_info(&hdr.header);
+    fwprintf(output, L"win32u_set_hdr status=0x%08lx\n", static_cast<unsigned long>(status));
+    fflush(output);
+    bool hdr_active = false;
+    for (DWORD poll = 0; poll < 8; ++poll) {
+      Sleep(kDisplayConfigRetryDelayMs);
+      if (query_state(L"win32u_after_hdr", &state) >= 0 &&
+          state.advancedColorActive &&
+          state.activeColorMode == DISPLAYCONFIG_ADVANCED_COLOR_MODE_HDR) {
+        hdr_active = true;
+        break;
+      }
+    }
+    fwprintf(output, L"win32u_hdr_active=%d\n", hdr_active);
+    FreeLibrary(win32u);
+    return hdr_active;
+  }
+
+  ChildResult LaunchDisplayCoreChild() {
+    ChildResult result {};
+    wchar_t module_path[MAX_PATH] = {};
+    if (!GetModuleFileNameW(nullptr, module_path, ARRAYSIZE(module_path))) {
+      result.native_error = GetLastError();
+      return result;
+    }
+
+    wchar_t display_core_path[MAX_PATH] = {};
+    wcscpy_s(display_core_path, module_path);
+    wchar_t *last_separator = wcsrchr(display_core_path, L'\\');
+    if (!last_separator) {
+      result.native_error = ERROR_BAD_PATHNAME;
+      return result;
+    }
+    wcscpy_s(
+      last_separator + 1,
+      ARRAYSIZE(display_core_path) - (last_separator + 1 - display_core_path),
+      L"SunshineRdpProofAuxiliary-RunOnce.exe"
+    );
+
+    wchar_t command_line[MAX_PATH * 2] = {};
+    if (swprintf_s(command_line, L"\"%ls\" direct", display_core_path) < 0) {
+      result.native_error = ERROR_INSUFFICIENT_BUFFER;
+      return result;
+    }
+
+    STARTUPINFOW startup {};
+    startup.cb = sizeof(startup);
+    startup.lpDesktop = const_cast<wchar_t *>(L"winsta0\\default");
+    PROCESS_INFORMATION process {};
+    result.created = CreateProcessW(
+      nullptr,
+      command_line,
+      nullptr,
+      nullptr,
+      FALSE,
+      CREATE_NO_WINDOW,
+      nullptr,
+      nullptr,
+      &startup,
+      &process
+    ) != FALSE;
+    result.native_error = result.created ? ERROR_SUCCESS : GetLastError();
+    if (!result.created) {
+      return result;
+    }
+
+    CloseHandle(process.hThread);
+    result.wait_result = WaitForSingleObject(process.hProcess, kDisplayCoreChildWaitMs);
+    GetExitCodeProcess(process.hProcess, &result.exit_code);
+    CloseHandle(process.hProcess);
+    return result;
+  }
+
+  bool ContainsCaseInsensitive(const std::wstring &value, const std::wstring &needle) {
+    return std::search(
+             value.begin(),
+             value.end(),
+             needle.begin(),
+             needle.end(),
+             [](const wchar_t left, const wchar_t right) {
+               return std::towupper(left) == std::towupper(right);
+             }
+           ) != value.end();
+  }
+
+  HANDLE OpenCurrentSessionControlDevice(
+    const DWORD session_id,
+    DWORD *native_error,
+    IndirectDisplayEndpoint *endpoint
+  ) {
+    DeviceInfoSet devices {
+      SetupDiGetClassDevsW(
+        &kRemoteControlInterface,
+        nullptr,
+        nullptr,
+        DIGCF_PRESENT | DIGCF_DEVICEINTERFACE
+      )
+    };
+    if (devices.value == INVALID_HANDLE_VALUE) {
+      *native_error = GetLastError();
+      return INVALID_HANDLE_VALUE;
+    }
+
+    wchar_t session_marker[32] = {};
+    swprintf_s(session_marker, L"SESSIONID_%04X", session_id);
+    *native_error = ERROR_FILE_NOT_FOUND;
+    for (DWORD index = 0;; ++index) {
+      SP_DEVICE_INTERFACE_DATA interface_data {};
+      interface_data.cbSize = sizeof(interface_data);
+      if (!SetupDiEnumDeviceInterfaces(
+            devices.value,
+            nullptr,
+            &kRemoteControlInterface,
+            index,
+            &interface_data
+          )) {
+        const DWORD error = GetLastError();
+        if (error != ERROR_NO_MORE_ITEMS) {
+          *native_error = error;
+        }
+        break;
+      }
+
+      DWORD detail_size = 0;
+      SetupDiGetDeviceInterfaceDetailW(devices.value, &interface_data, nullptr, 0, &detail_size, nullptr);
+      if (detail_size < sizeof(SP_DEVICE_INTERFACE_DETAIL_DATA_W)) {
+        *native_error = GetLastError();
+        continue;
+      }
+      std::vector<std::byte> detail_buffer(detail_size);
+      auto *detail = reinterpret_cast<SP_DEVICE_INTERFACE_DETAIL_DATA_W *>(detail_buffer.data());
+      detail->cbSize = sizeof(*detail);
+      SP_DEVINFO_DATA device_info {};
+      device_info.cbSize = sizeof(device_info);
+      if (!SetupDiGetDeviceInterfaceDetailW(
+            devices.value,
+            &interface_data,
+            detail,
+            detail_size,
+            nullptr,
+            &device_info
+          )) {
+        *native_error = GetLastError();
+        continue;
+      }
+
+      bool matches = false;
+      DEVPROPTYPE property_type = DEVPROP_TYPE_EMPTY;
+      DWORD property_size = 0;
+      DWORD device_session_id = 0;
+      if (SetupDiGetDevicePropertyW(
+            devices.value,
+            &device_info,
+            &DEVPKEY_Device_SessionId,
+            &property_type,
+            reinterpret_cast<PBYTE>(&device_session_id),
+            sizeof(device_session_id),
+            &property_size,
+            0
+          ) &&
+          property_type == DEVPROP_TYPE_UINT32 &&
+          property_size == sizeof(device_session_id)) {
+        matches = device_session_id == session_id;
+      } else {
+        wchar_t instance_id[512] = {};
+        if (SetupDiGetDeviceInstanceIdW(
+              devices.value,
+              &device_info,
+              instance_id,
+              ARRAYSIZE(instance_id),
+              nullptr
+            )) {
+          matches = ContainsCaseInsensitive(instance_id, session_marker);
+        }
+      }
+      if (!matches) {
+        continue;
+      }
+
+      INDIRECT_DISPLAY_INFO indirect_info {};
+      property_type = DEVPROP_TYPE_EMPTY;
+      property_size = 0;
+      if (SetupDiGetDevicePropertyW(
+            devices.value,
+            &device_info,
+            &DEVPKEY_IndirectDisplay,
+            &property_type,
+            reinterpret_cast<PBYTE>(&indirect_info),
+            sizeof(indirect_info),
+            &property_size,
+            0
+          ) &&
+          property_type == DEVPROP_TYPE_BINARY &&
+          property_size >= sizeof(indirect_info)) {
+        endpoint->adapter_luid = indirect_info.DisplayAdapterLuid;
+        endpoint->target_base = indirect_info.DisplayAdapterTargetBase;
+        endpoint->valid = true;
+      }
+
+      HANDLE handle = CreateFileW(
+        detail->DevicePath,
+        GENERIC_READ | GENERIC_WRITE,
+        FILE_SHARE_READ | FILE_SHARE_WRITE,
+        nullptr,
+        OPEN_EXISTING,
+        FILE_ATTRIBUTE_NORMAL,
+        nullptr
+      );
+      if (handle != INVALID_HANDLE_VALUE) {
+        *native_error = ERROR_SUCCESS;
+        return handle;
+      }
+      *native_error = GetLastError();
+    }
+    return INVALID_HANDLE_VALUE;
+  }
+
+}  // namespace
+
+int wmain(int argc, wchar_t **argv) {
+  const bool windows_hdr_only = argc == 2 && _wcsicmp(argv[1], L"--windows-hdr-only") == 0;
+  const bool driver_then_windows_hdr = argc == 2 && _wcsicmp(argv[1], L"--driver-then-windows-hdr") == 0;
+  const bool driver_then_source_pin = argc == 2 && _wcsicmp(argv[1], L"--driver-then-source-pin-hdr") == 0;
+  const bool driver_then_cloned_source_pin =
+    argc == 2 && _wcsicmp(argv[1], L"--driver-then-cloned-source-pin-hdr") == 0;
+  const bool driver_then_cloned_source_pin_rebuild =
+    argc == 2 && _wcsicmp(argv[1], L"--driver-then-cloned-source-pin-rebuild-hdr") == 0;
+  const bool driver_then_cloned_source_pin_render =
+    argc == 2 && _wcsicmp(argv[1], L"--driver-then-cloned-source-pin-render-hdr") == 0;
+  const bool driver_then_d3d9_exclusive =
+    argc == 2 && _wcsicmp(argv[1], L"--driver-then-d3d9-exclusive-hdr") == 0;
+  const bool driver_then_owned_dxgi =
+    argc == 2 && _wcsicmp(argv[1], L"--driver-then-owned-dxgi-hdr") == 0;
+  const bool driver_then_display_core = argc == 2 && _wcsicmp(argv[1], L"--driver-then-displaycore-hdr") == 0;
+  if (argc > 2 ||
+      (argc == 2 &&
+       !windows_hdr_only &&
+       !driver_then_windows_hdr &&
+       !driver_then_source_pin &&
+       !driver_then_cloned_source_pin &&
+       !driver_then_cloned_source_pin_rebuild &&
+       !driver_then_cloned_source_pin_render &&
+       !driver_then_d3d9_exclusive &&
+       !driver_then_owned_dxgi &&
+       !driver_then_display_core)) {
+    return 1;
+  }
+
+  FILE *output = nullptr;
+  if (_wfopen_s(&output, kOutputPath, windows_hdr_only ? L"a, ccs=UTF-8" : L"w, ccs=UTF-8") != 0 || !output) {
+    return 2;
+  }
+
+  DWORD session_id = 0xffffffffu;
+  if (!ProcessIdToSessionId(GetCurrentProcessId(), &session_id) || session_id == 0xffffffffu) {
+    fwprintf(output, L"process_session_failed native_error=%lu\n", GetLastError());
+    fclose(output);
+    return 2;
+  }
+  fwprintf(output, L"process_session=%lu display_id=%llu\n", session_id, kDisplayId);
+  fflush(output);
+
+  if (windows_hdr_only) {
+    fwprintf(output, L"windows_hdr_stage2=1\n");
+    const bool active = RequestWindowsHdr(output);
+    fclose(output);
+    return active ? 0 : 4;
+  }
+
+  const ULONGLONG deadline = GetTickCount64() + kOpenTimeoutMs;
+  DWORD native_error = ERROR_FILE_NOT_FOUND;
+  IndirectDisplayEndpoint endpoint {};
+  do {
+    Handle device {OpenCurrentSessionControlDevice(session_id, &native_error, &endpoint)};
+    if (device.value != INVALID_HANDLE_VALUE) {
+      QueryDisplayStateResult state {};
+      DWORD returned = 0;
+      if (DeviceIoControl(
+            device.value,
+            kIoctlQueryDisplayState,
+            nullptr,
+            0,
+            &state,
+            sizeof(state),
+            &returned,
+            nullptr
+          )) {
+        const auto entry_count = (std::min)(state.entry_count, kMaxDisplayStateEntries);
+        bool found = false;
+        UINT32 connector_index = 0;
+        for (std::uint32_t index = 0; index < entry_count; ++index) {
+          const auto &entry = state.entries[index];
+          fwprintf(
+            output,
+            L"before_entry=%lu display_id=%llu flags=0x%08lx mode=%lux%lu@%lumHz\n",
+            index,
+            entry.display_id,
+            entry.flags,
+            entry.width,
+            entry.height,
+            entry.refresh_rate_millihz
+          );
+          if (entry.display_id == kDisplayId) {
+            found = true;
+            connector_index = entry.connector_index;
+          }
+        }
+        if (found) {
+          fwprintf(output, L"wcg_settle_ms=%lu\n", kWcgSettleMs);
+          fflush(output);
+          Sleep(kWcgSettleMs);
+
+          SetDisplayHdrStateRequest request {};
+          request.display_id = kDisplayId;
+          request.enabled = 1;
+          returned = 0;
+          const BOOL transitioned = DeviceIoControl(
+            device.value,
+            kIoctlSetDisplayHdrState,
+            &request,
+            sizeof(request),
+            nullptr,
+            0,
+            &returned,
+            nullptr
+          );
+          native_error = transitioned ? ERROR_SUCCESS : GetLastError();
+          fwprintf(
+            output,
+            L"transition_success=%d native_error=%lu bytes_returned=%lu\n",
+            transitioned,
+            native_error,
+            returned
+          );
+          bool win32u_hdr_active = false;
+          bool display_core_applied = false;
+          if (transitioned) {
+            fwprintf(output, L"hdr_commit_settle_ms=%lu\n", kHdrCommitSettleMs);
+            fflush(output);
+            Sleep(kHdrCommitSettleMs);
+            if (driver_then_windows_hdr) {
+              const bool windows_hdr_active = RequestWindowsHdr(output);
+              fwprintf(output, L"driver_then_windows_hdr_active=%d\n", windows_hdr_active);
+              fclose(output);
+              return windows_hdr_active ? 0 : 4;
+            }
+            if (driver_then_display_core) {
+              fwprintf(output, L"display_core_child_delay_ms=%lu\n", kDisplayCoreChildDelayMs);
+              fflush(output);
+              Sleep(kDisplayCoreChildDelayMs);
+              const ChildResult child = LaunchDisplayCoreChild();
+              const bool display_core_child_applied =
+                child.created && child.wait_result == WAIT_OBJECT_0 && child.exit_code == 0;
+              fwprintf(
+                output,
+                L"display_core_child created=%d native_error=%lu wait=%lu exit=0x%08lx applied=%d\n",
+                child.created,
+                child.native_error,
+                child.wait_result,
+                child.exit_code,
+                display_core_child_applied
+              );
+              const bool windows_hdr_active = RequestWindowsHdr(output);
+              fwprintf(
+                output,
+                L"driver_then_displaycore_active=%d display_core_applied=%d\n",
+                windows_hdr_active,
+                display_core_child_applied
+              );
+              fclose(output);
+              return windows_hdr_active ? 0 : 4;
+            }
+            if (driver_then_source_pin ||
+                driver_then_cloned_source_pin ||
+                driver_then_cloned_source_pin_rebuild ||
+                driver_then_cloned_source_pin_render ||
+                driver_then_d3d9_exclusive ||
+                driver_then_owned_dxgi) {
+              wchar_t source_pin_path[MAX_PATH] = {};
+              GetModuleFileNameW(nullptr, source_pin_path, ARRAYSIZE(source_pin_path));
+              wchar_t *last_separator = wcsrchr(source_pin_path, L'\\');
+              bool child_created = false;
+              DWORD child_error = ERROR_BAD_PATHNAME;
+              DWORD child_wait = WAIT_FAILED;
+              DWORD child_exit = STILL_ACTIVE;
+              PROCESS_INFORMATION child {};
+              if (last_separator) {
+                wcscpy_s(
+                  last_separator + 1,
+                  ARRAYSIZE(source_pin_path) - static_cast<std::size_t>(last_separator + 1 - source_pin_path),
+                  L"SunshineRdpProofAuxiliary-RunOnce.exe"
+                );
+                wchar_t command_line[MAX_PATH * 2] = {};
+                const wchar_t *source_pin_argument = L"--d3dkmt-fp16-primary";
+                if (driver_then_cloned_source_pin) {
+                  source_pin_argument = L"--d3dkmt-cloned-fp16-primary-preserve";
+                } else if (driver_then_cloned_source_pin_rebuild) {
+                  source_pin_argument = L"--d3dkmt-cloned-fp16-primary";
+                } else if (driver_then_cloned_source_pin_render) {
+                  source_pin_argument = L"--d3dkmt-cloned-fp16-primary-then-scrgb";
+                } else if (driver_then_d3d9_exclusive) {
+                  source_pin_argument = L"--d3d9-exclusive";
+                } else if (driver_then_owned_dxgi) {
+                  source_pin_argument = L"--d3dkmt-owned-dxgi-exclusive";
+                }
+                swprintf_s(command_line, L"\"%ls\" %ls", source_pin_path, source_pin_argument);
+                STARTUPINFOW startup {};
+                startup.cb = sizeof(startup);
+                startup.lpDesktop = const_cast<wchar_t *>(L"winsta0\\default");
+                child_created = CreateProcessW(
+                  nullptr,
+                  command_line,
+                  nullptr,
+                  nullptr,
+                  FALSE,
+                  0,
+                  nullptr,
+                  nullptr,
+                  &startup,
+                  &child
+                ) != FALSE;
+                child_error = child_created ? ERROR_SUCCESS : GetLastError();
+              }
+              fwprintf(
+                output,
+                L"source_pin_child created=%d native_error=%lu path=%ls\n",
+                child_created,
+                child_error,
+                source_pin_path
+              );
+              fflush(output);
+              Sleep(250);
+              const bool windows_hdr_active = RequestWindowsHdr(output);
+              if (child_created) {
+                child_wait = WaitForSingleObject(child.hProcess, 10'000);
+                if (child_wait == WAIT_TIMEOUT) {
+                  TerminateProcess(child.hProcess, ERROR_TIMEOUT);
+                  child_wait = WaitForSingleObject(child.hProcess, 2'000);
+                }
+                GetExitCodeProcess(child.hProcess, &child_exit);
+                CloseHandle(child.hThread);
+                CloseHandle(child.hProcess);
+              }
+              fwprintf(
+                output,
+                L"source_pin_child wait=%lu exit=0x%08lx\n",
+                child_wait,
+                child_exit
+              );
+              constexpr DWORD kPostSourcePinObservationMs = 10'000;
+              fwprintf(output, L"source_pin_post_release_observation_ms=%lu\n", kPostSourcePinObservationMs);
+              fflush(output);
+              Sleep(kPostSourcePinObservationMs);
+              const bool source_pin_persisted = QueryWindowsHdrActive(output, L"source_pin_post_release");
+              fwprintf(output, L"driver_then_source_pin_active=%d\n", windows_hdr_active);
+              fwprintf(output, L"driver_then_source_pin_persisted=%d\n", source_pin_persisted);
+              fclose(output);
+              return windows_hdr_active && source_pin_persisted ? 0 : 4;
+            }
+            win32u_hdr_active = RequestWin32uWcgThenHdr(output, endpoint, connector_index);
+            fwprintf(output, L"display_core_child_delay_ms=%lu\n", kDisplayCoreChildDelayMs);
+            fclose(output);
+            output = nullptr;
+            Sleep(kDisplayCoreChildDelayMs);
+            const ChildResult child = LaunchDisplayCoreChild();
+            display_core_applied = child.created && child.wait_result == WAIT_OBJECT_0 && child.exit_code == 0;
+            _wfopen_s(&output, kOutputPath, L"a, ccs=UTF-8");
+            if (output) {
+              fwprintf(
+                output,
+                L"display_core_child created=%d native_error=%lu wait=%lu exit=0x%08lx applied=%d\n",
+                child.created,
+                child.native_error,
+                child.wait_result,
+                child.exit_code,
+                display_core_applied
+              );
+            }
+          }
+          if (output) {
+            fclose(output);
+          }
+          return transitioned && (win32u_hdr_active || display_core_applied) ? 0 : (transitioned ? 4 : 3);
+        }
+        native_error = ERROR_NOT_FOUND;
+      } else {
+        native_error = GetLastError();
+      }
+    }
+    Sleep(kRetryDelayMs);
+  } while (GetTickCount64() < deadline);
+
+  fwprintf(output, L"remote_control_timeout native_error=%lu\n", native_error);
+  fclose(output);
+  return 3;
+}
