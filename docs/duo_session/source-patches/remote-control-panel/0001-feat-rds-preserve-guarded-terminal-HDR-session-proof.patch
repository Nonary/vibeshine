+  /**
+   * @brief Test whether a registry key exists.
+   *
+   * @param root Registry root.
+   * @param path Subkey path.
+   * @return True when present.
+   */
+  bool
+    RegistryKeyExists(HKEY root, const wchar_t *path) {
+    HKEY key = nullptr;
+    const LSTATUS status = RegOpenKeyExW(root, path, 0, KEY_READ, &key);
+    if (status == ERROR_SUCCESS) {
+      RegCloseKey(key);
+      return true;
+    }
+    return false;
