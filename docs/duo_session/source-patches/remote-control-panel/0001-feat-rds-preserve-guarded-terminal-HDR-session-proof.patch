+
+function Assert-Administrator {
+  $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
+  $principal = [Security.Principal.WindowsPrincipal]::new($identity)
+  if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
+    throw "The TermService compatibility guard requires an elevated administrator process."
+  }
+}
+
+function Get-ServiceDllState {
+  $key = [Microsoft.Win32.Registry]::LocalMachine.OpenSubKey($ServiceParameters, $false)
+  if (-not $key) {
+    throw "TermService Parameters registry key is missing."
+  }
+  try {
+    $value = $key.GetValue("ServiceDll", $null, [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames)
+    $kind = $key.GetValueKind("ServiceDll")
+    return [pscustomobject]@{
+      Value = [string]$value
+      Kind = [string]$kind
+    }
+  } finally {
+    $key.Dispose()
+  }
+}
+
+function Set-ServiceDllExpandString([string]$Value) {
+  $key = [Microsoft.Win32.Registry]::LocalMachine.OpenSubKey($ServiceParameters, $true)
+  if (-not $key) {
+    throw "TermService Parameters registry key cannot be opened for rollback."
+  }
+  try {
+    $key.SetValue("ServiceDll", $Value, [Microsoft.Win32.RegistryValueKind]::ExpandString)
+    $key.Flush()
+  } finally {
+    $key.Dispose()
+  }
+  $actual = Get-ServiceDllState
+  if ($actual.Kind -ne "ExpandString" -or $actual.Value -ne $Value) {
+    throw "ServiceDll verification failed after setting '$Value'."
+  }
+}
+
+function Get-TermServiceProcess {
+  $service = Get-CimInstance Win32_Service -Filter "Name='TermService'"
+  if (-not $service -or $service.State -ne "Running" -or -not $service.ProcessId) {
+    throw "TermService is not running."
+  }
+  return Get-Process -Id $service.ProcessId -ErrorAction Stop
+}
+
+function Get-TermServiceModulePaths {
+  $process = Get-TermServiceProcess
+  return @($process.Modules | ForEach-Object FileName)
+}
+
+function Assert-ExactArtifacts {
+  $items = @(
+    @{ Path = (Join-Path $env:WINDIR "System32\termsrv.dll"); Hash = $ExpectedTermSrvHash; Name = "termsrv.dll" },
+    @{ Path = $WrapperPath; Hash = $ExpectedWrapperHash; Name = "TermWrap.dll" },
+    @{ Path = $ZydisPath; Hash = $ExpectedZydisHash; Name = "Zydis.dll" }
+  )
+  foreach ($item in $items) {
+    if (-not (Test-Path -LiteralPath $item.Path -PathType Leaf)) {
+      throw "Required compatibility artifact is missing: $($item.Path)"
+    }
+    $actual = (Get-FileHash -LiteralPath $item.Path -Algorithm SHA256).Hash
+    if ($actual -ne $item.Hash) {
+      throw "$($item.Name) changed after offline preflight: expected $($item.Hash), got $actual"
+    }
+  }
+  $signature = Get-AuthenticodeSignature -LiteralPath (Join-Path $env:WINDIR "System32\termsrv.dll")
+  if ($signature.Status -ne [System.Management.Automation.SignatureStatus]::Valid) {
+    throw "The inbox termsrv.dll signature is not valid: $($signature.Status)"
+  }
+}
+
+function Assert-SafeBaseline {
+  $dll = Get-ServiceDllState
+  if ($dll.Kind -ne "ExpandString" -or $dll.Value -ne $SafeServiceDll) {
+    throw "Safe ServiceDll baseline is absent: kind=$($dll.Kind) value=$($dll.Value)"
+  }
+  $modules = Get-TermServiceModulePaths
+  if ($modules -contains $WrapperPath) {
+    throw "TermWrap.dll is still loaded in TermService."
+  }
+  if ($modules -notcontains (Join-Path $env:WINDIR "System32\termsrv.dll")) {
+    throw "The running TermService does not contain the inbox termsrv.dll."
+  }
+  $redirector = Get-Service -Name UmRdpService
+  if ($redirector.Status -ne [System.ServiceProcess.ServiceControllerStatus]::Running) {
+    throw "UmRdpService is not running."
+  }
+  if (Test-Path -LiteralPath $ControllerPath -PathType Leaf) {
+    & $ControllerPath --assert-safe
+    if ($LASTEXITCODE -ne 0) {
+      throw "The HDR proof controller did not confirm its safe baseline."
+    }
+  }
+}
+
+function Restart-TerminalStack {
+  $redirector = Get-Service -Name UmRdpService
+  if ($redirector.Status -ne [System.ServiceProcess.ServiceControllerStatus]::Stopped) {
+    Stop-Service -Name UmRdpService -Force
+    $redirector.WaitForStatus(
+      [System.ServiceProcess.ServiceControllerStatus]::Stopped,
+      [timespan]::FromSeconds(20)
+    )
+  }
+  try {
+    Restart-Service -Name TermService -Force
+    $terminal = Get-Service -Name TermService
+    $terminal.WaitForStatus(
+      [System.ServiceProcess.ServiceControllerStatus]::Running,
+      [timespan]::FromSeconds(30)
+    )
+  } finally {
+    $redirector = Get-Service -Name UmRdpService
+    if ($redirector.Status -ne [System.ServiceProcess.ServiceControllerStatus]::Running) {
+      Start-Service -Name UmRdpService
+      $redirector.WaitForStatus(
+        [System.ServiceProcess.ServiceControllerStatus]::Running,
+        [timespan]::FromSeconds(20)
+      )
+    }
+  }
+}
+
+function Remove-DeadlineTask {
+  if (Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue) {
+    Unregister-ScheduledTask -TaskName $TaskName -Confirm:$false
+  }
+}
+
+function Invoke-Rollback {
+  Write-GuardLog "rollback begin"
+  $proofError = $null
+  if (Test-Path -LiteralPath $ControllerPath -PathType Leaf) {
+    try {
+      & $ControllerPath --rollback
+      if ($LASTEXITCODE -ne 0) {
+        throw "proof rollback exit $LASTEXITCODE"
+      }
+    } catch {
+      $proofError = $_
+      Write-GuardLog "proof rollback reported: $($_.Exception.Message); continuing with TermService recovery"
+    }
+  }
+
+  # Write the recovered ServiceDll value before touching either service. Even if
+  # the live restart fails, the next ordinary service start or boot uses inbox
+  # termsrv.dll rather than the wrapper.
+  Set-ServiceDllExpandString $SafeServiceDll
+  Restart-TerminalStack
+  Assert-SafeBaseline
+  Remove-DeadlineTask
+  if ($proofError) {
+    throw "TermService recovered, but proof cleanup reported: $($proofError.Exception.Message)"
+  }
+  Write-GuardLog "rollback complete; inbox termsrv.dll is configured and loaded"
+}
+
+Assert-Administrator
+
+switch ($Mode) {
+  "Arm" {
+    Assert-ExactArtifacts
+    Assert-SafeBaseline
+
+    New-Item -ItemType Directory -Path $ProofRoot -Force | Out-Null
+    Copy-Item -LiteralPath $PSCommandPath -Destination $StagedScript -Force
+    & icacls.exe $ProofRoot /inheritance:r /grant:r `
+      "*S-1-5-18:(OI)(CI)F" `
+      "*S-1-5-32-544:(OI)(CI)F" `
+      "*S-1-5-20:(OI)(CI)RX" | Out-Null
+    if ($LASTEXITCODE -ne 0) {
+      throw "Failed to protect the compatibility guard directory."
+    }
+
+    $original = Get-ServiceDllState
+    [pscustomobject]@{
+      ArmedAt = (Get-Date).ToString("o")
+      OriginalServiceDll = $original.Value
+      OriginalServiceDllKind = $original.Kind
+      TermSrvSha256 = $ExpectedTermSrvHash
+      TermWrapSha256 = $ExpectedWrapperHash
+      ZydisSha256 = $ExpectedZydisHash
+      StagedScriptSha256 = (Get-FileHash -LiteralPath $StagedScript -Algorithm SHA256).Hash
+    } | ConvertTo-Json | Set-Content -LiteralPath $StatePath -Encoding UTF8
+
+    Remove-DeadlineTask
+    $action = New-ScheduledTaskAction -Execute "powershell.exe" -Argument (
+      '-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "{0}" -Mode Rollback' -f $StagedScript
+    )
+    $trigger = New-ScheduledTaskTrigger -Once -At (Get-Date).AddSeconds($DelaySeconds)
+    $principal = New-ScheduledTaskPrincipal -UserId "SYSTEM" -LogonType ServiceAccount -RunLevel Highest
+    $settings = New-ScheduledTaskSettingsSet `
+      -StartWhenAvailable `
+      -ExecutionTimeLimit (New-TimeSpan -Minutes 3) `
+      -MultipleInstances IgnoreNew
+    Register-ScheduledTask -TaskName $TaskName -Action $action -Trigger $trigger -Principal $principal -Settings $settings -Force | Out-Null
+    $task = Get-ScheduledTask -TaskName $TaskName
+    $info = Get-ScheduledTaskInfo -TaskName $TaskName
+    if ($task.Principal.UserId -ne "SYSTEM" -or $task.Principal.RunLevel -ne "Highest") {
+      throw "Compatibility rollback task does not run as SYSTEM/highest."
+    }
+    Write-GuardLog "armed SYSTEM rollback for $($info.NextRunTime.ToString('o')); ServiceDll is still inbox"
+  }
+
+  "Enable" {
+    Assert-ExactArtifacts
+    Assert-SafeBaseline
+    $task = Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue
+    $info = if ($task) { Get-ScheduledTaskInfo -TaskName $TaskName } else { $null }
+    if (-not $task -or $task.Principal.UserId -ne "SYSTEM" -or $info.NextRunTime -le (Get-Date).AddSeconds(90)) {
+      throw "At least ninety seconds must remain on the SYSTEM compatibility rollback deadline."
+    }
+    if (-not (Test-Path -LiteralPath $StatePath -PathType Leaf)) {
+      throw "Compatibility rollback state is missing."
+    }
+    $state = Get-Content -LiteralPath $StatePath -Raw | ConvertFrom-Json
+    if ($state.OriginalServiceDllKind -ne "ExpandString" -or $state.OriginalServiceDll -ne $SafeServiceDll -or
+        $state.StagedScriptSha256 -ne (Get-FileHash -LiteralPath $StagedScript -Algorithm SHA256).Hash) {
+      throw "Compatibility rollback state does not match the recovered baseline or staged guard."
+    }
+
+    Write-GuardLog "enable begin; configuring preflighted TermWrap wrapper"
+    try {
+      Set-ServiceDllExpandString $WrapperPath
+      Restart-TerminalStack
+      $modules = Get-TermServiceModulePaths
+      if ($modules -notcontains $WrapperPath -or
+          $modules -notcontains (Join-Path $env:WINDIR "System32\termsrv.dll")) {
+        throw "TermService did not load both TermWrap.dll and inbox termsrv.dll."
+      }
+      Write-GuardLog "enable complete; wrapper and inbox termsrv.dll are loaded; rollback remains armed"
+    } catch {
+      $enableError = $_
+      Write-GuardLog "enable failed: $($_.Exception.Message); applying immediate inbox rollback"
+      try {
+        Invoke-Rollback
+      } catch {
+        Write-GuardLog "immediate rollback also reported: $($_.Exception.Message)"
+      }
+      throw $enableError
+    }
+  }
+
+  "Rollback" {
+    Invoke-Rollback
+  }
+
+  "Cancel" {
+    Assert-SafeBaseline
+    Remove-DeadlineTask
+    Write-GuardLog "cancelled while safe baseline was verified"
+  }
+
+  "Status" {
+    $dll = Get-ServiceDllState
+    $service = Get-CimInstance Win32_Service -Filter "Name='TermService'"
+    $modules = if ($service.State -eq "Running") { Get-TermServiceModulePaths } else { @() }
+    $task = Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue
+    $info = if ($task) { Get-ScheduledTaskInfo -TaskName $TaskName } else { $null }
+    [pscustomobject]@{
+      ServiceDllKind = $dll.Kind
+      ServiceDll = $dll.Value
+      TermServiceState = $service.State
+      TermServicePid = $service.ProcessId
+      InboxTermSrvLoaded = $modules -contains (Join-Path $env:WINDIR "System32\termsrv.dll")
+      TermWrapLoaded = $modules -contains $WrapperPath
+      UmRdpServiceState = (Get-Service -Name UmRdpService).Status
+      RollbackTaskPresent = $null -ne $task
+      RollbackNextRunTime = if ($info) { $info.NextRunTime } else { $null }
+    } | Format-List
+  }
+}
diff --git a/source/tools/rdp-protocol-provider/wcg_bootstrap.cpp b/source/tools/rdp-protocol-provider/wcg_bootstrap.cpp
new file mode 100644
index 00000000..bcbaae2a
--- /dev/null
+++ b/source/tools/rdp-protocol-provider/wcg_bootstrap.cpp
@@ -0,0 +1,679 @@
+#include <cstdarg>
+#include <cstdio>
+#include <strsafe.h>
+#include <vector>
+#include <windows.h>
+#include <wtsapi32.h>
+
+namespace {
+
+  constexpr DWORD kTopologyRetryCount = 30;
+  constexpr DWORD kTopologyRetryDelayMs = 500;
+  constexpr DWORD kStatePollCount = 20;
+  constexpr DWORD kStatePollDelayMs = 250;
+
+  using GetDisplayConfigBufferSizesFn = LONG(WINAPI *)(UINT32, UINT32 *, UINT32 *);
+  using QueryDisplayConfigFn = LONG(WINAPI *)(
+    UINT32,
+    UINT32 *,
+    DISPLAYCONFIG_PATH_INFO *,
+    UINT32 *,
+    DISPLAYCONFIG_MODE_INFO *,
+    DISPLAYCONFIG_TOPOLOGY_ID *
+  );
+  using DisplayConfigGetDeviceInfoFn = LONG(WINAPI *)(DISPLAYCONFIG_DEVICE_INFO_HEADER *);
+  using DisplayConfigSetDeviceInfoFn = LONG(WINAPI *)(DISPLAYCONFIG_DEVICE_INFO_HEADER *);
+  using SetDisplayConfigFn = LONG(WINAPI *)(
+    UINT32,
+    DISPLAYCONFIG_PATH_INFO *,
+    UINT32,
+    DISPLAYCONFIG_MODE_INFO *,
+    UINT32
+  );
+
+  GetDisplayConfigBufferSizesFn g_get_display_config_buffer_sizes = nullptr;
+  QueryDisplayConfigFn g_query_display_config = nullptr;
+  DisplayConfigGetDeviceInfoFn g_display_config_get_device_info = nullptr;
+  DisplayConfigSetDeviceInfoFn g_display_config_set_device_info = nullptr;
+  SetDisplayConfigFn g_set_display_config = nullptr;
+  DWORD g_display_config_api_error = ERROR_SUCCESS;
+
+  void
+    Log(const wchar_t *format, ...) {
+    wchar_t program_data[MAX_PATH] = {};
+    if (!GetEnvironmentVariableW(L"ProgramData", program_data, ARRAYSIZE(program_data))) {
+      // CreateProcessAsUser may inherit TermService's reduced environment
+      // while a synthetic session is still completing logon. Keep the proof
+      // observable without changing the launched user's profile or registry.
+      StringCchCopyW(program_data, ARRAYSIZE(program_data), L"C:\\ProgramData");
+    }
+
+    wchar_t path[MAX_PATH] = {};
+    if (FAILED(StringCchPrintfW(
+          path,
+          ARRAYSIZE(path),
+          L"%s\\Sunshine\\RdpProtocolProvider\\wcg-bootstrap.log",
+          program_data
+        ))) {
+      return;
+    }
+
+    wchar_t message[2048] = {};
+    va_list arguments;
+    va_start(arguments, format);
+    const HRESULT format_hr = StringCchVPrintfW(message, ARRAYSIZE(message), format, arguments);
+    va_end(arguments);
+    if (FAILED(format_hr)) {
+      return;
+    }
+
+    SYSTEMTIME now = {};
+    GetLocalTime(&now);
+    wchar_t line[2304] = {};
+    if (FAILED(StringCchPrintfW(
+          line,
+          ARRAYSIZE(line),
+          L"%04hu-%02hu-%02hu %02hu:%02hu:%02hu.%03hu pid=%lu session=%lu %s\r\n",
+          now.wYear,
+          now.wMonth,
+          now.wDay,
+          now.wHour,
+          now.wMinute,
+          now.wSecond,
+          now.wMilliseconds,
+          GetCurrentProcessId(),
+          WTSGetActiveConsoleSessionId() == 0xffffffff ? 0xffffffff : []() {
+            DWORD session_id = 0xffffffff;
+            ProcessIdToSessionId(GetCurrentProcessId(), &session_id);
+            return session_id;
+          }(),
+          message
+        ))) {
+      return;
+    }
+
+    char utf8[8192] = {};
+    const int bytes = WideCharToMultiByte(CP_UTF8, 0, line, -1, utf8, ARRAYSIZE(utf8), nullptr, nullptr);
+    if (bytes <= 1) {
+      return;
+    }
+
+    HANDLE file = CreateFileW(
+      path,
+      FILE_APPEND_DATA,
+      FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+      nullptr,
+      OPEN_ALWAYS,
+      FILE_ATTRIBUTE_NORMAL,
+      nullptr
+    );
+    if (file == INVALID_HANDLE_VALUE) {
+      // The isolated proof directory intentionally excludes ordinary users.
+      // A session process may also lack the inherited ProgramData environment.
+      // Public Documents grants the interactive token append access and gives
+      // the proof a bounded, non-privileged diagnostic fallback.
+      file = CreateFileW(
+        L"C:\\Users\\Public\\Documents\\SunshineRdpWcgBootstrap.log",
+        FILE_APPEND_DATA,
+        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+        nullptr,
+        OPEN_ALWAYS,
+        FILE_ATTRIBUTE_NORMAL,
+        nullptr
+      );
+    }
+    if (file == INVALID_HANDLE_VALUE) {
+      return;
+    }
+    DWORD written = 0;
+    WriteFile(file, utf8, static_cast<DWORD>(bytes - 1), &written, nullptr);
+    CloseHandle(file);
+  }
+
+  bool
+    LoadDisplayConfigApi() {
+    const HMODULE user32 = LoadLibraryW(L"user32.dll");
+    if (!user32) {
+      g_display_config_api_error = GetLastError();
+      Log(L"LoadLibrary(user32.dll) failed error=%lu", g_display_config_api_error);
+      return false;
+    }
+
+    g_get_display_config_buffer_sizes = reinterpret_cast<GetDisplayConfigBufferSizesFn>(
+      GetProcAddress(user32, "GetDisplayConfigBufferSizes")
+    );
+    g_query_display_config = reinterpret_cast<QueryDisplayConfigFn>(GetProcAddress(user32, "QueryDisplayConfig"));
+    g_display_config_get_device_info = reinterpret_cast<DisplayConfigGetDeviceInfoFn>(
+      GetProcAddress(user32, "DisplayConfigGetDeviceInfo")
+    );
+    g_display_config_set_device_info = reinterpret_cast<DisplayConfigSetDeviceInfoFn>(
+      GetProcAddress(user32, "DisplayConfigSetDeviceInfo")
+    );
+    g_set_display_config = reinterpret_cast<SetDisplayConfigFn>(GetProcAddress(user32, "SetDisplayConfig"));
+    const bool complete = g_get_display_config_buffer_sizes && g_query_display_config &&
+                          g_display_config_get_device_info && g_display_config_set_device_info && g_set_display_config;
+    if (!complete) {
+      g_display_config_api_error = !g_get_display_config_buffer_sizes ? 0x20001 :
+                                   (!g_query_display_config ? 0x20002 :
+                                    (!g_display_config_get_device_info ? 0x20003 :
+                                     (!g_display_config_set_device_info ? 0x20004 : 0x20005)));
+    }
+    Log(
+      L"LoadLibrary(user32.dll) succeeded complete_display_config_api=%d api_error=0x%08lx",
+      complete,
+      g_display_config_api_error
+    );
+    return complete;
+  }
+
+  struct AdvancedColorState {
+    bool advanced_supported = false;
+    bool advanced_active = false;
+    bool limited_by_policy = false;
+    bool hdr_supported = false;
+    bool hdr_enabled = false;
+    bool wcg_supported = false;
+    bool wcg_enabled = false;
+    UINT32 bits_per_channel = 0;
+    DISPLAYCONFIG_ADVANCED_COLOR_MODE active_mode = DISPLAYCONFIG_ADVANCED_COLOR_MODE_SDR;
+  };
+
+  struct SelectedPath {
+    DISPLAYCONFIG_PATH_INFO path = {};
+    DISPLAYCONFIG_MODE_INFO source_mode = {};
+    bool has_source_mode = false;
+    wchar_t source_name[CCHDEVICENAME] = {};
+    wchar_t target_name[64] = {};
+    wchar_t target_path[128] = {};
+  };
+
+  LONG
+    QueryAdvancedColor(const DISPLAYCONFIG_PATH_INFO &path, AdvancedColorState *state) {
+    if (!state) {
+      return ERROR_INVALID_PARAMETER;
+    }
+    *state = {};
+
+    DISPLAYCONFIG_GET_ADVANCED_COLOR_INFO_2 info = {};
+    info.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_ADVANCED_COLOR_INFO_2;
+    info.header.size = sizeof(info);
+    info.header.adapterId = path.targetInfo.adapterId;
+    info.header.id = path.targetInfo.id;
+    const LONG result = g_display_config_get_device_info(&info.header);
+    if (result != ERROR_SUCCESS) {
+      return result;
+    }
+
+    state->advanced_supported = info.advancedColorSupported != 0;
+    state->advanced_active = info.advancedColorActive != 0;
+    state->limited_by_policy = info.advancedColorLimitedByPolicy != 0;
+    state->hdr_supported = info.highDynamicRangeSupported != 0;
+    state->hdr_enabled = info.highDynamicRangeUserEnabled != 0;
+    state->wcg_supported = info.wideColorSupported != 0;
+    state->wcg_enabled = info.wideColorUserEnabled != 0;
+    state->bits_per_channel = info.bitsPerColorChannel;
+    state->active_mode = info.activeColorMode;
+    return ERROR_SUCCESS;
+  }
+
+  void
+    LogState(const wchar_t *label, const SelectedPath &selected, const AdvancedColorState &state) {
+    const UINT32 pixel_format = selected.has_source_mode ?
+                                  static_cast<UINT32>(selected.source_mode.sourceMode.pixelFormat) :
+                                  0xffffffff;
+    Log(
+      L"%s source=%s target=%s target_path=%s adapter=%08lx:%08lx source_id=%lu target_id=%lu "
+      L"advanced_supported=%d active=%d policy=%d hdr_supported=%d hdr_enabled=%d "
+      L"wcg_supported=%d wcg_enabled=%d bpc=%lu active_mode=%u source_pixel_format=%u",
+      label,
+      selected.source_name[0] ? selected.source_name : L"(unknown)",
+      selected.target_name[0] ? selected.target_name : L"(unknown)",
+      selected.target_path[0] ? selected.target_path : L"(unknown)",
+      static_cast<DWORD>(selected.path.targetInfo.adapterId.HighPart),
+      selected.path.targetInfo.adapterId.LowPart,
+      selected.path.sourceInfo.id,
+      selected.path.targetInfo.id,
+      state.advanced_supported,
+      state.advanced_active,
+      state.limited_by_policy,
+      state.hdr_supported,
+      state.hdr_enabled,
+      state.wcg_supported,
+      state.wcg_enabled,
+      state.bits_per_channel,
+      static_cast<UINT32>(state.active_mode),
+      pixel_format
+    );
+  }
+
+  LONG
+    FindAdvancedColorPath(SelectedPath *selected, AdvancedColorState *state) {
+    if (!selected || !state) {
+      return ERROR_INVALID_PARAMETER;
+    }
+
+    for (DWORD attempt = 0; attempt < kTopologyRetryCount; ++attempt) {
+      UINT32 path_count = 0;
+      UINT32 mode_count = 0;
+      constexpr UINT32 query_flags = QDC_ONLY_ACTIVE_PATHS | QDC_VIRTUAL_MODE_AWARE;
+      LONG result = g_get_display_config_buffer_sizes(query_flags, &path_count, &mode_count);
+      if (result != ERROR_SUCCESS) {
+        Log(L"GetDisplayConfigBufferSizes attempt=%lu result=%ld", attempt, result);
+        Sleep(kTopologyRetryDelayMs);
+        continue;
+      }
+
+      std::vector<DISPLAYCONFIG_PATH_INFO> paths(path_count);
+      std::vector<DISPLAYCONFIG_MODE_INFO> modes(mode_count);
+      result = g_query_display_config(
+        query_flags,
+        &path_count,
+        paths.data(),
+        &mode_count,
+        modes.data(),
+        nullptr
+      );
+      if (result == ERROR_INSUFFICIENT_BUFFER) {
+        --attempt;
+        continue;
+      }
+      if (result != ERROR_SUCCESS) {
+        Log(L"QueryDisplayConfig attempt=%lu result=%ld", attempt, result);
+        Sleep(kTopologyRetryDelayMs);
+        continue;
+      }
+
+      for (UINT32 index = 0; index < path_count; ++index) {
+        AdvancedColorState candidate_state = {};
+        result = QueryAdvancedColor(paths[index], &candidate_state);
+        if (result != ERROR_SUCCESS || !candidate_state.advanced_supported) {
+          continue;
+        }
+
+        SelectedPath candidate = {};
+        candidate.path = paths[index];
+        const UINT32 source_mode_index = paths[index].sourceInfo.sourceModeInfoIdx;
+        if (source_mode_index != DISPLAYCONFIG_PATH_SOURCE_MODE_IDX_INVALID &&
+            source_mode_index < mode_count &&
+            modes[source_mode_index].infoType == DISPLAYCONFIG_MODE_INFO_TYPE_SOURCE) {
+          candidate.source_mode = modes[source_mode_index];
+          candidate.has_source_mode = true;
+        }
+
+        DISPLAYCONFIG_SOURCE_DEVICE_NAME source = {};
+        source.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_SOURCE_NAME;
+        source.header.size = sizeof(source);
+        source.header.adapterId = paths[index].sourceInfo.adapterId;
+        source.header.id = paths[index].sourceInfo.id;
+        if (g_display_config_get_device_info(&source.header) == ERROR_SUCCESS) {
+          StringCchCopyW(candidate.source_name, ARRAYSIZE(candidate.source_name), source.viewGdiDeviceName);
+        }
+
+        DISPLAYCONFIG_TARGET_DEVICE_NAME target = {};
+        target.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_TARGET_NAME;
+        target.header.size = sizeof(target);
+        target.header.adapterId = paths[index].targetInfo.adapterId;
+        target.header.id = paths[index].targetInfo.id;
+        if (g_display_config_get_device_info(&target.header) == ERROR_SUCCESS) {
+          StringCchCopyW(candidate.target_name, ARRAYSIZE(candidate.target_name), target.monitorFriendlyDeviceName);
+          StringCchCopyW(candidate.target_path, ARRAYSIZE(candidate.target_path), target.monitorDevicePath);
+        }
+
+        LogState(L"candidate", candidate, candidate_state);
+        if (candidate_state.wcg_supported && candidate_state.hdr_supported) {
+          *selected = candidate;
+          *state = candidate_state;
+          return ERROR_SUCCESS;
+        }
+      }
+
+      Sleep(kTopologyRetryDelayMs);
+    }
+    return ERROR_NOT_FOUND;
+  }
+
+  LONG
+    SetWcg(const SelectedPath &selected, bool enabled) {
+    DISPLAYCONFIG_SET_WCG_STATE request = {};
+    request.header.type = DISPLAYCONFIG_DEVICE_INFO_SET_WCG_STATE;
+    request.header.size = sizeof(request);
+    request.header.adapterId = selected.path.targetInfo.adapterId;
+    request.header.id = selected.path.targetInfo.id;
+    request.enableWcg = enabled ? 1 : 0;
+    return g_display_config_set_device_info(&request.header);
+  }
+
+  LONG
+    SetHdr(const SelectedPath &selected, bool enabled) {
+    DISPLAYCONFIG_SET_HDR_STATE request = {};
+    request.header.type = DISPLAYCONFIG_DEVICE_INFO_SET_HDR_STATE;
+    request.header.size = sizeof(request);
+    request.header.adapterId = selected.path.targetInfo.adapterId;
+    request.header.id = selected.path.targetInfo.id;
+    request.enableHdr = enabled ? 1 : 0;
+    return g_display_config_set_device_info(&request.header);
+  }
+
+  LONG
+    SetAdvancedColor(const SelectedPath &selected, bool enabled) {
+    DISPLAYCONFIG_SET_ADVANCED_COLOR_STATE request = {};
+    request.header.type = DISPLAYCONFIG_DEVICE_INFO_SET_ADVANCED_COLOR_STATE;
+    request.header.size = sizeof(request);
+    request.header.adapterId = selected.path.targetInfo.adapterId;
+    request.header.id = selected.path.targetInfo.id;
+    request.enableAdvancedColor = enabled ? 1 : 0;
+    return g_display_config_set_device_info(&request.header);
+  }
+
+  int
+    RunNongdiSourceMode(bool enable_hdr_immediately = false) {
+    SelectedPath selected = {};
+    AdvancedColorState before = {};
+    LONG result = FindAdvancedColorPath(&selected, &before);
+    if (result != ERROR_SUCCESS) {
+      Log(L"NONGDI source experiment found no active HDR path result=%ld", result);
+      return 2;
+    }
+    LogState(L"nongdi-before", selected, before);
+
+    constexpr UINT32 query_flags = QDC_ONLY_ACTIVE_PATHS | QDC_VIRTUAL_MODE_AWARE;
+    UINT32 path_count = 0;
+    UINT32 mode_count = 0;
+    result = g_get_display_config_buffer_sizes(query_flags, &path_count, &mode_count);
+    if (result != ERROR_SUCCESS) {
+      Log(L"NONGDI GetDisplayConfigBufferSizes result=%ld", result);
+      return 3;
+    }
+
+    std::vector<DISPLAYCONFIG_PATH_INFO> paths(path_count);
+    std::vector<DISPLAYCONFIG_MODE_INFO> modes(mode_count);
+    result = g_query_display_config(
+      query_flags,
+      &path_count,
+      paths.data(),
+      &mode_count,
+      modes.data(),
+      nullptr
+    );
+    if (result != ERROR_SUCCESS) {
+      Log(L"NONGDI QueryDisplayConfig result=%ld", result);
+      return 4;
+    }
+
+    bool changed = false;
+    for (UINT32 index = 0; index < path_count; ++index) {
+      const auto &path = paths[index];
+      if (path.targetInfo.adapterId.HighPart != selected.path.targetInfo.adapterId.HighPart ||
+          path.targetInfo.adapterId.LowPart != selected.path.targetInfo.adapterId.LowPart ||
+          path.targetInfo.id != selected.path.targetInfo.id) {
+        continue;
+      }
+
+      const UINT32 source_mode_index = path.sourceInfo.sourceModeInfoIdx;
+      if (source_mode_index == DISPLAYCONFIG_PATH_SOURCE_MODE_IDX_INVALID || source_mode_index >= mode_count ||
+          modes[source_mode_index].infoType != DISPLAYCONFIG_MODE_INFO_TYPE_SOURCE) {
+        Log(L"NONGDI matched path has no source mode index=%lu mode_count=%lu", source_mode_index, mode_count);
+        return 5;
+      }
+
+      Log(
+        L"NONGDI changing source mode index=%lu format=%u width=%lu height=%lu",
+        source_mode_index,
+        static_cast<UINT32>(modes[source_mode_index].sourceMode.pixelFormat),
+        modes[source_mode_index].sourceMode.width,
+        modes[source_mode_index].sourceMode.height
+      );
+      modes[source_mode_index].sourceMode.pixelFormat = DISPLAYCONFIG_PIXELFORMAT_NONGDI;
+      changed = true;
+      break;
+    }
+    if (!changed) {
+      Log(L"NONGDI selected target disappeared before apply");
+      return 6;
+    }
+
+    constexpr UINT32 set_flags = SDC_USE_SUPPLIED_DISPLAY_CONFIG | SDC_APPLY | SDC_ALLOW_CHANGES |
+                                 SDC_VIRTUAL_MODE_AWARE;
+    result = g_set_display_config(path_count, paths.data(), mode_count, modes.data(), set_flags);
+    Log(L"SetDisplayConfig NONGDI result=%ld paths=%lu modes=%lu flags=0x%08lx", result, path_count, mode_count, set_flags);
+    if (result != ERROR_SUCCESS) {
+      return 7;
+    }
+
+    if (enable_hdr_immediately) {
+      const LONG hdr_result = SetHdr(selected, true);
+      Log(L"immediate SET_HDR_STATE after NONGDI result=%ld", hdr_result);
+      for (DWORD poll = 0; poll < kStatePollCount; ++poll) {
+        SelectedPath immediate_path = {};
+        AdvancedColorState immediate = {};
+        result = FindAdvancedColorPath(&immediate_path, &immediate);
+        if (result != ERROR_SUCCESS) {
+          Log(L"NONGDI-then-HDR poll=%lu path query result=%ld", poll, result);
+          Sleep(kStatePollDelayMs);
+          continue;
+        }
+        LogState(L"nongdi-then-hdr-poll", immediate_path, immediate);
+        if (immediate.advanced_active && immediate.active_mode == DISPLAYCONFIG_ADVANCED_COLOR_MODE_HDR) {
+          Log(L"proof success: immediate NONGDI-then-HDR entered active HDR composition poll=%lu", poll);
+          return 0;
+        }
+        Sleep(kStatePollDelayMs);
+      }
+      Log(L"proof negative: immediate NONGDI-then-HDR did not enter active HDR composition");
+      return 10;
+    }
+
+    Sleep(500);
+    SelectedPath after_path = {};
+    AdvancedColorState after = {};
+    result = FindAdvancedColorPath(&after_path, &after);
+    if (result != ERROR_SUCCESS) {
+      Log(L"NONGDI post-apply path query result=%ld", result);
+      return 8;
+    }
+    LogState(L"nongdi-after", after_path, after);
+    if (after.advanced_active && after.active_mode == DISPLAYCONFIG_ADVANCED_COLOR_MODE_HDR) {
+      Log(L"proof success: NONGDI supplied source mode entered active HDR composition");
+      return 0;
+    }
+    Log(L"proof negative: NONGDI supplied source mode did not enter active HDR composition");
+    return 9;
+  }
+
+  enum class RequestedMode {
+    Wcg,
+    Hdr,
+    LegacyAdvancedColor,
+  };
+
+  int
+    RunAdvancedColorOn(RequestedMode requested_mode) {
+    DWORD session_id = 0xffffffff;
+    ProcessIdToSessionId(GetCurrentProcessId(), &session_id);
+    const wchar_t *request_name = requested_mode == RequestedMode::Wcg ?
+                                    L"WCG" :
+                                    (requested_mode == RequestedMode::Hdr ? L"HDR" : L"LEGACY_ADVANCED_COLOR");
+    Log(
+      L"begin %s-on process_session=%lu console_session=%lu",
+      request_name,
+      session_id,
+      WTSGetActiveConsoleSessionId()
+    );
+
+    SelectedPath selected = {};
+    AdvancedColorState before = {};
+    LONG result = FindAdvancedColorPath(&selected, &before);
+    if (result != ERROR_SUCCESS) {
+      Log(L"no active HDR+WCG DisplayConfig path result=%ld", result);
+      return 2;
+    }
+    LogState(L"before", selected, before);
+
+    if (requested_mode == RequestedMode::Wcg) {
+      result = SetWcg(selected, true);
+    } else if (requested_mode == RequestedMode::Hdr) {
+      result = SetHdr(selected, true);
+    } else {
+      result = SetAdvancedColor(selected, true);
+    }
+    Log(L"SET_%s_STATE enable=1 result=%ld", request_name, result);
+    if (result != ERROR_SUCCESS) {
+      return 3;
+    }
+
+    for (DWORD poll = 0; poll < kStatePollCount; ++poll) {
+      Sleep(kStatePollDelayMs);
+      AdvancedColorState after = {};
+      result = QueryAdvancedColor(selected.path, &after);
+      if (result != ERROR_SUCCESS) {
+        Log(L"post-WCG query poll=%lu result=%ld", poll, result);
+        continue;
+      }
+      LogState(L"after", selected, after);
+      const auto expected_mode = requested_mode == RequestedMode::Wcg ?
+                                   DISPLAYCONFIG_ADVANCED_COLOR_MODE_WCG :
+                                   DISPLAYCONFIG_ADVANCED_COLOR_MODE_HDR;
+      if (after.advanced_active && after.active_mode == expected_mode) {
+        Log(L"proof success: Windows entered requested %s composition", request_name);
+        return 0;
+      }
+    }
+
+    Log(L"proof negative: SET_%s_STATE was accepted but Windows did not enter the requested active mode", request_name);
+    return 4;
+  }
+
+  int
+    RunWcgThenHdr() {
+    DWORD session_id = 0xffffffff;
+    ProcessIdToSessionId(GetCurrentProcessId(), &session_id);
+    Log(
+      L"begin WCG-then-HDR process_session=%lu console_session=%lu",
+      session_id,
+      WTSGetActiveConsoleSessionId()
+    );
+
+    SelectedPath selected = {};
+    AdvancedColorState before = {};
+    LONG result = FindAdvancedColorPath(&selected, &before);
+    if (result != ERROR_SUCCESS) {
+      Log(L"WCG-then-HDR found no active HDR+WCG DisplayConfig path result=%ld", result);
+      return 2;
+    }
+    LogState(L"wcg-then-hdr-before", selected, before);
+
+    const LONG wcg_result = SetWcg(selected, true);
+    Log(L"WCG-then-HDR SET_WCG_STATE enable=1 result=%ld", wcg_result);
+
+    bool wcg_active = false;
+    SelectedPath current_path = selected;
+    AdvancedColorState current_state = before;
+    for (DWORD poll = 0; poll < kStatePollCount; ++poll) {
+      Sleep(kStatePollDelayMs);
+      SelectedPath polled_path = {};
+      AdvancedColorState polled_state = {};
+      result = FindAdvancedColorPath(&polled_path, &polled_state);
+      if (result != ERROR_SUCCESS) {
+        Log(L"WCG-then-HDR WCG poll=%lu path query result=%ld", poll, result);
+        continue;
+      }
+      current_path = polled_path;
+      current_state = polled_state;
+      LogState(L"wcg-then-hdr-after-wcg", current_path, current_state);
+      if (current_state.advanced_active &&
+          current_state.active_mode == DISPLAYCONFIG_ADVANCED_COLOR_MODE_WCG) {
+        wcg_active = true;
+        Log(L"WCG-then-HDR Windows entered active WCG composition poll=%lu", poll);
+        break;
+      }
+    }
+
+    const LONG hdr_result = SetHdr(current_path, true);
+    Log(
+      L"WCG-then-HDR SET_HDR_STATE enable=1 result=%ld wcg_set_result=%ld wcg_active=%d",
+      hdr_result,
+      wcg_result,
+      wcg_active
+    );
+
+    for (DWORD poll = 0; poll < kStatePollCount; ++poll) {
+      Sleep(kStatePollDelayMs);
+      SelectedPath polled_path = {};
+      AdvancedColorState polled_state = {};
+      result = FindAdvancedColorPath(&polled_path, &polled_state);
+      if (result != ERROR_SUCCESS) {
+        Log(L"WCG-then-HDR HDR poll=%lu path query result=%ld", poll, result);
+        continue;
+      }
+      current_path = polled_path;
+      current_state = polled_state;
+      LogState(L"wcg-then-hdr-after-hdr", current_path, current_state);
+      if (current_state.advanced_active &&
+          current_state.active_mode == DISPLAYCONFIG_ADVANCED_COLOR_MODE_HDR) {
+        Log(L"proof success: WCG-then-HDR entered active HDR composition poll=%lu", poll);
+        return 0;
+      }
+    }
+
+    Log(
+      L"proof negative: WCG-then-HDR did not enter active HDR composition "
+      L"wcg_set_result=%ld wcg_active=%d hdr_set_result=%ld",
+      wcg_result,
+      wcg_active,
+      hdr_result
+    );
+    return 4;
+  }
+
+}  // namespace
+
+int wmain(int argc, wchar_t **argv) {
+  Log(L"process entry argc=%d", argc);
+  if (argc != 2) {
+    fwprintf(stderr, L"usage: SunshineRdpWcgBootstrap.exe <--wcg-on|--hdr-on|--wcg-then-hdr|--advanced-on|--nongdi-source|--nongdi-then-hdr|--nongdi-source-wts>\n");
+    return 1;
+  }
+  if (!LoadDisplayConfigApi()) {
+    return g_display_config_api_error ? static_cast<int>(g_display_config_api_error) : 5;
+  }
+  if (_wcsicmp(argv[1], L"--wcg-on") == 0) {
+    return RunAdvancedColorOn(RequestedMode::Wcg);
+  }
+  if (_wcsicmp(argv[1], L"--hdr-on") == 0) {
+    return RunAdvancedColorOn(RequestedMode::Hdr);
+  }
+  if (_wcsicmp(argv[1], L"--wcg-then-hdr") == 0) {
+    return RunWcgThenHdr();
+  }
+  if (_wcsicmp(argv[1], L"--advanced-on") == 0) {
+    return RunAdvancedColorOn(RequestedMode::LegacyAdvancedColor);
+  }
+  if (_wcsicmp(argv[1], L"--nongdi-source") == 0) {
+    return RunNongdiSourceMode();
+  }
+  if (_wcsicmp(argv[1], L"--nongdi-then-hdr") == 0) {
+    return RunNongdiSourceMode(true);
+  }
+  if (_wcsicmp(argv[1], L"--nongdi-source-wts") == 0) {
+    DWORD session_id = 0xffffffff;
+    ProcessIdToSessionId(GetCurrentProcessId(), &session_id);
+    HANDLE user_token = nullptr;
+    if (!WTSQueryUserToken(session_id, &user_token)) {
+      Log(L"WTSQueryUserToken session=%lu failed error=%lu", session_id, GetLastError());
+      return 10;
+    }
+    if (!ImpersonateLoggedOnUser(user_token)) {
+      const DWORD error = GetLastError();
+      CloseHandle(user_token);
+      Log(L"ImpersonateLoggedOnUser session=%lu failed error=%lu", session_id, error);
+      return 11;
+    }
+    Log(L"impersonating authentic WTS user token session=%lu for NONGDI experiment", session_id);
+    const int result = RunNongdiSourceMode();
+    RevertToSelf();
+    CloseHandle(user_token);
+    return result;
+  }
+  fwprintf(stderr, L"usage: SunshineRdpWcgBootstrap.exe <--wcg-on|--hdr-on|--wcg-then-hdr|--advanced-on|--nongdi-source|--nongdi-then-hdr|--nongdi-source-wts>\n");
+  return 1;
+}
