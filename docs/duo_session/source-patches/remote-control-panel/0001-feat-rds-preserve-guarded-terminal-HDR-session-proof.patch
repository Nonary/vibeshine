+/**
+ * @brief Return whether this process is running as LocalSystem.
+ *
+ * @return True only when the process token user SID is LocalSystem.
+ */
+static bool IsCurrentProcessLocalSystem() {
+  HANDLE processToken = nullptr;
+  if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &processToken)) {
+    return false;
+  }
+
+  BYTE tokenUserBytes[sizeof(TOKEN_USER) + SECURITY_MAX_SID_SIZE] = {};
+  DWORD tokenUserSize = 0;
+  const BOOL queried = GetTokenInformation(
+    processToken,
+    TokenUser,
+    tokenUserBytes,
+    sizeof(tokenUserBytes),
+    &tokenUserSize);
+  CloseHandle(processToken);
+
+  BYTE localSystemSid[SECURITY_MAX_SID_SIZE] = {};
+  DWORD localSystemSidSize = sizeof(localSystemSid);
+  const BOOL madeSid = CreateWellKnownSid(
+    WinLocalSystemSid,
+    nullptr,
+    localSystemSid,
+    &localSystemSidSize);
+
+  const auto *tokenUser = reinterpret_cast<const TOKEN_USER *>(tokenUserBytes);
+  return queried && madeSid && EqualSid(tokenUser->User.Sid, localSystemSid);
+}
