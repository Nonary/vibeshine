+param(
+  [Parameter(Mandatory = $true)]
+  [ValidateSet("Arm", "EnableLogon", "Rollback", "Status")]
+  [string]$Mode,
+
+  [ValidateRange(120, 1800)]
+  [int]$DelaySeconds = 480
+)
+
+$ErrorActionPreference = "Stop"
+$TaskName = "Sunshine-RdpListenerAcl-Proof-Rollback"
+$ProofRoot = Join-Path $env:ProgramData "Sunshine\RdpHdrProof"
+$StagedScript = Join-Path $ProofRoot "rdp_listener_acl_guard.ps1"
+$StatePath = Join-Path $ProofRoot "rdp-listener-acl-state.json"
+$LogPath = Join-Path $ProofRoot "rdp-listener-acl-guard.log"
+$WinStationKeyPath = "SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp"
+$ServiceParameters = "SYSTEM\CurrentControlSet\Services\TermService\Parameters"
+$SafeServiceDll = "%SystemRoot%\System32\termsrv.dll"
+$RdpUsersAccount = "BUILTIN\Remote Desktop Users"
+$WinStationLogonIndex = [uint32]5
+$WinStationLogonBit = [uint32]0x20
+
+function Write-GuardLog([string]$Message) {
+  New-Item -ItemType Directory -Path $ProofRoot -Force | Out-Null
+  $line = "{0:o} {1}" -f (Get-Date), $Message
+  Add-Content -LiteralPath $LogPath -Value $line -Encoding UTF8
+  Write-Host $line
+}
+
+function Assert-Administrator {
+  $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
+  $principal = [Security.Principal.WindowsPrincipal]::new($identity)
+  if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
+    throw "The RDP listener ACL proof guard requires an elevated administrator process."
+  }
+}
+
+function Assert-CoreIsolationRunning {
+  $deviceGuard = Get-CimInstance Win32_DeviceGuard -Namespace root\Microsoft\Windows\DeviceGuard
+  if ($deviceGuard.VirtualizationBasedSecurityStatus -ne 2 -or
+      $deviceGuard.SecurityServicesRunning -notcontains 2) {
+    throw "VBS/HVCI is not running; this proof must not weaken Core Isolation."
+  }
+}
+
+function Get-ServiceDllState {
+  $key = [Microsoft.Win32.Registry]::LocalMachine.OpenSubKey($ServiceParameters, $false)
+  if (-not $key) {
+    throw "TermService Parameters registry key is missing."
+  }
+  try {
+    return [pscustomobject]@{
+      Value = [string]$key.GetValue("ServiceDll", $null, [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames)
+      Kind = [string]$key.GetValueKind("ServiceDll")
+    }
+  } finally {
+    $key.Dispose()
+  }
+}
+
+function Set-ServiceDllInbox {
+  $key = [Microsoft.Win32.Registry]::LocalMachine.OpenSubKey($ServiceParameters, $true)
+  if (-not $key) {
+    throw "TermService Parameters registry key cannot be opened."
+  }
+  try {
+    $key.SetValue("ServiceDll", $SafeServiceDll, [Microsoft.Win32.RegistryValueKind]::ExpandString)
+    $key.Flush()
+  } finally {
+    $key.Dispose()
+  }
+}
+
+function Get-ListenerSecurity {
+  $key = [Microsoft.Win32.Registry]::LocalMachine.OpenSubKey($WinStationKeyPath, $false)
+  if (-not $key) {
+    throw "RDP-Tcp registry key is missing."
+  }
+  try {
+    $kind = $key.GetValueKind("Security")
+    $value = [byte[]]$key.GetValue("Security", $null, [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames)
+    if ($kind -ne [Microsoft.Win32.RegistryValueKind]::Binary -or -not $value) {
+      throw "RDP-Tcp Security is not a nonempty REG_BINARY value."
+    }
+    return $value
+  } finally {
+    $key.Dispose()
+  }
+}
+
+function Set-ListenerSecurity([byte[]]$Value) {
+  $key = [Microsoft.Win32.Registry]::LocalMachine.OpenSubKey($WinStationKeyPath, $true)
+  if (-not $key) {
+    throw "RDP-Tcp registry key cannot be opened for rollback."
+  }
+  try {
+    $key.SetValue("Security", $Value, [Microsoft.Win32.RegistryValueKind]::Binary)
+    $key.Flush()
+  } finally {
+    $key.Dispose()
+  }
+}
+
+function Get-RdpUsersPermission {
+  $matches = @(Get-CimInstance -Namespace root\cimv2\TerminalServices -ClassName Win32_TSAccount |
+    Where-Object { $_.TerminalName -eq "RDP-Tcp" -and $_.AccountName -eq $RdpUsersAccount })
+  if ($matches.Count -ne 1) {
+    throw "Expected exactly one RDP-Tcp permission entry for '$RdpUsersAccount'; found $($matches.Count)."
+  }
+  return $matches[0]
+}
+
+function Restart-TerminalStack {
+  $redirector = Get-Service -Name UmRdpService
+  if ($redirector.Status -ne [System.ServiceProcess.ServiceControllerStatus]::Stopped) {
+    Stop-Service -Name UmRdpService -Force
+    $redirector.WaitForStatus([System.ServiceProcess.ServiceControllerStatus]::Stopped, [timespan]::FromSeconds(20))
+  }
+  try {
+    Restart-Service -Name TermService -Force
+    (Get-Service -Name TermService).WaitForStatus([System.ServiceProcess.ServiceControllerStatus]::Running, [timespan]::FromSeconds(30))
+  } finally {
+    $redirector = Get-Service -Name UmRdpService
+    if ($redirector.Status -ne [System.ServiceProcess.ServiceControllerStatus]::Running) {
+      Start-Service -Name UmRdpService
+      $redirector.WaitForStatus([System.ServiceProcess.ServiceControllerStatus]::Running, [timespan]::FromSeconds(20))
+    }
+  }
+}
+
+function Remove-DeadlineTask {
+  if (Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue) {
+    Unregister-ScheduledTask -TaskName $TaskName -Confirm:$false
+  }
+}
+
+function Assert-InboxBaseline {
+  $dll = Get-ServiceDllState
+  if ($dll.Kind -ne "ExpandString" -or $dll.Value -ne $SafeServiceDll) {
+    throw "The listener ACL guard can only arm while inbox termsrv.dll is configured."
+  }
+  Assert-CoreIsolationRunning
+}
+
+function Invoke-Rollback {
+  Write-GuardLog "rollback begin"
+  if (Test-Path -LiteralPath $StatePath -PathType Leaf) {
+    $state = Get-Content -LiteralPath $StatePath -Raw | ConvertFrom-Json
+    $original = [Convert]::FromBase64String([string]$state.OriginalSecurityBase64)
+    Set-ListenerSecurity $original
+  }
+  Set-ServiceDllInbox
+  Restart-TerminalStack
+  if (Test-Path -LiteralPath $StatePath -PathType Leaf) {
+    $restored = Get-ListenerSecurity
+    if ([Convert]::ToBase64String($restored) -ne [string]$state.OriginalSecurityBase64) {
+      throw "RDP-Tcp Security did not return to the armed baseline."
+    }
+  }
+  Assert-InboxBaseline
+  Remove-DeadlineTask
+  Remove-Item -LiteralPath $StatePath -Force -ErrorAction SilentlyContinue
+  Write-GuardLog "rollback complete; exact listener ACL restored; inbox termsrv.dll and HVCI remain active"
+}
+
+Assert-Administrator
+
+switch ($Mode) {
+  "Arm" {
+    Assert-InboxBaseline
+    $permission = Get-RdpUsersPermission
+    New-Item -ItemType Directory -Path $ProofRoot -Force | Out-Null
+    Copy-Item -LiteralPath $PSCommandPath -Destination $StagedScript -Force
+    & icacls.exe $ProofRoot /inheritance:r /grant:r `
+      "*S-1-5-18:(OI)(CI)F" `
+      "*S-1-5-32-544:(OI)(CI)F" `
+      "*S-1-5-20:(OI)(CI)RX" | Out-Null
+    if ($LASTEXITCODE -ne 0) {
+      throw "Failed to protect the proof directory."
+    }
+    [pscustomobject]@{
+      ArmedAt = (Get-Date).ToString("o")
+      OriginalSecurityBase64 = [Convert]::ToBase64String((Get-ListenerSecurity))
+      OriginalAllowed = [uint32]$permission.PermissionsAllowed
+      OriginalDenied = [uint32]$permission.PermissionsDenied
+      StagedScriptSha256 = (Get-FileHash -LiteralPath $StagedScript -Algorithm SHA256).Hash
+    } | ConvertTo-Json | Set-Content -LiteralPath $StatePath -Encoding UTF8
+
+    Remove-DeadlineTask
+    $action = New-ScheduledTaskAction -Execute "powershell.exe" -Argument (
+      '-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "{0}" -Mode Rollback' -f $StagedScript
+    )
+    $trigger = New-ScheduledTaskTrigger -Once -At (Get-Date).AddSeconds($DelaySeconds)
+    $principal = New-ScheduledTaskPrincipal -UserId "SYSTEM" -LogonType ServiceAccount -RunLevel Highest
+    $settings = New-ScheduledTaskSettingsSet -StartWhenAvailable -ExecutionTimeLimit (New-TimeSpan -Minutes 3) -MultipleInstances IgnoreNew
+    Register-ScheduledTask -TaskName $TaskName -Action $action -Trigger $trigger -Principal $principal -Settings $settings -Force | Out-Null
+    $info = Get-ScheduledTaskInfo -TaskName $TaskName
+    Write-GuardLog "armed exact RDP-Tcp ACL rollback for $($info.NextRunTime.ToString('o')); permissions unchanged"
+  }
+
+  "EnableLogon" {
+    Assert-InboxBaseline
+    $task = Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue
+    $info = if ($task) { Get-ScheduledTaskInfo -TaskName $TaskName } else { $null }
+    if (-not $task -or $task.Principal.UserId -ne "SYSTEM" -or $info.NextRunTime -le (Get-Date).AddSeconds(90)) {
+      throw "At least ninety seconds must remain on the SYSTEM rollback deadline."
+    }
+    if (-not (Test-Path -LiteralPath $StatePath -PathType Leaf)) {
+      throw "The armed listener ACL state is missing."
+    }
+    $permission = Get-RdpUsersPermission
+    $result = Invoke-CimMethod -InputObject $permission -MethodName ModifyPermissions -Arguments @{
+      PermissionMask = $WinStationLogonIndex
+      Allow = $true
+    }
+    if ($result.ReturnValue -ne 0) {
+      throw "Win32_TSAccount.ModifyPermissions(LOGON, Allow) returned $($result.ReturnValue)."
+    }
+    $updated = Get-RdpUsersPermission
+    if (([uint32]$updated.PermissionsAllowed -band $WinStationLogonBit) -eq 0 -or
+        ([uint32]$updated.PermissionsDenied -band $WinStationLogonBit) -ne 0) {
+      throw "RDP-Tcp Remote Desktop Users still lacks an allowed, non-denied LOGON permission."
+    }
+    Assert-CoreIsolationRunning
+    Write-GuardLog "enabled only RDP-Tcp LOGON for Remote Desktop Users; allowed=$($updated.PermissionsAllowed) denied=$($updated.PermissionsDenied); rollback remains armed"
+  }
+
+  "Rollback" {
+    Invoke-Rollback
+  }
+
+  "Status" {
+    $permission = Get-RdpUsersPermission
+    $task = Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue
+    $info = if ($task) { Get-ScheduledTaskInfo -TaskName $TaskName } else { $null }
+    $deviceGuard = Get-CimInstance Win32_DeviceGuard -Namespace root\Microsoft\Windows\DeviceGuard
+    [pscustomobject]@{
+      Account = $permission.AccountName
+      PermissionsAllowed = [uint32]$permission.PermissionsAllowed
+      PermissionsDenied = [uint32]$permission.PermissionsDenied
+      LogonAllowed = (([uint32]$permission.PermissionsAllowed -band $WinStationLogonBit) -ne 0)
+      LogonDenied = (([uint32]$permission.PermissionsDenied -band $WinStationLogonBit) -ne 0)
+      StatePresent = Test-Path -LiteralPath $StatePath -PathType Leaf
+      RollbackTaskPresent = $null -ne $task
+      RollbackNextRunTime = if ($info) { $info.NextRunTime } else { $null }
+      HvciRunning = $deviceGuard.SecurityServicesRunning -contains 2
+    } | Format-List
+  }
+}
diff --git a/source/tools/rdp-protocol-provider/rdpcore_proxy_check.cpp b/source/tools/rdp-protocol-provider/rdpcore_proxy_check.cpp
new file mode 100644
index 00000000..681cbc34
--- /dev/null
+++ b/source/tools/rdp-protocol-provider/rdpcore_proxy_check.cpp
@@ -0,0 +1,68 @@
+#include <cstdio>
+#include <windows.h>
+#include <wtsprotocol.h>
+
+namespace {
+  const CLSID kProxyProtocolManagerClsid = {
+    0x9d2b9d0e,
+    0xb367,
+    0x484f,
+    {0x86, 0xa1, 0xde, 0x85, 0x94, 0x99, 0x69, 0xc2}
+  };
+
+  using DllGetClassObjectFn = HRESULT(__stdcall *)(REFCLSID, REFIID, void **);
+  using DllCanUnloadNowFn = HRESULT(__stdcall *)();
+}
+
+int wmain(int argc, wchar_t **argv) {
+  if (argc != 2) {
+    fwprintf(stderr, L"usage: SunshineRdpCoreProxyCheck.exe <SunshineRdpCoreProxy.dll>\n");
+    return 1;
+  }
+  HMODULE module = LoadLibraryExW(argv[1], nullptr, LOAD_WITH_ALTERED_SEARCH_PATH);
+  if (!module) {
+    fwprintf(stderr, L"LoadLibraryEx failed error=%lu\n", GetLastError());
+    return 2;
+  }
+
+  const auto get_class_object = reinterpret_cast<DllGetClassObjectFn>(GetProcAddress(module, "DllGetClassObject"));
+  const auto can_unload = reinterpret_cast<DllCanUnloadNowFn>(GetProcAddress(module, "DllCanUnloadNow"));
+  if (!get_class_object || !can_unload) {
+    fwprintf(stderr, L"required export missing\n");
+    FreeLibrary(module);
+    return 3;
+  }
+
+  const HRESULT initialize_hr = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+  wprintf(L"CoInitializeEx hr=0x%08lx\n", static_cast<unsigned long>(initialize_hr));
+  if (FAILED(initialize_hr)) {
+    FreeLibrary(module);
+    return 4;
+  }
+
+  IClassFactory *factory = nullptr;
+  HRESULT hr = get_class_object(
+    kProxyProtocolManagerClsid,
+    IID_IClassFactory,
+    reinterpret_cast<void **>(&factory)
+  );
+  wprintf(L"DllGetClassObject hr=0x%08lx factory=%p\n", static_cast<unsigned long>(hr), factory);
+  if (SUCCEEDED(hr)) {
+    IWRdsProtocolManager *manager = nullptr;
+    hr = factory->CreateInstance(
+      nullptr,
+      __uuidof(IWRdsProtocolManager),
+      reinterpret_cast<void **>(&manager)
+    );
+    wprintf(L"CreateInstance(IWRdsProtocolManager) hr=0x%08lx manager=%p\n", static_cast<unsigned long>(hr), manager);
+    if (manager) {
+      manager->Release();
+    }
+    factory->Release();
+  }
+  const HRESULT unload_hr = can_unload();
+  wprintf(L"DllCanUnloadNow hr=0x%08lx\n", static_cast<unsigned long>(unload_hr));
+  CoUninitialize();
+  FreeLibrary(module);
+  return SUCCEEDED(hr) && unload_hr == S_OK ? 0 : 5;
+}
diff --git a/source/tools/rdp-protocol-provider/rdpcore_proxy_guard.ps1 b/source/tools/rdp-protocol-provider/rdpcore_proxy_guard.ps1
new file mode 100644
index 00000000..7a90fd10
--- /dev/null
+++ b/source/tools/rdp-protocol-provider/rdpcore_proxy_guard.ps1
@@ -0,0 +1,218 @@
+param(
+  [Parameter(Mandatory = $true)]
+  [ValidateSet('Arm', 'Enable', 'Rollback', 'Status')]
+  [string] $Mode,
+
+  [ValidateRange(180, 1800)]
+  [int] $DelaySeconds = 600,
+
+  [string] $SourceDll = 'D:\sources\worktrees\duo-session-spike-rds-probe\source\cmake-build-rdp-protocol-provider\bin\SunshineRdpCoreProxy.dll',
+
+  [string] $ExpectedDllHash = 'CFA0C42619BBF2D9738434A9B0E4B93B3188553112C85D97F85E3198CE15E33F'
+)
+
+$ErrorActionPreference = 'Stop'
+$TaskName = 'Sunshine-RdpCoreProxy-Proof-Rollback'
+$ProofRoot = Join-Path $env:ProgramData 'Sunshine\RdpCoreProxyProof'
+$StagedScript = Join-Path $ProofRoot 'rdpcore_proxy_guard.ps1'
+$StagedDll = Join-Path $ProofRoot 'SunshineRdpCoreProxy.dll'
+$StatePath = Join-Path $ProofRoot 'state.json'
+$LogPath = Join-Path $ProofRoot 'guard.log'
+$SourceListener = 'Registry::HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp'
+$ProxyListener = 'Registry::HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\Sunshine-RdpCoreProxy'
+$ProxyClsid = '{9D2B9D0E-B367-484F-86A1-DE85949969C2}'
+$ProxyClsidPath = "Registry::HKEY_LOCAL_MACHINE\SOFTWARE\Classes\CLSID\$ProxyClsid"
+$ProxyPort = 3397
+
+function Write-GuardLog([string] $Message) {
+  New-Item -ItemType Directory -Path $ProofRoot -Force | Out-Null
+  $line = '{0:o} {1}' -f (Get-Date), $Message
+  Add-Content -LiteralPath $LogPath -Value $line -Encoding UTF8
+  Write-Host $line
+}
+
+function Assert-Administrator {
+  $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
+  $principal = [Security.Principal.WindowsPrincipal]::new($identity)
+  if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
+    throw 'The RDP Core proxy proof guard requires an elevated administrator process.'
+  }
+}
+
+function Assert-CoreIsolationRunning {
+  $deviceGuard = Get-CimInstance Win32_DeviceGuard -Namespace root\Microsoft\Windows\DeviceGuard
+  if ($deviceGuard.VirtualizationBasedSecurityStatus -ne 2 -or
+      $deviceGuard.SecurityServicesRunning -notcontains 2) {
+    throw 'VBS/HVCI is not running; this proof must not weaken Core Isolation.'
+  }
+}
+
+function Restart-TerminalStack {
+  $redirector = Get-Service -Name UmRdpService
+  if ($redirector.Status -ne [System.ServiceProcess.ServiceControllerStatus]::Stopped) {
+    Stop-Service -Name UmRdpService -Force
+    $redirector.WaitForStatus(
+      [System.ServiceProcess.ServiceControllerStatus]::Stopped,
+      [timespan]::FromSeconds(20)
+    )
+  }
+  try {
+    Restart-Service -Name TermService -Force
+    (Get-Service -Name TermService).WaitForStatus(
+      [System.ServiceProcess.ServiceControllerStatus]::Running,
+      [timespan]::FromSeconds(30)
+    )
+  } finally {
+    $redirector = Get-Service -Name UmRdpService
+    if ($redirector.Status -ne [System.ServiceProcess.ServiceControllerStatus]::Running) {
+      Start-Service -Name UmRdpService
+      $redirector.WaitForStatus(
+        [System.ServiceProcess.ServiceControllerStatus]::Running,
+        [timespan]::FromSeconds(20)
+      )
+    }
+  }
+}
+
+function Remove-DeadlineTask {
+  if (Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue) {
+    Unregister-ScheduledTask -TaskName $TaskName -Confirm:$false
+  }
+}
+
+function Assert-ArmedState {
+  if (-not (Test-Path -LiteralPath $StatePath -PathType Leaf) -or
+      -not (Test-Path -LiteralPath $StagedDll -PathType Leaf)) {
+    throw 'The RDP Core proxy proof is not armed.'
+  }
+  $state = Get-Content -LiteralPath $StatePath -Raw | ConvertFrom-Json
+  if ($state.DllSha256 -ne $ExpectedDllHash -or
+      (Get-FileHash -LiteralPath $StagedDll -Algorithm SHA256).Hash -ne $ExpectedDllHash) {
+    throw 'The staged RDP Core proxy DLL changed after arming.'
+  }
+  return $state
+}
+
+function Remove-ProofRegistry {
+  Remove-Item -LiteralPath $ProxyListener -Recurse -Force -ErrorAction SilentlyContinue
+  Remove-Item -LiteralPath $ProxyClsidPath -Recurse -Force -ErrorAction SilentlyContinue
+}
+
+function Invoke-Rollback {
+  Write-GuardLog 'rollback begin'
+  Remove-ProofRegistry
+  Restart-TerminalStack
+  Remove-Item -LiteralPath $StagedDll -Force -ErrorAction SilentlyContinue
+  Remove-DeadlineTask
+  Remove-Item -LiteralPath $StatePath -Force -ErrorAction SilentlyContinue
+  if ((Test-Path -LiteralPath $ProxyListener) -or (Test-Path -LiteralPath $ProxyClsidPath)) {
+    throw 'The proxy listener or CLSID remains after rollback.'
+  }
+  Assert-CoreIsolationRunning
+  Write-GuardLog 'rollback complete; proxy listener and CLSID removed; terminal stack restarted; HVCI remains active'
+}
+
+Assert-Administrator
+
+switch ($Mode) {
+  'Arm' {
+    Assert-CoreIsolationRunning
+    if ((Test-Path -LiteralPath $ProxyListener) -or (Test-Path -LiteralPath $ProxyClsidPath)) {
+      throw 'A prior proxy listener or CLSID exists; refusing to overwrite it.'
+    }
+    if (-not (Test-Path -LiteralPath $SourceDll -PathType Leaf) -or
+        (Get-FileHash -LiteralPath $SourceDll -Algorithm SHA256).Hash -ne $ExpectedDllHash) {
+      throw 'The pinned RDP Core proxy DLL is missing or changed.'
+    }
+
+    New-Item -ItemType Directory -Path $ProofRoot -Force | Out-Null
+    Copy-Item -LiteralPath $PSCommandPath -Destination $StagedScript -Force
+    Copy-Item -LiteralPath $SourceDll -Destination $StagedDll -Force
+    & icacls.exe $ProofRoot /inheritance:r /grant:r `
+      '*S-1-5-18:(OI)(CI)F' `
+      '*S-1-5-32-544:(OI)(CI)F' `
+      '*S-1-5-20:(OI)(CI)RX' | Out-Null
+    if ($LASTEXITCODE -ne 0) {
+      throw 'Failed to protect the RDP Core proxy proof directory.'
+    }
+    [pscustomobject]@{
+      ArmedAt = (Get-Date).ToString('o')
+      DllSha256 = $ExpectedDllHash
+      ScriptSha256 = (Get-FileHash -LiteralPath $StagedScript -Algorithm SHA256).Hash
+      Listener = 'Sunshine-RdpCoreProxy'
+      Port = $ProxyPort
+      Clsid = $ProxyClsid
+    } | ConvertTo-Json | Set-Content -LiteralPath $StatePath -Encoding UTF8
+
+    Remove-DeadlineTask
+    $action = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument (
+      '-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "{0}" -Mode Rollback -ExpectedDllHash "{1}"' -f `
+        $StagedScript, $ExpectedDllHash
+    )
+    $trigger = New-ScheduledTaskTrigger -Once -At (Get-Date).AddSeconds($DelaySeconds)
+    $principal = New-ScheduledTaskPrincipal -UserId 'SYSTEM' -LogonType ServiceAccount -RunLevel Highest
+    $settings = New-ScheduledTaskSettingsSet -StartWhenAvailable -ExecutionTimeLimit (New-TimeSpan -Minutes 3) -MultipleInstances IgnoreNew
+    Register-ScheduledTask -TaskName $TaskName -Action $action -Trigger $trigger -Principal $principal -Settings $settings -Force | Out-Null
+    $info = Get-ScheduledTaskInfo -TaskName $TaskName
+    Write-GuardLog "armed exact proxy cleanup for $($info.NextRunTime.ToString('o')); registry and TermService unchanged"
+  }
+
+  'Enable' {
+    Assert-CoreIsolationRunning
+    $state = Assert-ArmedState
+    $task = Get-ScheduledTask -TaskName $TaskName -ErrorAction Stop
+    $info = Get-ScheduledTaskInfo -TaskName $TaskName
+    if ($task.Principal.UserId -ne 'SYSTEM' -or $info.NextRunTime -le (Get-Date).AddSeconds(120)) {
+      throw 'At least two minutes must remain on the SYSTEM proxy rollback deadline.'
+    }
+    if ((Test-Path -LiteralPath $ProxyListener) -or (Test-Path -LiteralPath $ProxyClsidPath)) {
+      throw 'The proxy listener or CLSID appeared after arming.'
+    }
+
+    Copy-Item -LiteralPath $SourceListener -Destination $ProxyListener -Recurse
+    Set-ItemProperty -LiteralPath $ProxyListener -Name 'LoadableProtocol_Object' -Type String -Value $ProxyClsid
+    Set-ItemProperty -LiteralPath $ProxyListener -Name 'PortNumber' -Type DWord -Value $ProxyPort
+    Set-ItemProperty -LiteralPath $ProxyListener -Name 'WdName' -Type String -Value 'Sunshine RDP Core Proxy'
+    Set-ItemProperty -LiteralPath $ProxyListener -Name 'WdPrefix' -Type String -Value 'SRPX'
+    Set-ItemProperty -LiteralPath $ProxyListener -Name 'fEnableWinStation' -Type DWord -Value 1
+    Set-ItemProperty -LiteralPath $ProxyListener -Name 'WinStationDisabled' -Type DWord -Value 0
+    Set-ItemProperty -LiteralPath $ProxyListener -Name 'fLogonDisabled' -Type DWord -Value 0
+
+    $inproc = Join-Path $ProxyClsidPath 'InprocServer32'
+    New-Item -Path $inproc -Force | Out-Null
+    Set-Item -LiteralPath $inproc -Value $StagedDll
+    New-ItemProperty -LiteralPath $inproc -Name 'ThreadingModel' -PropertyType String -Value 'Both' -Force | Out-Null
+
+    $listener = Get-ItemProperty -LiteralPath $ProxyListener
+    $registeredPath = [string](Get-Item -LiteralPath $inproc).GetValue('')
+    if ($listener.LoadableProtocol_Object -ne $ProxyClsid -or
+        $listener.PortNumber -ne $ProxyPort -or
+        $listener.fEnableWinStation -ne 1 -or
+        $listener.WinStationDisabled -ne 0 -or
+        $listener.fLogonDisabled -ne 0 -or
+        $registeredPath -ne $StagedDll) {
+      throw 'The exact proxy listener or COM registration did not persist.'
+    }
+    Write-GuardLog "enabled transparent proxy listener port=$ProxyPort; TermService restart is intentionally delegated to the outer compatibility guard"
+  }
+
+  'Rollback' {
+    Invoke-Rollback
+  }
+
+  'Status' {
+    $task = Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue
+    $info = if ($task) { Get-ScheduledTaskInfo -TaskName $TaskName } else { $null }
+    $listener = if (Test-Path -LiteralPath $ProxyListener) { Get-ItemProperty -LiteralPath $ProxyListener } else { $null }
+    [pscustomobject]@{
+      ListenerPresent = $null -ne $listener
+      ListenerEnabled = $listener -and $listener.fEnableWinStation -eq 1 -and $listener.WinStationDisabled -eq 0
+      ListenerPort = if ($listener) { $listener.PortNumber } else { $null }
+      ClsidPresent = Test-Path -LiteralPath $ProxyClsidPath
+      StagedDllPresent = Test-Path -LiteralPath $StagedDll -PathType Leaf
+      StatePresent = Test-Path -LiteralPath $StatePath -PathType Leaf
+      RollbackTaskPresent = $null -ne $task
+      RollbackNextRunTime = if ($info) { $info.NextRunTime } else { $null }
+    } | Format-List
+  }
+}
diff --git a/source/tools/rdp-protocol-provider/rdpcore_proxy_provider.cpp b/source/tools/rdp-protocol-provider/rdpcore_proxy_provider.cpp
new file mode 100644
index 00000000..7f624016
--- /dev/null
+++ b/source/tools/rdp-protocol-provider/rdpcore_proxy_provider.cpp
@@ -0,0 +1,672 @@
+#include <atomic>
+#include <cstdarg>
+#include <new>
+#include <strsafe.h>
+#include <windows.h>
+#include <wtsprotocol.h>
+
+namespace {
+
+  const CLSID kProxyProtocolManagerClsid = {
+    0x9d2b9d0e,
+    0xb367,
+    0x484f,
+    {0x86, 0xa1, 0xde, 0x85, 0x94, 0x99, 0x69, 0xc2}
+  };
+  constexpr wchar_t kRdpCoreProtocolManagerClsid[] = L"{5828227c-20cf-4408-b73f-73ab70b8849f}";
+  constexpr wchar_t kRemoteIddHardwareId[] = L"SUNSHINE_REMOTE_IDDCX";
+
+  HMODULE g_module = nullptr;
+  std::atomic<long> g_object_count {0};
+  std::atomic<long> g_lock_count {0};
+
+  void
+    Log(const wchar_t *format, ...) {
+    wchar_t message[2048] = {};
+    va_list arguments;
+    va_start(arguments, format);
+    const HRESULT format_hr = StringCchVPrintfW(message, ARRAYSIZE(message), format, arguments);
+    va_end(arguments);
+    if (FAILED(format_hr)) {
+      return;
+    }
+
+    SYSTEMTIME now = {};
+    GetLocalTime(&now);
+    wchar_t line[2304] = {};
+    if (FAILED(StringCchPrintfW(
+          line,
+          ARRAYSIZE(line),
+          L"%04hu-%02hu-%02hu %02hu:%02hu:%02hu.%03hu pid=%lu tid=%lu %s\r\n",
+          now.wYear,
+          now.wMonth,
+          now.wDay,
+          now.wHour,
+          now.wMinute,
+          now.wSecond,
+          now.wMilliseconds,
+          GetCurrentProcessId(),
+          GetCurrentThreadId(),
+          message
+        ))) {
+      return;
+    }
+    OutputDebugStringW(line);
+
+    HANDLE file = CreateFileW(
+      L"C:\\ProgramData\\Sunshine\\RdpProtocolProvider\\rdpcore-proxy.log",
+      FILE_APPEND_DATA,
+      FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+      nullptr,
+      OPEN_ALWAYS,
+      FILE_ATTRIBUTE_NORMAL,
+      nullptr
+    );
+    if (file == INVALID_HANDLE_VALUE) {
+      return;
+    }
+    char utf8[8192] = {};
+    const int bytes = WideCharToMultiByte(CP_UTF8, 0, line, -1, utf8, ARRAYSIZE(utf8), nullptr, nullptr);
+    if (bytes > 1) {
+      DWORD written = 0;
+      WriteFile(file, utf8, static_cast<DWORD>(bytes - 1), &written, nullptr);
+    }
+    CloseHandle(file);
+  }
+
+  class ConnectionProxy final:
+      public IWRdsProtocolConnection,
+      public IWRdsWddmIddProps,
+      public IWRdsWddmIddProps1 {
+   public:
