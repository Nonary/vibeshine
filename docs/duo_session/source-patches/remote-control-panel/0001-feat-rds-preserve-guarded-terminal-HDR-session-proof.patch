+   * @brief Create a disabled volatile proof listener for contract tests.
+   *
+   * @return Zero on success.
+   */
+  int CreateVolatileListenerDisabled() {
+    return CreateProofListenerDisabled(true);
+  }
+
+  /**
+   * @brief Create a disabled persistent proof listener for TermService discovery.
+   *
+   * @return Zero on success.
+   */
+  int CreatePersistentListenerDisabled() {
+    return CreateProofListenerDisabled(false);
+  }
