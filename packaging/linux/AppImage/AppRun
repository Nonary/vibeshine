#!/bin/bash

# custom AppRun for Vibeshine AppImage

# path of the extracted AppRun
HERE="$(dirname "$(readlink -f "${0}")")"
SUNSHINE_BIN_HERE=$HERE/usr/bin/vibeshine

# Set APPDIR when running directly from the AppDir:
if [ -z "$APPDIR" ]; then
    ARGV0="AppRun"
fi

cd "$HERE" || exit 1

function help() {
echo "
 ------------------------------
   Vibeshine AppImage package.
 ------------------------------

 vibeshine.AppImage options
 ------------------------

 Usage:  $ARGV0  --help, -h
 ------            # This message

         $ARGV0  --install, -i
                   # Configure input rules and system services with the native package.

         $ARGV0  --remove, -r
                   # Remove a native installation with its package manager.

         $ARGV0  --appimage-help
                   # Show available AppImage options

 vibeshine options
 ----------------
"
# print Vibeshine binary help, replacing the command in the usage statement
"$SUNSHINE_BIN_HERE" --help | sed -e "s#$SUNSHINE_BIN_HERE#$ARGV0#g"
}

function native_package_required() {
  echo "Use the native Vibeshine package to manage input rules and system services." >&2
  echo "The AppImage launcher supports portable execution without privilege changes." >&2
  return 1
}

# process arguments
if [ "x$1" == "xhelp" ] || [ "x$1" == "x--help" ] || [ "x$1" == "x-h" ] ; then
    help
    exit $?
fi

if [ "x$1" == "xinstall" ] || [ "x$1" == "x--install" ] || [ "x$1" == "x-i" ] ; then
    native_package_required
    exit $?
fi

if [ "x$1" == "xremove" ] || [ "x$1" == "x--remove" ] || [ "x$1" == "x-r" ] ; then
    native_package_required
    exit $?
fi

# create config directory if it doesn't exist
# https://github.com/LizardByte/Sunshine/issues/324
mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/vibeshine"

# run Vibeshine
"$SUNSHINE_BIN_HERE" "$@"
