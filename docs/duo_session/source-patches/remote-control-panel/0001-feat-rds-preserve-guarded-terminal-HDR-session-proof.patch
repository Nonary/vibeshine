+/**
+ * @brief Create a disposable local-user token in a requested session.
+ *
+ * The UTF-8 credential file contains domain, user, and password on separate
+ * lines. Only a LocalSystem caller may use this mode. The file is deleted
+ * before LogonUserW is called and all in-memory credential buffers are wiped.
+ *
+ * @param credentialPath One-use credential file path.
+ * @param sessionId Target Windows session ID.
+ * @return Primary user token assigned to the target session, or null.
+ */
+static HANDLE OpenCredentialSessionToken(const wchar_t *credentialPath, DWORD sessionId) {
+  if (!IsCurrentProcessLocalSystem()) {
+    SetLastError(ERROR_ACCESS_DENIED);
+    return nullptr;
+  }
+
+  HANDLE file = CreateFileW(
+    credentialPath,
+    GENERIC_READ | DELETE,
+    FILE_SHARE_READ | FILE_SHARE_DELETE,
+    nullptr,
+    OPEN_EXISTING,
+    FILE_ATTRIBUTE_NORMAL,
+    nullptr);
+  if (file == INVALID_HANDLE_VALUE) {
+    return nullptr;
+  }
+
+  char utf8[4097] = {};
+  DWORD bytesRead = 0;
+  const BOOL read = ReadFile(file, utf8, sizeof(utf8) - 1, &bytesRead, nullptr);
+  const DWORD readError = GetLastError();
+  CloseHandle(file);
+  if (!read || bytesRead == 0 || bytesRead == sizeof(utf8) - 1) {
+    SecureZeroMemory(utf8, sizeof(utf8));
+    SetLastError(read ? ERROR_INVALID_DATA : readError);
+    return nullptr;
+  }
+  if (!DeleteFileW(credentialPath)) {
+    const DWORD deleteError = GetLastError();
+    SecureZeroMemory(utf8, sizeof(utf8));
+    SetLastError(deleteError);
+    return nullptr;
+  }
+
+  const int wideChars = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, utf8, bytesRead, nullptr, 0);
+  if (wideChars <= 0) {
+    const DWORD conversionError = GetLastError();
+    SecureZeroMemory(utf8, sizeof(utf8));
+    SetLastError(conversionError);
+    return nullptr;
+  }
+  std::wstring text(static_cast<std::size_t>(wideChars), L'\0');
+  MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, utf8, bytesRead, text.data(), wideChars);
+  SecureZeroMemory(utf8, sizeof(utf8));
+
+  std::size_t offset = 0;
+  const auto nextLine = [&text, &offset]() {
+    const auto end = text.find(L'\n', offset);
+    std::wstring line = text.substr(offset, end == std::wstring::npos ? end : end - offset);
+    if (!line.empty() && line.back() == L'\r') {
+      line.pop_back();
+    }
+    offset = end == std::wstring::npos ? text.size() : end + 1;
+    return line;
+  };
+  std::wstring domain = nextLine();
+  std::wstring user = nextLine();
+  std::wstring password = nextLine();
+  if (domain.empty() || user.empty() || password.empty()) {
+    SecureZeroMemory(text.data(), text.size() * sizeof(wchar_t));
+    SecureZeroMemory(password.data(), password.size() * sizeof(wchar_t));
+    SetLastError(ERROR_INVALID_DATA);
+    return nullptr;
+  }
+
+  HANDLE logonToken = nullptr;
+  const BOOL loggedOn = LogonUserW(
+    user.c_str(),
+    domain.c_str(),
+    password.data(),
+    LOGON32_LOGON_INTERACTIVE,
+    LOGON32_PROVIDER_DEFAULT,
+    &logonToken);
+  const DWORD logonError = GetLastError();
+  SecureZeroMemory(text.data(), text.size() * sizeof(wchar_t));
+  SecureZeroMemory(password.data(), password.size() * sizeof(wchar_t));
+  if (!loggedOn) {
+    SetLastError(logonError);
+    return nullptr;
+  }
+
+  HANDLE primary = DuplicatePrimaryToken(logonToken);
+  CloseHandle(logonToken);
+  if (!primary) {
+    return nullptr;
+  }
+
+  EnablePrivilege(L"SeTcbPrivilege");
+  if (!SetTokenInformation(primary, TokenSessionId, &sessionId, sizeof(sessionId))) {
+    const DWORD error = GetLastError();
+    CloseHandle(primary);
+    SetLastError(error);
+    return nullptr;
+  }
+  return primary;
+}
+
+/**
+ * @brief Duplicate and validate the authenticated token passed by TermService.
+ *
+ * The source PID must be the live TermService PID, the duplicated token must
+ * belong to the expected disposable user, and the caller must be LocalSystem.
+ * Only the duplicate has its target session changed.
+ *
+ * @param sourcePid Claimed TermService process ID.
+ * @param sourceHandle Token handle value in TermService.
+ * @param expectedUser Expected token account name.
+ * @param sessionId Target Windows session ID.
+ * @return Primary user token assigned to the target session, or null.
+ */
+static HANDLE OpenRdsAuthenticatedSessionToken(
+  DWORD sourcePid,
+  std::uintptr_t sourceHandle,
+  const wchar_t *expectedUser,
+  DWORD sessionId
+) {
+  if (!IsCurrentProcessLocalSystem()) {
+    SetLastError(ERROR_ACCESS_DENIED);
+    return nullptr;
+  }
+
+  SC_HANDLE scm = OpenSCManagerW(nullptr, nullptr, SC_MANAGER_CONNECT);
+  if (!scm) {
+    return nullptr;
+  }
+  SC_HANDLE service = OpenServiceW(scm, L"TermService", SERVICE_QUERY_STATUS);
+  if (!service) {
+    const DWORD error = GetLastError();
+    CloseServiceHandle(scm);
+    SetLastError(error);
+    return nullptr;
+  }
+  SERVICE_STATUS_PROCESS status = {};
+  DWORD statusBytes = 0;
+  const BOOL queried = QueryServiceStatusEx(
+    service,
+    SC_STATUS_PROCESS_INFO,
+    reinterpret_cast<BYTE *>(&status),
+    sizeof(status),
+    &statusBytes);
+  const DWORD queryError = GetLastError();
+  CloseServiceHandle(service);
+  CloseServiceHandle(scm);
+  if (!queried || status.dwProcessId != sourcePid) {
+    SetLastError(queried ? ERROR_INVALID_OWNER : queryError);
+    return nullptr;
+  }
+
+  EnablePrivilege(L"SeDebugPrivilege");
+  HANDLE sourceProcess = OpenProcess(PROCESS_DUP_HANDLE, FALSE, sourcePid);
+  if (!sourceProcess) {
+    return nullptr;
+  }
+  HANDLE token = nullptr;
+  const BOOL duplicatedHandle = DuplicateHandle(
+    sourceProcess,
+    reinterpret_cast<HANDLE>(sourceHandle),
+    GetCurrentProcess(),
+    &token,
+    0,
+    FALSE,
+    DUPLICATE_SAME_ACCESS);
+  const DWORD duplicateError = GetLastError();
+  CloseHandle(sourceProcess);
+  if (!duplicatedHandle) {
+    SetLastError(duplicateError);
+    return nullptr;
+  }
+
+  BYTE tokenUserBytes[sizeof(TOKEN_USER) + SECURITY_MAX_SID_SIZE] = {};
+  DWORD tokenUserSize = 0;
+  if (!GetTokenInformation(token, TokenUser, tokenUserBytes, sizeof(tokenUserBytes), &tokenUserSize)) {
+    const DWORD error = GetLastError();
+    CloseHandle(token);
+    SetLastError(error);
+    return nullptr;
+  }
+  const auto *tokenUser = reinterpret_cast<const TOKEN_USER *>(tokenUserBytes);
+  wchar_t account[256] = {};
+  wchar_t domain[256] = {};
+  DWORD accountChars = ARRAYSIZE(account);
+  DWORD domainChars = ARRAYSIZE(domain);
+  SID_NAME_USE sidType = SidTypeUnknown;
+  if (!LookupAccountSidW(nullptr, tokenUser->User.Sid, account, &accountChars, domain, &domainChars, &sidType) ||
+      _wcsicmp(account, expectedUser) != 0) {
+    const DWORD error = GetLastError();
+    CloseHandle(token);
+    SetLastError(error == ERROR_SUCCESS ? ERROR_INVALID_OWNER : error);
+    return nullptr;
+  }
+
+  HANDLE primary = DuplicatePrimaryToken(token);
+  CloseHandle(token);
+  if (!primary) {
+    return nullptr;
+  }
+  EnablePrivilege(L"SeTcbPrivilege");
+  if (!SetTokenInformation(primary, TokenSessionId, &sessionId, sizeof(sessionId))) {
+    const DWORD error = GetLastError();
+    CloseHandle(primary);
+    SetLastError(error);
+    return nullptr;
+  }
+  return primary;
+}
+
+/**
+ * @brief Tail the provider log and immediately duplicate a newly logged RDS token.
+ *
+ * The file is opened at its current end, so stale handles from earlier seats
+ * cannot be selected. Polling and duplication stay in one native process to
+ * avoid scheduled-task and PowerShell latency while the source handle is live.
+ *
+ * @param providerLogPath Provider log to tail.
+ * @param expectedUser Expected disposable account name.
+ * @param sessionId Target Windows session ID.
+ * @return Primary authenticated user token assigned to the target session.
+ */
+static HANDLE WaitForRdsAuthenticatedSessionToken(
+  const wchar_t *providerLogPath,
+  const wchar_t *expectedUser,
+  DWORD sessionId
+) {
+  if (!IsCurrentProcessLocalSystem()) {
+    SetLastError(ERROR_ACCESS_DENIED);
+    return nullptr;
+  }
+
+  HANDLE file = CreateFileW(
+    providerLogPath,
+    GENERIC_READ,
+    FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+    nullptr,
+    OPEN_EXISTING,
+    FILE_ATTRIBUTE_NORMAL,
+    nullptr);
+  if (file == INVALID_HANDLE_VALUE) {
+    return nullptr;
+  }
+  LARGE_INTEGER end = {};
+  if (!SetFilePointerEx(file, {}, &end, FILE_END)) {
+    const DWORD error = GetLastError();
+    CloseHandle(file);
+    SetLastError(error);
+    return nullptr;
+  }
+
+  std::string expectedUserAscii;
+  for (const wchar_t *cursor = expectedUser; *cursor; ++cursor) {
+    if (*cursor > 0x7f) {
+      CloseHandle(file);
+      SetLastError(ERROR_INVALID_NAME);
+      return nullptr;
+    }
+    expectedUserAscii.push_back(static_cast<char>(*cursor));
+  }
+  const std::string sessionNeedle =
+    "ProtocolConnection::IsUserAllowedToLogon session=" + std::to_string(sessionId) + " token=";
+  const std::string userNeedle = "\\" + expectedUserAscii;
+
+  std::string pending;
+  const ULONGLONG deadline = GetTickCount64() + 24000;
+  while (GetTickCount64() < deadline) {
+    char bytes[4096] = {};
+    DWORD read = 0;
+    if (!ReadFile(file, bytes, sizeof(bytes), &read, nullptr)) {
+      const DWORD error = GetLastError();
+      CloseHandle(file);
+      SetLastError(error);
+      return nullptr;
+    }
+    if (read == 0) {
+      Sleep(1);
+      continue;
+    }
+    pending.append(bytes, bytes + read);
+
+    for (std::size_t newline = pending.find('\n'); newline != std::string::npos; newline = pending.find('\n')) {
+      std::string line = pending.substr(0, newline);
+      pending.erase(0, newline + 1);
+      const auto marker = line.find(sessionNeedle);
+      if (marker == std::string::npos || line.find(userNeedle, marker) == std::string::npos) {
+        continue;
+      }
+      const auto pidMarker = line.find(" pid=");
+      if (pidMarker == std::string::npos) {
+        continue;
+      }
+      const DWORD sourcePid = static_cast<DWORD>(std::strtoul(line.c_str() + pidMarker + 5, nullptr, 10));
+      const auto tokenStart = marker + sessionNeedle.size();
+      const auto sourceHandle = static_cast<std::uintptr_t>(
+        std::strtoull(line.c_str() + tokenStart, nullptr, 0));
+      CloseHandle(file);
+      return OpenRdsAuthenticatedSessionToken(sourcePid, sourceHandle, expectedUser, sessionId);
+    }
+    if (pending.size() > 65536) {
+      pending.erase(0, pending.size() - 4096);
+    }
+  }
+
+  CloseHandle(file);
+  SetLastError(WAIT_TIMEOUT);
+  return nullptr;
+}
