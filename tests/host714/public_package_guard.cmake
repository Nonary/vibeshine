if(NOT DEFINED GUARD_SOURCE OR NOT DEFINED GUARD_TEST_ROOT)
    message(FATAL_ERROR "Explicit source and test-build directories required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef token)
set(test_root "${GUARD_TEST_ROOT}/vibe-package-guard-${token}")
file(MAKE_DIRECTORY "${test_root}/empty" "${test_root}/shared-driver" "${test_root}/endpoint/tools")
file(WRITE "${test_root}/shared-driver/usbip2_ude.sys" "test marker, not a driver")
file(WRITE "${test_root}/endpoint/tools/VibeUsbBridge.exe" "test marker, not an executable")
foreach(case IN ITEMS empty shared-driver endpoint private-flag)
    set(private OFF)
    set(stage "${test_root}/${case}")
    if(case STREQUAL "private-flag")
        set(stage "${test_root}/empty")
        set(private ON)
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DCPACK_TEMPORARY_DIRECTORY=${stage}"
        "-DCPACK_VIBE_PRIVATE_IDENTITY=${private}" -P "${GUARD_SOURCE}"
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(case STREQUAL "endpoint" OR case STREQUAL "private-flag")
        if(result EQUAL 0)
            message(FATAL_ERROR "Pending-identity endpoint packaging was allowed: ${case}")
        endif()
    elseif(NOT result EQUAL 0)
        message(FATAL_ERROR "Ordinary package/shared transport was blocked: ${case}")
    endif()
endforeach()
message(STATUS "PASS: ordinary/shared-driver packages allowed; private endpoint and leaked bridge blocked")
