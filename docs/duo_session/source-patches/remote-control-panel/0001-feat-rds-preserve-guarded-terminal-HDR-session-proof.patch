+  /**
+   * @brief Normalize a Windows path for a case-insensitive comparison.
+   *
+   * @param value Input path.
+   * @return Lowercase path using backslashes.
+   */
+  std::wstring
+    NormalizePath(std::wstring value) {
+    for (wchar_t &character : value) {
+      if (character == L'/') {
+        character = L'\\';
+      } else {
+        character = static_cast<wchar_t>(towlower(character));
+      }
+    }
+    return value;
+  }
+
+  /**
+   * @brief Set a DWORD registry value.
+   *
+   * @param key Open registry key.
+   * @param name Value name.
+   * @param value DWORD value.
+   * @return Win32 status.
+   */
+  LSTATUS
+  SetDword(HKEY key, const wchar_t *name, DWORD value) {
+    return RegSetValueExW(key, name, 0, REG_DWORD, reinterpret_cast<const BYTE *>(&value), sizeof(value));
+  }
+
+  /**
+   * @brief Set a string registry value.
+   *
+   * @param key Open registry key.
+   * @param name Value name.
+   * @param value String value.
+   * @return Win32 status.
+   */
+  LSTATUS
+  SetString(HKEY key, const wchar_t *name, const wchar_t *value) {
+    const DWORD bytes = static_cast<DWORD>((wcslen(value) + 1) * sizeof(wchar_t));
+    return RegSetValueExW(key, name, 0, REG_SZ, reinterpret_cast<const BYTE *>(value), bytes);
+  }
+
+  /**
+   * @brief Read a DWORD registry value.
+   *
+   * @param key Open registry key.
+   * @param name Value name.
+   * @param value Receives the value.
+   * @return True for a DWORD value.
+   */
+  bool
+    QueryDword(HKEY key, const wchar_t *name, DWORD *value) {
+    DWORD type = 0;
+    DWORD bytes = sizeof(*value);
+    return RegQueryValueExW(key, name, nullptr, &type, reinterpret_cast<BYTE *>(value), &bytes) == ERROR_SUCCESS &&
+           type == REG_DWORD && bytes == sizeof(*value);
+  }
+
+  /**
+   * @brief Read a string registry value.
+   *
+   * @param root Registry root.
+   * @param path Subkey path.
+   * @param name Value name, or null for the default value.
+   * @param value Receives the string.
+   * @return True for a string value.
+   */
+  bool
+    QueryString(HKEY root, const wchar_t *path, const wchar_t *name, std::wstring *value) {
+    HKEY key = nullptr;
+    if (RegOpenKeyExW(root, path, 0, KEY_QUERY_VALUE, &key) != ERROR_SUCCESS) {
+      return false;
+    }
+
+    DWORD type = 0;
+    DWORD bytes = 0;
+    LSTATUS status = RegQueryValueExW(key, name, nullptr, &type, nullptr, &bytes);
+    if (status != ERROR_SUCCESS || (type != REG_SZ && type != REG_EXPAND_SZ) || bytes < sizeof(wchar_t)) {
+      RegCloseKey(key);
+      return false;
+    }
+
+    std::vector<wchar_t> buffer(bytes / sizeof(wchar_t) + 1);
+    status = RegQueryValueExW(key, name, nullptr, &type, reinterpret_cast<BYTE *>(buffer.data()), &bytes);
+    RegCloseKey(key);
+    if (status != ERROR_SUCCESS) {
+      return false;
+    }
+    *value = buffer.data();
+    return true;
+  }
+
+  /**
+   * @brief Open one listener key.
+   *
+   * @param listener Listener name.
+   * @param access Requested access.
+   * @param key Receives the key.
+   * @return Win32 status.
+   */
+  LSTATUS
+  OpenListener(const wchar_t *listener, REGSAM access, HKEY *key) {
+    wchar_t path[512] = {};
+    if (FAILED(StringCchPrintfW(path, ARRAYSIZE(path), L"%s\\%s", kListenerRoot, listener))) {
+      return ERROR_BUFFER_OVERFLOW;
+    }
+    return RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, access, key);
+  }
+
+  /**
+   * @brief Force one listener into the fail-closed state.
+   *
+   * @param listener Listener name.
+   * @return True when absent or disabled successfully.
+   */
+  bool
+    DisableListener(const wchar_t *listener) {
+    HKEY key = nullptr;
+    const LSTATUS open_status = OpenListener(listener, KEY_SET_VALUE, &key);
+    if (open_status == ERROR_FILE_NOT_FOUND || open_status == ERROR_PATH_NOT_FOUND) {
+      return true;
+    }
+    if (open_status != ERROR_SUCCESS) {
+      return false;
+    }
+
+    const bool success =
+      SetDword(key, L"fEnableWinStation", 0) == ERROR_SUCCESS &&
+      SetDword(key, L"WinStationDisabled", 1) == ERROR_SUCCESS &&
+      SetDword(key, L"fLogonDisabled", 1) == ERROR_SUCCESS;
+    RegCloseKey(key);
+    return success;
+  }
+
+  /**
+   * @brief Ask Remote Desktop Services to stop a listener in its live listener table.
+   *
+   * Registry writes alone do not update the current TermService listener table.
+   * A missing/non-enumerated listener is already safe and is treated as success.
+   *
+   * @param listener Listener name.
+   * @return True when the listener is absent or disabled in the live table.
+   */
+  bool
+    DisableLiveListener(const wchar_t *listener) {
+    WTSLISTENERCONFIGW config = {};
+    if (!WTSQueryListenerConfigW(WTS_CURRENT_SERVER_HANDLE, nullptr, 0, const_cast<wchar_t *>(listener), &config)) {
+      const DWORD error = GetLastError();
+      return error == ERROR_FILE_NOT_FOUND || error == ERROR_PATH_NOT_FOUND || error == ERROR_INVALID_NAME;
+    }
+
+    config.version = 1;
+    config.fEnableListener = 0;
+    return WTSCreateListenerW(
+             WTS_CURRENT_SERVER_HANDLE,
+             nullptr,
+             0,
+             const_cast<wchar_t *>(listener),
+             &config,
+             WTS_LISTENER_UPDATE
+           ) != FALSE;
+  }
+
+  /**
+   * @brief Test whether a listener is absent or fully disabled.
+   *
+   * @param listener Listener name.
+   * @param require_present Whether absence is an error.
+   * @return True when the requested state is satisfied.
+   */
+  bool
+    IsListenerDisabled(const wchar_t *listener, bool require_present) {
+    HKEY key = nullptr;
+    const LSTATUS status = OpenListener(listener, KEY_QUERY_VALUE, &key);
+    if (status == ERROR_FILE_NOT_FOUND || status == ERROR_PATH_NOT_FOUND) {
+      return !require_present;
+    }
+    if (status != ERROR_SUCCESS) {
+      return false;
+    }
+
+    DWORD enabled = 0;
+    DWORD station_disabled = 0;
+    DWORD logon_disabled = 0;
+    const bool result =
+      QueryDword(key, L"fEnableWinStation", &enabled) && enabled == 0 &&
+      QueryDword(key, L"WinStationDisabled", &station_disabled) && station_disabled == 1 &&
+      QueryDword(key, L"fLogonDisabled", &logon_disabled) && logon_disabled == 1;
+    RegCloseKey(key);
+    return result;
+  }
+
+  /**
+   * @brief Copy all values from RDP-Tcp into a newly created listener.
+   *
+   * @param destination New listener key.
+   * @return Win32 status.
+   */
+  LSTATUS
+    CopyRdpTcpValues(HKEY destination) {
+    HKEY source = nullptr;
+    LSTATUS status = OpenListener(L"RDP-Tcp", KEY_QUERY_VALUE, &source);
+    if (status != ERROR_SUCCESS) {
+      return status;
+    }
+
+    DWORD value_count = 0;
+    DWORD maximum_name_count = 0;
+    DWORD maximum_data_count = 0;
+    status = RegQueryInfoKeyW(
+      source,
+      nullptr,
+      nullptr,
+      nullptr,
+      nullptr,
+      nullptr,
+      nullptr,
+      &value_count,
+      &maximum_name_count,
+      &maximum_data_count,
+      nullptr,
+      nullptr
+    );
+    if (status != ERROR_SUCCESS) {
+      RegCloseKey(source);
+      return status;
+    }
+
+    std::vector<wchar_t> name(maximum_name_count + 2);
+    std::vector<BYTE> data(maximum_data_count + sizeof(wchar_t));
+    for (DWORD index = 0; index < value_count; ++index) {
+      DWORD name_count = maximum_name_count + 1;
+      DWORD data_count = maximum_data_count;
+      DWORD type = 0;
+      status = RegEnumValueW(
+        source,
+        index,
+        name.data(),
+        &name_count,
+        nullptr,
+        &type,
+        data.data(),
+        &data_count
+      );
+      if (status != ERROR_SUCCESS) {
+        break;
+      }
+      status = RegSetValueExW(destination, name.data(), 0, type, data.data(), data_count);
+      if (status != ERROR_SUCCESS) {
+        break;
+      }
+    }
+
+    RegCloseKey(source);
+    return status;
+  }
+
+  /**
+   * @brief Create the proof listener as a newly allocated owned key.
+   *
+   * The volatile test path creates a new registry key directly. The persistent
+   * live path uses WTSCreateListener so TermService adds it to its current listener
+   * table, then replaces the stock RDP protocol CLSID while the listener is still
+   * disabled. A persistent listener remains inert after reboot because the proof
+   * provider separately requires a volatile runtime arm.
+   *
+   * @param volatile_listener Whether the listener itself should be volatile.
+   * @return Zero on success.
+   */
+  int CreateProofListenerDisabled(bool volatile_listener) {
+    HKEY parent = nullptr;
+    LSTATUS status = RegOpenKeyExW(HKEY_LOCAL_MACHINE, kListenerRoot, 0, KEY_CREATE_SUB_KEY, &parent);
+    if (status != ERROR_SUCCESS) {
+      return Fail(L"open listener root", status);
+    }
+
+    HKEY existing = nullptr;
+    status = RegOpenKeyExW(parent, kProofListenerName, 0, KEY_READ, &existing);
+    if (status == ERROR_SUCCESS) {
+      RegCloseKey(existing);
+      RegCloseKey(parent);
+      return Fail(L"proof listener already exists", ERROR_ALREADY_EXISTS);
+    }
+    if (status != ERROR_FILE_NOT_FOUND && status != ERROR_PATH_NOT_FOUND) {
+      RegCloseKey(parent);
+      return Fail(L"check proof listener", status);
+    }
+
+    HKEY listener = nullptr;
+    DWORD disposition = 0;
+    if (volatile_listener) {
+      status = RegCreateKeyExW(
+        parent,
+        kProofListenerName,
+        0,
+        nullptr,
+        REG_OPTION_VOLATILE,
+        KEY_READ | KEY_WRITE,
+        nullptr,
+        &listener,
+        &disposition
+      );
+      RegCloseKey(parent);
+      if (status != ERROR_SUCCESS || disposition != REG_CREATED_NEW_KEY) {
+        if (listener) {
+          RegCloseKey(listener);
+        }
+        return Fail(L"create volatile proof listener", status == ERROR_SUCCESS ? ERROR_INVALID_STATE : status);
+      }
+    } else {
+      RegCloseKey(parent);
+      WTSLISTENERCONFIGW config = {};
+      if (!WTSQueryListenerConfigW(
+            WTS_CURRENT_SERVER_HANDLE,
+            nullptr,
+            0,
+            const_cast<wchar_t *>(L"RDP-Tcp"),
+            &config
+          )) {
+        return Fail(L"query RDP-Tcp listener template", GetLastError());
+      }
+      config.version = 1;
+      config.fEnableListener = 0;
+      config.PortNumber = kProofPort;
+      if (FAILED(StringCchCopyW(config.Comment, ARRAYSIZE(config.Comment), L"Sunshine disabled HDR proof listener"))) {
+        return Fail(L"set proof listener comment", ERROR_BUFFER_OVERFLOW);
+      }
+      if (!WTSCreateListenerW(
+            WTS_CURRENT_SERVER_HANDLE,
+            nullptr,
+            0,
+            const_cast<wchar_t *>(kProofListenerName),
+            &config,
+            WTS_LISTENER_CREATE
+          )) {
+        return Fail(L"create persistent proof listener through WTS", GetLastError());
+      }
+      status = OpenListener(kProofListenerName, KEY_READ | KEY_WRITE, &listener);
+      if (status != ERROR_SUCCESS) {
+        return Fail(L"open WTS-created proof listener", status);
+      }
+    }
+
+    status = CopyRdpTcpValues(listener);
+    if (status == ERROR_SUCCESS) {
+      status = SetString(listener, L"LoadableProtocol_Object", kProofProviderClsid);
+    }
+    if (status == ERROR_SUCCESS) {
+      status = SetString(listener, L"WdName", L"Sunshine isolated HDR proof");
+    }
+    if (status == ERROR_SUCCESS) {
+      status = SetString(listener, L"WdPrefix", L"SHDRP");
+    }
+    if (status == ERROR_SUCCESS) {
+      status = SetDword(listener, L"PortNumber", kProofPort);
+    }
+    if (status == ERROR_SUCCESS) {
+      status = SetDword(listener, L"WebSocketListenerPort", kProofWebSocketPort);
+    }
+    if (status == ERROR_SUCCESS) {
+      status = SetDword(listener, L"WebSocketTlsListenerPort", kProofWebSocketTlsPort);
+    }
+    if (status == ERROR_SUCCESS) {
+      status = SetDword(listener, kProofOwnedMarkerName, 1);
+    }
+    if (status == ERROR_SUCCESS) {
+      status = SetDword(listener, kProofMarkerName, volatile_listener ? 1 : 0);
+    }
+    if (status == ERROR_SUCCESS) {
+      status = SetDword(listener, L"fEnableWinStation", 0);
+    }
+    if (status == ERROR_SUCCESS) {
+      status = SetDword(listener, L"WinStationDisabled", 1);
+    }
+    if (status == ERROR_SUCCESS) {
+      status = SetDword(listener, L"fLogonDisabled", 1);
+    }
+    RegCloseKey(listener);
+
+    if (status != ERROR_SUCCESS) {
+      RegDeleteTreeW(HKEY_LOCAL_MACHINE, (std::wstring(kListenerRoot) + L"\\" + kProofListenerName).c_str());
+      return Fail(L"configure proof listener", status);
+    }
+
+    Log(volatile_listener ? L"created disabled volatile proof listener" : L"created disabled persistent proof listener");
+    wprintf(L"created %s listener %s disabled\n", volatile_listener ? L"volatile" : L"persistent", kProofListenerName);
+    return 0;
+  }
+
