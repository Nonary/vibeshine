<?xml version="1.0" encoding="utf-8"?>
<!--
  REVIEW COPY of the SignPath portal artifact configuration for slug "msi-file".
  The portal is the source of truth; editing this file does NOT change signing.
  See docs/signpath/README.md.

  Slug:    msi-file
  Used by: .github/workflows/ci-windows.yml (MSI signing request),
           scripts/signpath_sign.ps1 (.msi branch)
  Purpose: deep-sign every FIRST-PARTY PE inside the MSI, then sign the MSI
           container itself. Order matters: nested PEs first, the
           <authenticode-sign/> directly under <msi-file> signs the container LAST.

  STRATEGY 1 (recommended): explicit enumeration of first-party PEs only.
  This NEVER touches the vendor/catalog-bound files (SudoVDA.dll,
  SunshineVirtualDisplayDriver.dll + .cat, VibeshineVhfGamepad.dll + .cat,
  VkLayer_sunshine_hdr.dll, virtualdisplay_probe.exe, nefconc.exe,
  nvngx_truehdr.dll) whose .cat catalog hashes would be invalidated by
  re-signing. It also leaves the VHF root-device setup tool alone: that
  release-signed executable is hash-pinned in the VHF package manifest.

  NOTE: the path= values are the file's logical path inside the MSI (install
  layout). The WiX package installs under the Sunshine directory, so top-level
  app files use the "Sunshine/" prefix. Confirm against a built MSI's File table
  if an entry reports 0 matches.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <msi-file>
    <!-- install root ("Sunshine/") -->
    <pe-file path="Sunshine/sunshine.exe"><authenticode-sign/></pe-file>
    <pe-file path="Sunshine/uninstall.exe"><authenticode-sign/></pe-file>
    <pe-file path="Sunshine/libwebrtc.dll"><authenticode-sign/></pe-file>
    <pe-file path="Sunshine/zlib1.dll"><authenticode-sign/></pe-file>
    <pe-file path="Sunshine/vibeshine_truehdr.dll"><authenticode-sign/></pe-file>

    <!-- Sunshine/tools\ -->
    <pe-file path="Sunshine/tools/sunshinesvc.exe"><authenticode-sign/></pe-file>
    <pe-file path="Sunshine/tools/dxgi-info.exe"><authenticode-sign/></pe-file>
    <pe-file path="Sunshine/tools/audio-info.exe"><authenticode-sign/></pe-file>
    <pe-file path="Sunshine/tools/playnite-launcher.exe"><authenticode-sign/></pe-file>
    <pe-file path="Sunshine/tools/sunshine_wgc_capture.exe"><authenticode-sign/></pe-file>
    <pe-file path="Sunshine/tools/sunshine_display_helper.exe"><authenticode-sign/></pe-file>

    <!--
      DO NOT add the vendor / catalog-bound files below: they are origin-signed
      upstream and re-signing breaks their .cat catalog hashes (driver install
      fails). Keep them out of this configuration:
        drivers/sudovda/SudoVDA.dll
        drivers/sudovda/nefconc.exe
        drivers/sunshine/SunshineVirtualDisplayDriver.dll  (+ .cat)
        drivers/sunshine/virtualdisplay_probe.exe
        drivers/sunshine/nefconc.exe
        drivers/sunshine/vulkan-layer/VkLayer_sunshine_hdr.dll
        drivers/vhf-gamepad/driver/VibeshineVhfGamepad.dll (+ .cat)
        drivers/vhf-gamepad/tools/VibeshineVhfGamepadDeviceSetup.exe
        nvngx_truehdr.dll   (NVIDIA RTX Video SDK runtime)
    -->

    <!-- sign the MSI container LAST -->
    <authenticode-sign/>
  </msi-file>
</artifact-configuration>

<!--
  STRATEGY 2 (alternative): scoped wildcards. Only use after confirming no
  catalog-bound driver DLLs live under the matched roots. Scope includes to
  "Sunshine/" and "Sunshine/tools" so the drivers\ subtree is NOT swept in.
  min-matches/max-matches
  default to 1, so always set them or a wildcard matching any other count fails
  the whole request.

  <artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
    <msi-file>
      <pe-file-set>
        <include path="Sunshine/*.exe"       min-matches="0" max-matches="unbounded"/>
        <include path="Sunshine/*.dll"       min-matches="0" max-matches="unbounded"/>
        <include path="Sunshine/tools/*.exe" min-matches="0" max-matches="unbounded"/>
        <include path="Sunshine/tools/*.dll" min-matches="0" max-matches="unbounded"/>
        <for-each><authenticode-sign/></for-each>
      </pe-file-set>
      <authenticode-sign/>
    </msi-file>
  </artifact-configuration>
-->
