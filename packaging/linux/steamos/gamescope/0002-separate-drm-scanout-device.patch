+static bool open_drm_scanout_device(struct drm_t *drm)
+{
+	dev_t render_dev_id = 0;
+	const bool have_render_device = vulkan_primary_dev_id(&render_dev_id);
+	drm->device_name = nullptr;
+	if (g_sDRMDevice != nullptr)
+	{
+		if (g_sDRMDevice[0] != '/')
+		{
+			drm_log.errorf("--drm-device requires an absolute KMS primary-node path");
+			return false;
+		}
+		drm->device_name = strdup(g_sDRMDevice);
+	}
+	else if (have_render_device)
+	{
+		drmDevice *device = nullptr;
+		if (drmGetDeviceFromDevId(render_dev_id, 0, &device) != 0)
+		{
+			drm_log.errorf("Failed to find the Vulkan renderer's DRM device");
+			return false;
+		}
+		if (device->available_nodes & (1 << DRM_NODE_PRIMARY))
+			drm->device_name = strdup(device->nodes[DRM_NODE_PRIMARY]);
+		drmFreeDevice(&device);
+		if (!drm->device_name)
+			return false;
+	}
+	if (g_sDRMDevice && !drm->device_name)
+		return false;
+
+	// Keep logind/libseat ownership and its hotplug notifications. An explicit
+	// device must never fall back to another card on failure.
+	drm->fd = wlsession_open_kms(drm->device_name);
+	if (drm->fd < 0)
+	{
+		drm_log.errorf("Could not open requested KMS device '%s'", drm->device_name ? drm->device_name : "auto");
+		free(drm->device_name);
+		drm->device_name = nullptr;
+		return false;
+	}
+	if (drmGetNodeTypeFromFd(drm->fd) != DRM_NODE_PRIMARY || !drmIsKMS(drm->fd))
+	{
+		drm_log.errorf("Selected scanout device is not a KMS primary node");
+		wlsession_close_kms();
+		drm->fd = -1;
+		free(drm->device_name);
+		drm->device_name = nullptr;
+		return false;
+	}
+	struct stat attributes {};
+	if (fstat(drm->fd, &attributes) != 0)
+	{
+		wlsession_close_kms();
+		drm->fd = -1;
+		free(drm->device_name);
+		drm->device_name = nullptr;
+		return false;
+	}
+	drm->bSeparateScanoutDevice = !have_render_device || attributes.st_rdev != render_dev_id;
+	drm_log.infof("KMS scanout '%s': %s Vulkan render device",
+		drm->device_name ? drm->device_name : "auto",
+		drm->bSeparateScanoutDevice ? "separate from" : "same as");
+	return true;
+}
