# shellcheck shell=bash

do_setcap() {
  setcap cap_sys_admin,cap_sys_nice+p "$(readlink -f usr/bin/vibeshine)"
}

do_udev_reload() {
  udevadm control --reload-rules
  udevadm trigger --property-match=DEVNAME=/dev/uinput
  udevadm trigger --property-match=DEVNAME=/dev/uhid
  modprobe uinput || true
  modprobe uhid || true
}

do_install_vibeshine_drm() {
  if /usr/libexec/vibeshine/vibeshine-drm-install install-package; then
    return 0
  else
    local install_rc=$?
  fi
  case $install_rc in
    4)
      echo "warning: Vibeshine DRM was updated, but the loaded module is stale; reboot before using managed virtual displays."
      ;;
    5)
      echo "Vibeshine DRM authorization is queued. Reboot and approve the pending MOK confirmations once."
      ;;
    *)
      echo "warning: Vibeshine DRM installation failed; managed virtual displays are unavailable."
      ;;
  esac
}

do_install_prelogin() {
  local helper=/usr/libexec/vibeshine/vibeshine-prelogin-sync
  [[ -x "$helper" ]] || return 0
  if "$helper" configure-auto; then
    if ! "$helper" install-pam; then
      echo 'warning: could not install the Plasma Login Manager handoff hook.'
      return 0
    fi
    systemctl daemon-reload
    systemctl enable vibeshine-prelogin.service ||
      echo 'warning: could not enable Vibeshine pre-login streaming.'
  else
    echo 'warning: Vibeshine pre-login streaming needs an explicit paired-client allowlist.'
    echo "         Run: sudo $helper configure USER CLIENT_UUID"
  fi
}

post_install() {
  do_setcap
  do_udev_reload
  modprobe uhid
  do_install_vibeshine_drm
  do_install_prelogin
}

post_upgrade() {
  do_setcap
  do_udev_reload
  modprobe uhid
  do_install_vibeshine_drm
  do_install_prelogin
}

pre_remove() {
  systemctl disable --now vibeshine-prelogin.service 2>/dev/null || true
  /usr/libexec/vibeshine/vibeshine-prelogin-sync remove-pam 2>/dev/null || true
  systemctl stop vibeshine-vkms.service 2>/dev/null || true
  /usr/libexec/vibeshine/vibeshine-drm-install remove || \
    echo "warning: could not remove the Vibeshine HDR DRM module cleanly."
}
