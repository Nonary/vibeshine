+  /**
+   * @brief Record that the controller created the proof-owned account.
+   *
+   * @return True when the ownership marker was written.
+   */
+  bool
+    WriteProofUserMarker() {
+    HKEY key = nullptr;
+    const LSTATUS status = RegCreateKeyExW(
+      HKEY_LOCAL_MACHINE,
+      kProofStateRegistryPath,
+      0,
+      nullptr,
+      0,
+      KEY_WRITE,
+      nullptr,
+      &key,
+      nullptr
+    );
+    if (status != ERROR_SUCCESS) {
+      return false;
+    }
+    const bool success =
+      SetDword(key, L"ProofUserCreated", 1) == ERROR_SUCCESS &&
+      SetString(key, L"ProofUserName", kProofUserName) == ERROR_SUCCESS;
+    RegCloseKey(key);
+    return success;
+  }
+
+  /**
+   * @brief Verify the proof account ownership marker.
+   *
+   * @return True only for the exact proof-owned account.
+   */
+  bool
+    HasProofUserMarker() {
+    HKEY key = nullptr;
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, kProofStateRegistryPath, 0, KEY_QUERY_VALUE, &key) != ERROR_SUCCESS) {
+      return false;
+    }
+    DWORD marker = 0;
+    wchar_t name[UNLEN + 1] = {};
+    DWORD type = 0;
+    DWORD bytes = sizeof(name);
+    const bool valid =
+      QueryDword(key, L"ProofUserCreated", &marker) && marker == 1 &&
+      RegQueryValueExW(key, L"ProofUserName", nullptr, &type, reinterpret_cast<BYTE *>(name), &bytes) == ERROR_SUCCESS &&
+      type == REG_SZ && _wcsicmp(name, kProofUserName) == 0;
+    RegCloseKey(key);
+    return valid;
+  }
+
+  /**
+   * @brief Create a random password which is never printed or logged.
+   *
+   * @param password Receives the password.
+   * @return True when the system RNG succeeded.
+   */
+  bool
+    GenerateProofPassword(std::wstring *password) {
+    constexpr wchar_t alphabet[] = L"ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@#$%_-";
+    BYTE random[28] = {};
+    if (BCryptGenRandom(nullptr, random, sizeof(random), BCRYPT_USE_SYSTEM_PREFERRED_RNG) != 0) {
+      return false;
+    }
+    *password = L"Aa1!";
+    for (BYTE value : random) {
+      password->push_back(alphabet[value % (ARRAYSIZE(alphabet) - 1)]);
+    }
+    return true;
+  }
+
+  /**
+   * @brief Write the one-use proof credential with a restricted ACL.
+   *
+   * @param password Random proof account password.
+   * @return True when the file was written.
+   */
+  bool
+    WriteProofCredential(const std::wstring &password) {
+    const std::wstring path = GetProofCredentialPath();
+    if (path.empty()) {
+      return false;
+    }
+
+    PSECURITY_DESCRIPTOR descriptor = nullptr;
+    if (!ConvertStringSecurityDescriptorToSecurityDescriptorW(
+          L"D:P(A;;FA;;;SY)(A;;FA;;;BA)(A;;FRSD;;;NS)",
+          SDDL_REVISION_1,
+          &descriptor,
+          nullptr
+        )) {
+      return false;
+    }
+    SECURITY_ATTRIBUTES attributes = {sizeof(attributes), descriptor, FALSE};
+    const HANDLE file = CreateFileW(
+      path.c_str(),
+      GENERIC_WRITE,
+      0,
+      &attributes,
+      CREATE_NEW,
+      FILE_ATTRIBUTE_TEMPORARY,
+      nullptr
+    );
+    LocalFree(descriptor);
+    if (file == INVALID_HANDLE_VALUE) {
+      return false;
+    }
+
+    wchar_t computer[MAX_COMPUTERNAME_LENGTH + 1] = {};
+    DWORD computer_count = ARRAYSIZE(computer);
+    bool success = GetComputerNameW(computer, &computer_count) != FALSE;
+    wchar_t text[1024] = {};
+    if (success) {
+      success = SUCCEEDED(StringCchPrintfW(
+        text,
+        ARRAYSIZE(text),
+        L"%s\r\n%s\r\n%s\r\n",
+        computer,
+        kProofUserName,
+        password.c_str()
+      ));
+    }
+    char utf8[4096] = {};
+    int count = 0;
+    if (success) {
+      count = WideCharToMultiByte(CP_UTF8, 0, text, -1, utf8, ARRAYSIZE(utf8), nullptr, nullptr);
+      success = count > 1;
+    }
+    if (success) {
+      DWORD written = 0;
+      success = WriteFile(file, utf8, static_cast<DWORD>(count - 1), &written, nullptr) != FALSE &&
+                written == static_cast<DWORD>(count - 1) && FlushFileBuffers(file) != FALSE;
+    }
+    CloseHandle(file);
+    if (!success) {
+      DeleteFileW(path.c_str());
+    }
+    SecureZeroMemory(text, sizeof(text));
+    SecureZeroMemory(utf8, sizeof(utf8));
+    return success;
+  }
+
+  /**
+   * @brief Resolve the localized built-in Remote Desktop Users alias name.
+   *
+   * @param name Receives the local alias name.
+   * @return True when the well-known SID resolves to a local alias.
+   */
+  bool
+    GetRemoteDesktopUsersGroupName(std::wstring *name) {
+    BYTE sid[SECURITY_MAX_SID_SIZE] = {};
+    DWORD sid_size = sizeof(sid);
+    if (!CreateWellKnownSid(WinBuiltinRemoteDesktopUsersSid, nullptr, sid, &sid_size)) {
+      return false;
+    }
+
+    wchar_t group[256] = {};
+    wchar_t domain[256] = {};
+    DWORD group_count = ARRAYSIZE(group);
+    DWORD domain_count = ARRAYSIZE(domain);
+    SID_NAME_USE use = SidTypeUnknown;
+    if (!LookupAccountSidW(
+          nullptr,
+          sid,
+          group,
+          &group_count,
+          domain,
+          &domain_count,
+          &use
+        ) || use != SidTypeAlias) {
+      return false;
+    }
+    *name = group;
+    return !name->empty();
+  }
+
+  /**
+   * @brief Grant the disposable account remote-interactive logon through its built-in alias.
+   *
+   * Deleting the local account during rollback also removes this alias membership.
+   *
+   * @return True only when the exact proof account was added successfully.
+   */
+  bool
+    AddProofUserToRemoteDesktopUsers() {
+    std::wstring group;
+    if (!GetRemoteDesktopUsersGroupName(&group)) {
+      return false;
+    }
+    LOCALGROUP_MEMBERS_INFO_3 member = {};
+    member.lgrmi3_domainandname = const_cast<wchar_t *>(kProofUserName);
+    return NetLocalGroupAddMembers(
+             nullptr,
+             group.c_str(),
+             3,
+             reinterpret_cast<LPBYTE>(&member),
+             1
+           ) == NERR_Success;
+  }
+
+  /**
+   * @brief Create the disposable session-owner account and one-use credential.
+   *
+   * @return Zero on success.
+   */
+  int
+    CreateProofUser() {
+    if (ProofUserExists() || HasProofUserMarker() || !IsProofCredentialAbsent()) {
+      return Fail(L"proof user state already exists", ERROR_ALREADY_EXISTS);
+    }
+
+    std::wstring password;
+    if (!GenerateProofPassword(&password)) {
+      return Fail(L"generate proof password", ERROR_GEN_FAILURE);
+    }
+
+    USER_INFO_1 user = {};
+    user.usri1_name = const_cast<wchar_t *>(kProofUserName);
+    user.usri1_password = password.data();
+    user.usri1_priv = USER_PRIV_USER;
+    user.usri1_comment = const_cast<wchar_t *>(kProofUserComment);
+    user.usri1_flags = UF_SCRIPT | UF_NORMAL_ACCOUNT | UF_DONT_EXPIRE_PASSWD;
+    DWORD parameter_error = 0;
+    const NET_API_STATUS add_status = NetUserAdd(nullptr, 1, reinterpret_cast<LPBYTE>(&user), &parameter_error);
+    if (add_status != NERR_Success) {
+      SecureZeroMemory(password.data(), password.size() * sizeof(wchar_t));
+      return Fail(L"create proof user", add_status);
+    }
+
+    const bool complete =
+      AddProofUserToRemoteDesktopUsers() &&
+      WriteProofCredential(password) &&
+      WriteProofUserMarker();
+    SecureZeroMemory(password.data(), password.size() * sizeof(wchar_t));
+    if (!complete) {
+      DeleteProofCredential();
+      RegDeleteTreeW(HKEY_LOCAL_MACHINE, kProofStateRegistryPath);
+      NetUserDel(nullptr, kProofUserName);
+      return Fail(L"finish proof user state", ERROR_WRITE_FAULT);
+    }
+
+    Log(L"created disposable proof session owner and one-use credential");
+    wprintf(L"created proof session owner %s; password was not displayed\n", kProofUserName);
+    return 0;
+  }
+
+  /**
+   * @brief Log off sessions belonging to the exact proof account.
+   */
+  void
+    LogoffProofUserSessions() {
+    PWTS_SESSION_INFOW sessions = nullptr;
+    DWORD count = 0;
+    if (!WTSEnumerateSessionsW(WTS_CURRENT_SERVER_HANDLE, 0, 1, &sessions, &count)) {
+      return;
+    }
+    for (DWORD index = 0; index < count; ++index) {
+      wchar_t *user = nullptr;
+      DWORD bytes = 0;
+      if (WTSQuerySessionInformationW(
+            WTS_CURRENT_SERVER_HANDLE,
+            sessions[index].SessionId,
+            WTSUserName,
+            &user,
+            &bytes
+          )) {
+        if (user && _wcsicmp(user, kProofUserName) == 0) {
+          WTSLogoffSession(WTS_CURRENT_SERVER_HANDLE, sessions[index].SessionId, FALSE);
+        }
+        WTSFreeMemory(user);
+      }
+    }
+    WTSFreeMemory(sessions);
+  }
+
+  /**
+   * @brief Enumerate sessions owned by the isolated proof listener or account.
+   *
+   * The listener name is available before Winlogon has populated the user name,
+   * which is essential during the narrow GetHardwareId-to-OnDriverLoad window.
+   *
+   * @return Matching session identifiers.
+   */
+  std::vector<DWORD>
+    EnumerateProofSessions() {
+    std::vector<DWORD> result;
+    PWTS_SESSION_INFOW sessions = nullptr;
+    DWORD count = 0;
+    if (!WTSEnumerateSessionsW(WTS_CURRENT_SERVER_HANDLE, 0, 1, &sessions, &count)) {
+      return result;
+    }
+
+    for (DWORD index = 0; index < count; ++index) {
+      // WTSEnumerateSessions also exposes the listener endpoint itself as a
+      // synthetic session (for example, ID 65537 in WTSListen). It is not a
+      // connected seat and cannot be logged off; treating it as one makes the
+      // quiescence barrier wait forever while the listener is intentionally
+      // still enabled. Keep every construction/logon/connected state visible,
+      // but exclude the listener-only row.
+      if (sessions[index].State == WTSListen) {
+        continue;
+      }
+      bool match = sessions[index].pWinStationName &&
+                   _wcsicmp(sessions[index].pWinStationName, kProofListenerName) == 0;
+      if (!match) {
+        wchar_t *user = nullptr;
+        DWORD bytes = 0;
+        if (WTSQuerySessionInformationW(
+              WTS_CURRENT_SERVER_HANDLE,
+              sessions[index].SessionId,
+              WTSUserName,
+              &user,
+              &bytes
+            )) {
+          match = user && _wcsicmp(user, kProofUserName) == 0;
+          WTSFreeMemory(user);
+        }
+      }
+      if (match) {
+        result.push_back(sessions[index].SessionId);
+      }
+    }
+    WTSFreeMemory(sessions);
+    return result;
+  }
+
+  /**
+   * @brief Test whether the remote IDD devnode for a session is still present.
+   *
+   * @param session_id RDS session identifier.
+   * @return True while Plug and Play still exposes the live remote display PDO.
+   */
+  bool
+    IsProofRemoteDisplayPresent(DWORD session_id) {
+    wchar_t instance_id[256] = {};
+    if (FAILED(StringCchPrintfW(
+          instance_id,
+          ARRAYSIZE(instance_id),
+          L"SWD\\RemoteDisplayEnum\\SUNSHINE_REMOTE_IDDCX&SessionId_%04lu",
+          session_id
+        ))) {
+      return true;
+    }
+    DEVINST device = 0;
+    return CM_Locate_DevNodeW(&device, instance_id, CM_LOCATE_DEVNODE_NORMAL) == CR_SUCCESS;
+  }
+
+  /**
+   * @brief Drain the proof seat before mutating its live listener registration.
+   *
+   * A rollback can race the one-second synthetic connection worker. Disabling
+   * the listener in the GetHardwareId-to-OnDriverLoad interval asks Termsrv to
+   * remove a remote-display device that it is still constructing. The inbox
+   * service crashed in CRemoteTerminal::OnRemoteDisplayDeviceRemoval under that
+   * exact ordering. This routine first removes the one-use credential, observes
+   * the in-flight seat, lets driver initialization settle, logs it off, waits
+   * for both WTS and Plug and Play removal, and only then permits listener
+   * mutation.
+   *
+   * @param activation_was_armed Whether a volatile activation marker existed.
+   * @return True only after no proof session or live remote display remains.
+   */
+  bool
+    QuiesceProofSeat(bool activation_was_armed) {
+    DeleteProofCredential();
+
+    std::vector<DWORD> observed_sessions;
+    ULONGLONG first_seen = 0;
+    const ULONGLONG arrival_deadline = GetTickCount64() + (activation_was_armed ? kProofArrivalGraceMs : 0);
+    bool logoff_requested = false;
+
+    for (;;) {
+      const std::vector<DWORD> current = EnumerateProofSessions();
+      if (!current.empty()) {
+        if (!first_seen) {
+          first_seen = GetTickCount64();
+          observed_sessions = current;
+          wchar_t message[256] = {};
+          StringCchPrintfW(
+            message,
+            ARRAYSIZE(message),
+            L"rollback observed proof session=%lu; waiting for remote display initialization to settle",
+            current.front()
+          );
+          Log(message);
+        } else {
+          for (DWORD session_id : current) {
+            if (std::find(observed_sessions.begin(), observed_sessions.end(), session_id) == observed_sessions.end()) {
+              observed_sessions.push_back(session_id);
+            }
+          }
+        }
+
+        if (!logoff_requested && GetTickCount64() - first_seen >= kProofSessionSettleMs) {
+          for (DWORD session_id : current) {
+            WTSLogoffSession(WTS_CURRENT_SERVER_HANDLE, session_id, FALSE);
+          }
+          logoff_requested = true;
+          Log(L"rollback requested proof-session logoff after initialization grace");
+        }
+
+        if (first_seen && GetTickCount64() - first_seen > kProofSessionSettleMs + kProofLogoffWaitMs) {
+          Log(L"rollback quiesce timed out waiting for proof session removal; listener left unchanged");
+          return false;
+        }
+      } else if (first_seen || GetTickCount64() >= arrival_deadline) {
+        break;
+      }
+      Sleep(250);
+    }
+
+    const ULONGLONG device_deadline = GetTickCount64() + kProofDeviceRemovalWaitMs;
+    for (;;) {
+      bool any_present = false;
+      for (DWORD session_id : observed_sessions) {
+        any_present = any_present || IsProofRemoteDisplayPresent(session_id);
+      }
+      if (!any_present) {
+        break;
+      }
+      if (GetTickCount64() >= device_deadline) {
+        Log(L"rollback quiesce timed out waiting for remote display PDO removal; listener left unchanged");
+        return false;
+      }
+      Sleep(250);
+    }
+
+    Sleep(kProofRemovalSettleMs);
+    Log(L"rollback quiesce complete; proof session and remote display are absent");
+    return true;
+  }
+
+  /**
+   * @brief Delete the proof account only when its ownership marker and comment agree.
+   *
+   * @return True when no proof-owned account remains.
+   */
+  bool
+    DeleteProofUser() {
+    if (!HasProofUserMarker()) {
+      return !ProofUserExists();
+    }
+
+    LPBYTE buffer = nullptr;
+    const NET_API_STATUS query_status = NetUserGetInfo(nullptr, kProofUserName, 1, &buffer);
+    if (query_status == NERR_UserNotFound) {
+      RegDeleteTreeW(HKEY_LOCAL_MACHINE, kProofStateRegistryPath);
+      return true;
+    }
+    if (query_status != NERR_Success || !buffer) {
+      return false;
+    }
+    auto *user = reinterpret_cast<USER_INFO_1 *>(buffer);
+    const bool owned = user->usri1_comment && _wcsicmp(user->usri1_comment, kProofUserComment) == 0;
+    NetApiBufferFree(buffer);
+    if (!owned) {
+      return false;
+    }
+
+    LogoffProofUserSessions();
+    const NET_API_STATUS delete_status = NetUserDel(nullptr, kProofUserName);
+    if (delete_status != NERR_Success && delete_status != NERR_UserNotFound) {
+      return false;
+    }
+    RegDeleteTreeW(HKEY_LOCAL_MACHINE, kProofStateRegistryPath);
+    return true;
+  }
+
+  /**
+   * @brief Test whether the safe COM provider still points at the expected DLL.
+   *
+   * @return True when unchanged.
+   */
+  bool
+    IsSafeProviderUnchanged() {
+    std::wstring value;
+    return QueryString(HKEY_LOCAL_MACHINE, kSafeProviderRegistryPath, nullptr, &value) &&
+           NormalizePath(value) == NormalizePath(kExpectedSafeProviderPath);
