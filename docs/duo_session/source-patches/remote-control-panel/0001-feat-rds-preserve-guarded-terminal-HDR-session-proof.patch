+BOOL WINAPI DllMain(HINSTANCE module, DWORD reason, void *) {
+  if (reason == DLL_PROCESS_ATTACH) {
+    g_module = module;
+    DisableThreadLibraryCalls(module);
+  }
+  return TRUE;
+}
+
+extern "C" HRESULT __stdcall DllCanUnloadNow() {
+  return g_object_count.load() == 0 && g_lock_count.load() == 0 ? S_OK : S_FALSE;
+}
+
+extern "C" HRESULT __stdcall DllGetClassObject(REFCLSID class_id, REFIID iid, void **object) {
+  if (!IsEqualCLSID(class_id, kProxyProtocolManagerClsid)) {
+    return CLASS_E_CLASSNOTAVAILABLE;
+  }
+  auto *factory = new (std::nothrow) ClassFactory();
+  if (!factory) {
+    return E_OUTOFMEMORY;
+  }
+  const HRESULT hr = factory->QueryInterface(iid, object);
+  factory->Release();
+  return hr;
+}
