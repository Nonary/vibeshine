+param(
+  [Parameter(Mandatory = $true)]
+  [string]$OutputDirectory,
+
+  [string]$AlternateShell = "",
+
+  [string]$ShellDirectory = "",
+
+  [string]$RemoteAppProgram = "",
+
+  [string]$RemoteAppCommand = "",
+
+  [string]$RemoteAppWorkDirectory = "",
+
+  [string]$Server = "127.0.0.2"
+)
+
+$ErrorActionPreference = "Stop"
+$credentialPath = "C:\ProgramData\Sunshine\RdpProtocolProvider\probe-credential-Sunshine-HdrProof.txt"
+$freeRdp = "D:\Software\MSYS2\ucrt64\bin\wfreerdp.exe"
+
+try {
+  $lines = [IO.File]::ReadAllLines($credentialPath)
+  if ($lines.Count -lt 3) {
+    throw "The isolated proof credential is malformed."
+  }
+
+  $password = $lines[2]
+  $env:PATH = "D:\Software\MSYS2\ucrt64\bin;$env:PATH"
+  $ErrorActionPreference = "Continue"
+  $arguments = @(
+    "/v:$Server",
+    "/u:.\VibeSeatTest",
+    ("/p:{0}" -f $password),
+    "/cert:ignore",
+    "/w:1280",
+    "/h:720",
+    "/audio-mode:2",
+    "-clipboard"
+  )
+  if (-not [string]::IsNullOrWhiteSpace($AlternateShell)) {
+    $arguments += "/shell:$AlternateShell"
+  }
+  if (-not [string]::IsNullOrWhiteSpace($ShellDirectory)) {
+    $arguments += "/shell-dir:$ShellDirectory"
+  }
+  if (-not [string]::IsNullOrWhiteSpace($RemoteAppProgram)) {
+    $remoteApp = "/app:program:$RemoteAppProgram"
+    if (-not [string]::IsNullOrWhiteSpace($RemoteAppCommand)) {
+      $remoteApp += ",cmd:$RemoteAppCommand"
+    }
+    if (-not [string]::IsNullOrWhiteSpace($RemoteAppWorkDirectory)) {
+      $remoteApp += ",workdir:$RemoteAppWorkDirectory"
+    }
+    $arguments += $remoteApp
+  }
+  & $freeRdp @arguments `
+    1>> (Join-Path $OutputDirectory "wfreerdp.stdout.log") `
+    2>> (Join-Path $OutputDirectory "wfreerdp.stderr.log")
+  exit $LASTEXITCODE
+} catch {
+  ($_ | Out-String) | Set-Content (Join-Path $OutputDirectory "launcher-error.txt")
+  exit 2
+} finally {
+  if ($password) {
+    $password = $null
+  }
+  if ($lines) {
+    $lines = $null
+  }
+}
diff --git a/source/tools/rdp-protocol-provider/profile_account_guard.ps1 b/source/tools/rdp-protocol-provider/profile_account_guard.ps1
new file mode 100644
index 00000000..d01b7d26
--- /dev/null
+++ b/source/tools/rdp-protocol-provider/profile_account_guard.ps1
@@ -0,0 +1,194 @@
+param(
+  [Parameter(Mandatory = $true)]
+  [ValidateSet("Arm", "EnableCredential", "Restore", "Status")]
+  [string]$Mode,
+
+  [ValidateRange(120, 900)]
+  [int]$DelaySeconds = 300
+)
+
+$ErrorActionPreference = "Stop"
+$TaskName = "Sunshine-RdsProfileAccount-Rollback"
+$ProofRoot = Join-Path $env:ProgramData "Sunshine\RdpHdrProof"
+$StagedScript = Join-Path $ProofRoot "profile_account_guard.ps1"
+$StatePath = Join-Path $ProofRoot "profile-account-state.json"
+$LogPath = Join-Path $ProofRoot "profile-account-guard.log"
+$CredentialPath = Join-Path $env:ProgramData "Sunshine\RdpProtocolProvider\probe-credential-Sunshine-HdrProof.txt"
+$AccountName = "VibeSeatTest"
+$ExpectedSid = "S-1-5-21-1478496017-2670801028-3107567635-1006"
+$ExpectedDescription = "Disposable Vibeshine session test"
+
+function Write-GuardLog([string]$Message) {
+  New-Item -ItemType Directory -Path $ProofRoot -Force | Out-Null
+  $line = "{0:o} {1}" -f (Get-Date), $Message
+  Add-Content -LiteralPath $LogPath -Value $line -Encoding UTF8
+  Write-Host $line
+}
+
+function Assert-Administrator {
+  $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
+  $principal = [Security.Principal.WindowsPrincipal]::new($identity)
+  if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
+    throw "The profile-account proof guard requires an elevated administrator process."
+  }
+}
+
+function Get-ExactProofAccount {
+  $account = Get-LocalUser -Name $AccountName -ErrorAction Stop
+  if ($account.Sid.Value -ne $ExpectedSid -or $account.Description -ne $ExpectedDescription) {
+    throw "The retained profile account does not match the exact proof identity."
+  }
+  return $account
+}
+
+function Remove-DeadlineTask {
+  $task = Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue
+  if ($task) {
+    Unregister-ScheduledTask -TaskName $TaskName -Confirm:$false
+  }
+}
+
+function Get-ArmedDeadline {
+  $task = Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue
+  $info = if ($task) { Get-ScheduledTaskInfo -TaskName $TaskName } else { $null }
+  if (-not $task -or $task.Principal.UserId -ne "SYSTEM" -or -not $info) {
+    throw "The SYSTEM profile-account rollback task is not armed."
+  }
+  return $info.NextRunTime
+}
+
+function Set-CredentialAcl {
+  $acl = [System.Security.AccessControl.FileSecurity]::new()
+  $acl.SetAccessRuleProtection($true, $false)
+  $inheritance = [System.Security.AccessControl.InheritanceFlags]::None
+  $propagation = [System.Security.AccessControl.PropagationFlags]::None
+  $allow = [System.Security.AccessControl.AccessControlType]::Allow
+  foreach ($identity in @("NT AUTHORITY\SYSTEM", "BUILTIN\Administrators", "NT AUTHORITY\NETWORK SERVICE")) {
+    $rights = if ($identity -eq "NT AUTHORITY\NETWORK SERVICE") { "Read" } else { "FullControl" }
+    $rule = [System.Security.AccessControl.FileSystemAccessRule]::new(
+      $identity,
+      $rights,
+      $inheritance,
+      $propagation,
+      $allow
+    )
+    $acl.AddAccessRule($rule)
+  }
+  Set-Acl -LiteralPath $CredentialPath -AclObject $acl
+}
+
+function Restore-AccountState {
+  $account = Get-ExactProofAccount
+  $state = if (Test-Path -LiteralPath $StatePath -PathType Leaf) {
+    Get-Content -LiteralPath $StatePath -Raw | ConvertFrom-Json
+  } else {
+    $null
+  }
+
+  Remove-Item -LiteralPath $CredentialPath -Force -ErrorAction SilentlyContinue
+  if ($state -and -not [bool]$state.WasEnabled -and $account.Enabled) {
+    Disable-LocalUser -Name $AccountName
+  }
+  if ($state -and [bool]$state.WasEnabled -and -not $account.Enabled) {
+    Enable-LocalUser -Name $AccountName
+  }
+
+  $restored = Get-ExactProofAccount
+  if ($state -and $restored.Enabled -ne [bool]$state.WasEnabled) {
+    throw "The profile-account enabled state did not restore."
+  }
+
+  Remove-DeadlineTask
+  Remove-Item -LiteralPath $StatePath -Force -ErrorAction SilentlyContinue
+  Write-GuardLog "restore complete; account_enabled=$($restored.Enabled); profile and account retained"
+}
+
+Assert-Administrator
+
+switch ($Mode) {
+  "Arm" {
+    $account = Get-ExactProofAccount
+    New-Item -ItemType Directory -Path $ProofRoot -Force | Out-Null
+    Copy-Item -LiteralPath $PSCommandPath -Destination $StagedScript -Force
+    @{
+      AccountName = $AccountName
+      AccountSid = $ExpectedSid
+      WasEnabled = [bool]$account.Enabled
+      ArmedAt = (Get-Date).ToString("o")
+    } | ConvertTo-Json | Set-Content -LiteralPath $StatePath -Encoding UTF8
+
+    Remove-DeadlineTask
+    $action = New-ScheduledTaskAction -Execute "powershell.exe" -Argument (
+      '-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "{0}" -Mode Restore' -f $StagedScript
+    )
+    $trigger = New-ScheduledTaskTrigger -Once -At (Get-Date).AddSeconds($DelaySeconds)
+    $principal = New-ScheduledTaskPrincipal -UserId "SYSTEM" -LogonType ServiceAccount -RunLevel Highest
+    Register-ScheduledTask -TaskName $TaskName -Action $action -Trigger $trigger -Principal $principal -Force | Out-Null
+    Write-GuardLog "armed SYSTEM account rollback; account_enabled=$($account.Enabled); password unchanged"
+  }
+
+  "EnableCredential" {
+    $deadline = Get-ArmedDeadline
+    if ($deadline -le (Get-Date).AddSeconds(60)) {
+      throw "At least sixty seconds must remain on the account rollback deadline."
+    }
+    $account = Get-ExactProofAccount
+    if (-not (Test-Path -LiteralPath $StatePath -PathType Leaf)) {
+      throw "The profile-account baseline state is missing."
+    }
+
+    $alphabet = "abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789"
+    $random = [Security.Cryptography.RandomNumberGenerator]::Create()
+    $bytes = [byte[]]::new(32)
+    try {
+      $random.GetBytes($bytes)
+      $characters = for ($index = 0; $index -lt $bytes.Length; $index++) {
+        $alphabet[$bytes[$index] % $alphabet.Length]
+      }
+      $password = -join $characters
+      $securePassword = ConvertTo-SecureString $password -AsPlainText -Force
+      Set-LocalUser -Name $AccountName -Password $securePassword -AccountNeverExpires -PasswordNeverExpires $true
+      Enable-LocalUser -Name $AccountName
+
+      $credentialDirectory = Split-Path -Parent $CredentialPath
+      New-Item -ItemType Directory -Path $credentialDirectory -Force | Out-Null
+      $utf8 = [Text.UTF8Encoding]::new($false)
+      [IO.File]::WriteAllText($CredentialPath, ".`r`n$AccountName`r`n$password`r`n", $utf8)
+      Set-CredentialAcl
+    } finally {
+      if ($bytes) {
+        [Array]::Clear($bytes, 0, $bytes.Length)
+      }
+      $securePassword = $null
+      $password = $null
+      if ($random) {
+        $random.Dispose()
+      }
+    }
+
+    $enabled = (Get-ExactProofAccount).Enabled
+    if (-not $enabled -or -not (Test-Path -LiteralPath $CredentialPath -PathType Leaf)) {
+      throw "The retained profile account or isolated credential did not activate."
+    }
+    Write-GuardLog "enabled exact retained profile account and replaced only the isolated proof credential; deadline=$($deadline.ToString('o'))"
+  }
+
+  "Restore" {
+    Restore-AccountState
+  }
+
+  "Status" {
+    $account = Get-ExactProofAccount
+    $task = Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue
+    $info = if ($task) { Get-ScheduledTaskInfo -TaskName $TaskName } else { $null }
+    [pscustomobject]@{
+      AccountName = $account.Name
+      AccountSid = $account.Sid.Value
+      AccountEnabled = $account.Enabled
+      CredentialPresent = Test-Path -LiteralPath $CredentialPath -PathType Leaf
+      StatePresent = Test-Path -LiteralPath $StatePath -PathType Leaf
+      RollbackTaskPresent = $null -ne $task
+      RollbackNextRunTime = if ($info) { $info.NextRunTime } else { $null }
+    }
+  }
+}
