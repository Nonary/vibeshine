[Unit]
Description=Vibeshine session execution broker socket
Documentation=https://github.com/Nonary/vibeshine
# This socket starts with the desktop controller, after basic.target. The
# default Before=sockets.target would close a cycle through basic.target and
# logind. Retain the other socket defaults explicitly.
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target
Conflicts=shutdown.target
Before=shutdown.target
After=vibeshine-session-controller.service
# Keep admission alive until the GPU host has drained every already-accepted
# compositor request during machine shutdown. Controller cleanup stops this
# socket explicitly before requesting the host stop on manual transitions.
Before=vibeshine.service

[Socket]
ListenSequentialPacket=/run/vibeshine/session-broker.sock
SocketMode=0660
SocketUser=root
SocketGroup=vibeshine
DirectoryMode=0755
Accept=yes
RemoveOnStop=yes
Backlog=16
MaxConnections=32
MaxConnectionsPerSource=16
