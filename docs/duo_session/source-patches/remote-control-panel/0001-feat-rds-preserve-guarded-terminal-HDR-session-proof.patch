+function Write-GuardLog([string]$Message) {
+  $line = "{0:o} {1}" -f (Get-Date), $Message
+  New-Item -ItemType Directory -Path $ProofRoot -Force | Out-Null
+  Add-Content -LiteralPath $LogPath -Value $line -Encoding UTF8
