<?xml version="1.0" encoding="UTF-8"?>
<CPackWiXPatch>
  <CPackWiXFragment Id="#PRODUCT">
    <Property Id="ALLUSERS" Value="1"/>
    <Property Id="ARPSYSTEMCOMPONENT" Value="1"/>
    <Property Id="LEGACY_SUNSHINE_PRESENT" Secure="yes">
      <RegistrySearch Id="SearchLegacySunshine64" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Sunshine" Name="DisplayName" Type="raw" Win64="yes"/>
      <RegistrySearch Id="SearchLegacySunshine32" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Sunshine" Name="DisplayName" Type="raw"/>
    </Property>
    <Property Id="LEGACY_SUNSHINE_UNINSTALL" Secure="yes">
      <RegistrySearch Id="SearchLegacySunshineUninstall64" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Sunshine" Name="UninstallString" Type="raw" Win64="yes"/>
      <RegistrySearch Id="SearchLegacySunshineUninstall32" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Sunshine" Name="UninstallString" Type="raw"/>
    </Property>
    <Property Id="REMOVEVIRTUALDISPLAYDRIVER" Value="0" Secure="yes"/>
    <Property Id="FACTORYRESET" Value="0" Secure="yes"/>
    <Property Id="INSTALL_SUDOVDA" Value="1" Secure="yes"/>
    <Property Id="INSTALL_VIRTUAL_DISPLAY_DRIVER" Secure="yes"/>
    <!-- The build must contain the vetted payload before this property can
         select it.  The default-off value keeps ordinary install/upgrade
         packages completely inert with respect to TermService. -->
    <Property Id="INSTALL_TERMINAL_ISOLATION" Value="0" Secure="yes"/>
    <Property Id="VIBESHINE_TERMINAL_REBOOT" Value="0" Secure="yes"/>
    <Property Id="SKIP_REMOVE_CONFLICTING_PRODUCTS" Value="0" Secure="yes"/>
    <Condition Message="Administrator privileges are required.">Privileged</Condition>
    <Feature Id="VibeshineExtras" Title="Vibeshine Components" Level="1" Absent="disallow">
      <ComponentRef Id="CtlStopSunshine"/>
      <ComponentRef Id="SunshineSvc"/>
      <ComponentRef Id="VibeshineSeatController"/>
      <ComponentRef Id="Env_Path"/>
      <ComponentRef Id="Fw_Exceptions"/>
      <ComponentRef Id="StartMenuShortcut"/>
      <ComponentRef Id="SudoVdaRegistryDefaults"/>
      <ComponentRef Id="ArpCustomUninstallEntry"/>
<?if $(var.TerminalIsolationEnabled) = "1" ?>
      <ComponentRef Id="TerminalIsolationPayload"/>
<?endif?>
    </Feature>

    <InstallExecuteSequence>
      <!-- Remove conflicting products before installation starts. -->
      <Custom Action="RemoveConflictingProducts" Before="InstallValidate">NOT Installed AND NOT REMOVE AND SKIP_REMOVE_CONFLICTING_PRODUCTS &lt;&gt; "1"</Custom>

      <!-- Pre-validate stop/kill when UI can't prompt.  Major upgrades are
           not "Installed" from the incoming package's perspective, but they
           still need the same early quiesce before MSI StopServices waits. -->
      <Custom Action="SetKillProcsQuietImmediate" Before="InstallValidate">((Installed OR WIX_UPGRADE_DETECTED) AND NOT REMOVE AND UILevel &lt; 5) OR (REMOVE = "ALL" AND NOT UPGRADINGPRODUCTCODE)</Custom>
      <Custom Action="KillProcsQuietImmediate" After="SetKillProcsQuietImmediate">((Installed OR WIX_UPGRADE_DETECTED) AND NOT REMOVE AND UILevel &lt; 5) OR (REMOVE = "ALL" AND NOT UPGRADINGPRODUCTCODE)</Custom>
      <Custom Action="SetStopSvcQuietImmediate" After="KillProcsQuietImmediate">((Installed OR WIX_UPGRADE_DETECTED) AND NOT REMOVE AND UILevel &lt; 5) OR (REMOVE = "ALL" AND NOT UPGRADINGPRODUCTCODE)</Custom>
      <Custom Action="StopSvcQuietImmediate" After="SetStopSvcQuietImmediate">((Installed OR WIX_UPGRADE_DETECTED) AND NOT REMOVE AND UILevel &lt; 5) OR (REMOVE = "ALL" AND NOT UPGRADINGPRODUCTCODE)</Custom>

      <!-- Stop service proactively on repair or uninstall -->
      <Custom Action="SetStopSvcQuiet" After="InstallInitialize">((WIX_UPGRADE_DETECTED OR (REMOVE = "ALL" AND NOT UPGRADINGPRODUCTCODE)) OR ((Installed OR WIX_UPGRADE_DETECTED) AND NOT REMOVE AND UILevel &lt; 5))</Custom>
      <Custom Action="StopSvcQuiet" After="SetStopSvcQuiet">((WIX_UPGRADE_DETECTED OR (REMOVE = "ALL" AND NOT UPGRADINGPRODUCTCODE)) OR ((Installed OR WIX_UPGRADE_DETECTED) AND NOT REMOVE AND UILevel &lt; 5))</Custom>

      <!-- Start quietly on repair with basic/silent UI -->
      <Custom Action="SetStartSvcQuiet" Before="StartSvcQuiet">Installed AND NOT REMOVE AND UILevel &lt; 5</Custom>
      <Custom Action="StartSvcQuiet" Before="InstallFinalize">Installed AND NOT REMOVE AND UILevel &lt; 5</Custom>

      <!-- Manual uninstall: process/legacy service cleanup -->
      <Custom Action="SetCleanupTerminalSeats" After="StopSvcQuiet">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="CleanupTerminalSeats" After="SetCleanupTerminalSeats">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="SetKillProcsQuiet" After="CleanupTerminalSeats">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="KillProcsQuiet" After="SetKillProcsQuiet">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="SetRemoveServiceQuiet" After="KillProcsQuiet">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="RemoveServiceQuiet" After="SetRemoveServiceQuiet">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>

      <!-- Post-install chores -->
      <Custom Action="SetResetAcls" After="InstallFiles">NOT REMOVE</Custom>
      <Custom Action="ResetAcls" After="SetResetAcls">NOT REMOVE</Custom>
      <Custom Action="SetInstallSudovda" After="ResetAcls">NOT REMOVE AND INSTALL_SUDOVDA = "1"</Custom>
      <Custom Action="InstallSudovda" After="SetInstallSudovda">NOT REMOVE AND INSTALL_SUDOVDA = "1"</Custom>
      <Custom Action="SetInstallVirtualDisplayDriver" After="InstallSudovda">NOT REMOVE AND INSTALL_VIRTUAL_DISPLAY_DRIVER &lt;&gt; "0"</Custom>
      <Custom Action="InstallVirtualDisplayDriver" After="SetInstallVirtualDisplayDriver">NOT REMOVE AND INSTALL_VIRTUAL_DISPLAY_DRIVER &lt;&gt; "0"</Custom>
      <Custom Action="SetRegisterVulkanHdrLayer" After="InstallVirtualDisplayDriver">NOT REMOVE AND INSTALL_VIRTUAL_DISPLAY_DRIVER &lt;&gt; "0"</Custom>
      <Custom Action="RegisterVulkanHdrLayer" After="SetRegisterVulkanHdrLayer">NOT REMOVE AND INSTALL_VIRTUAL_DISPLAY_DRIVER &lt;&gt; "0"</Custom>
<?if $(var.TerminalIsolationEnabled) = "1" ?>
      <!-- Schedule MSI rollback before the deferred activation.  The action
           does not reboot or restart TermService; it restores only an owned
           ServiceDll and leaves post-boot verification armed. -->
      <Custom Action="SetTerminalIsolationInstall" After="RegisterVulkanHdrLayer">NOT REMOVE AND INSTALL_TERMINAL_ISOLATION = "1"</Custom>
      <Custom Action="SetTerminalIsolationMsiRollback" After="SetTerminalIsolationInstall">NOT REMOVE AND INSTALL_TERMINAL_ISOLATION = "1"</Custom>
      <Custom Action="TerminalIsolationMsiRollback" After="SetTerminalIsolationMsiRollback">NOT REMOVE AND INSTALL_TERMINAL_ISOLATION = "1"</Custom>
      <Custom Action="TerminalIsolationInstall" After="TerminalIsolationMsiRollback">NOT REMOVE AND INSTALL_TERMINAL_ISOLATION = "1"</Custom>
      <Custom Action="SetTerminalIsolationRebootInstall" After="TerminalIsolationInstall">NOT REMOVE AND INSTALL_TERMINAL_ISOLATION = "1"</Custom>
      <Custom Action="TerminalIsolationRebootProbeInstall" After="SetTerminalIsolationRebootInstall">NOT REMOVE AND INSTALL_TERMINAL_ISOLATION = "1"</Custom>
<?endif?>
      <Custom Action="SetMigrateConfig" After="RegisterVulkanHdrLayer">NOT Installed AND NOT REMOVE</Custom>
      <Custom Action="MigrateConfig" After="SetMigrateConfig">NOT Installed AND NOT REMOVE</Custom>
      <Custom Action="SetRunInstallerMigrations" After="MigrateConfig">NOT Installed AND NOT REMOVE</Custom>
      <Custom Action="RunInstallerMigrations" After="SetRunInstallerMigrations">NOT Installed AND NOT REMOVE</Custom>

      <!-- Roll back the old product for both manual uninstall and major
           replacement.  Property 0 therefore leaves the incoming product
           native; only an explicit property 1 may re-arm it. -->
<?if $(var.TerminalIsolationEnabled) = "1" ?>
      <!-- Only an actually installed optional component invokes the
           manifest-bound helper.  A package without the optional component
           makes property-0 uninstall a no-op for terminal isolation. -->
      <Custom Action="SetTerminalIsolationUninstallRollback" Before="TerminalIsolationUninstallRollback">REMOVE="ALL" AND ?TerminalIsolationPayload = 3</Custom>
      <Custom Action="TerminalIsolationUninstallRollback" Before="TerminalIsolationUninstall">REMOVE="ALL" AND ?TerminalIsolationPayload = 3</Custom>
      <Custom Action="SetTerminalIsolationUninstall" Before="TerminalIsolationUninstall">REMOVE="ALL" AND ?TerminalIsolationPayload = 3</Custom>
      <Custom Action="TerminalIsolationUninstall" Before="RemoveFiles">REMOVE="ALL" AND ?TerminalIsolationPayload = 3</Custom>
      <Custom Action="SetTerminalIsolationRebootUninstall" After="TerminalIsolationUninstall">REMOVE="ALL" AND ?TerminalIsolationPayload = 3</Custom>
      <Custom Action="TerminalIsolationRebootProbeUninstall" After="SetTerminalIsolationRebootUninstall">REMOVE="ALL" AND ?TerminalIsolationPayload = 3</Custom>
<?endif?>
      <Custom Action="SetRestoreNvPrefsUndo" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="RestoreNvPrefsUndo" After="SetRestoreNvPrefsUndo">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>

      <!-- MSI owns reboot scheduling.  The native CA only publishes whether
           its committed action left a pending restart; REBOOT=ReallySuppress
           is intentionally left to Windows Installer so it returns 3010
           without rebooting automatically. -->
      <ScheduleReboot After="InstallFinalize">VIBESHINE_TERMINAL_REBOOT = "1" AND ((NOT REMOVE) OR (REMOVE = "ALL" AND NOT UPGRADINGPRODUCTCODE))</ScheduleReboot>

      <!-- Remove Virtual Display Driver only when explicitly requested by uninstall properties. -->
      <Custom Action="SetUnregisterVulkanHdrLayer" After="RestoreNvPrefsUndo">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="UnregisterVulkanHdrLayer" After="SetUnregisterVulkanHdrLayer">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="SetUninstallSudovda" After="UnregisterVulkanHdrLayer">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND REMOVEVIRTUALDISPLAYDRIVER = "1"</Custom>
      <Custom Action="UninstallSudovda" After="SetUninstallSudovda">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND REMOVEVIRTUALDISPLAYDRIVER = "1"</Custom>
      <Custom Action="SetUninstallVirtualDisplayDriver" After="UninstallSudovda">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND REMOVEVIRTUALDISPLAYDRIVER = "1"</Custom>
      <Custom Action="UninstallVirtualDisplayDriver" After="SetUninstallVirtualDisplayDriver">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND REMOVEVIRTUALDISPLAYDRIVER = "1"</Custom>

      <!-- Factory reset only removes known Vibeshine app data. MSI-owned files are removed by MSI itself. -->
      <Custom Action="SetFactoryResetAppData" After="UninstallVirtualDisplayDriver">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND (FACTORYRESET = "1" OR DELETEINSTALLDIR = "1")</Custom>
      <Custom Action="FactoryResetAppData" After="SetFactoryResetAppData">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND (FACTORYRESET = "1" OR DELETEINSTALLDIR = "1")</Custom>

      <!-- After MSI has removed its tracked files, remove the install root only if it is empty. -->
      <Custom Action="SetCleanupEmptyInstallRoot" After="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="CleanupEmptyInstallRoot" After="SetCleanupEmptyInstallRoot">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>

    <InstallUISequence>
      <!-- Legacy Sunshine handling flow -->
      <!-- 1. Ask user if they want to uninstall legacy Sunshine (and launch if they agree) -->
      <Custom Action="AskUninstallLegacySunshine" After="AppSearch">LEGACY_SUNSHINE_PRESENT AND UILevel &gt; 2 AND NOT Installed</Custom>
      
      <!-- 2. Wait for uninstall to complete and verify it's gone -->
      <Custom Action="WaitForLegacyUninstall" After="AskUninstallLegacySunshine">UNINSTALL_LEGACY_SUNSHINE = "1" AND NOT USER_CANCELLED_LEGACY_UNINSTALL</Custom>
      
      <!-- 3. Block if user cancelled at any point -->
      <Custom Action="BlockUserCancelledLegacy" Before="LaunchConditions">USER_CANCELLED_LEGACY_UNINSTALL = "1"</Custom>
      
      <!-- 4. Block if legacy Sunshine is still present after user claimed to uninstall it -->
      <Custom Action="BlockLegacySunshineStillPresent" Before="LaunchConditions">LEGACY_SUNSHINE_STILL_PRESENT = "1"</Custom>
      
      <Custom Action="RepairCompletePrompt" After="ExecuteAction">REINSTALL AND NOT REMOVE AND NOT UPGRADINGPRODUCTCODE AND UILevel &gt; 2</Custom>
    </InstallUISequence>
  </CPackWiXFragment>
</CPackWiXPatch>
