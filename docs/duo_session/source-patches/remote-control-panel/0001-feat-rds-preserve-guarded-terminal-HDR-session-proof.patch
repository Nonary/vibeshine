+# closed until the offline preflight is repeated and these values are reviewed.
+$ExpectedTermSrvHash = "F2D3150C45E3FE5DBF294ABC6ED8326D6D36936FDFF256F7E805CFF55F9B1AEA"
+$ExpectedWrapperHash = "220F18E0B2C2091C5F684EC063C43831BFFDF25E561BD123211CCE883F8D25E2"
+$ExpectedZydisHash = "5908BE0AF05BF7584328CF5D0DDDE2C108D693709FFC77A13822FDCEB75797E1"
