+/**
+ * @brief Duplicate the caller's LocalSystem token into a requested session.
+ *
+ * This proof-only fallback is useful before an RDS seat has published a WTS
+ * user token. It refuses non-LocalSystem callers and changes only the duplicate
+ * token's session ID; the caller's token is never modified.
+ *
+ * @param sessionId Target Windows session ID.
+ * @return Primary LocalSystem token assigned to the target session, or null.
+ */
+static HANDLE OpenLocalSystemSessionToken(DWORD sessionId) {
+  EnablePrivilege(L"SeTcbPrivilege");
+
+  if (!IsCurrentProcessLocalSystem()) {
+    SetLastError(ERROR_ACCESS_DENIED);
+    return nullptr;
+  }
+
+  HANDLE processToken = nullptr;
+  if (!OpenProcessToken(GetCurrentProcess(), TOKEN_DUPLICATE | TOKEN_QUERY, &processToken)) {
+    return nullptr;
+  }
+
+  HANDLE primary = nullptr;
+  const BOOL duplicated = DuplicateTokenEx(
+    processToken,
+    MAXIMUM_ALLOWED,
+    nullptr,
+    SecurityImpersonation,
+    TokenPrimary,
+    &primary);
+  CloseHandle(processToken);
+  if (!duplicated) {
+    return nullptr;
+  }
+
+  if (!SetTokenInformation(primary, TokenSessionId, &sessionId, sizeof(sessionId))) {
+    const DWORD error = GetLastError();
+    CloseHandle(primary);
+    SetLastError(error);
+    return nullptr;
+  }
+
+  return primary;
+}
