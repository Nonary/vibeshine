+  /**
+   * @brief Return the current token user SID as a string.
+   *
+   * @return SID text or `unknown`.
+   */
+  std::wstring
+    GetCurrentSid() {
+    HANDLE token = nullptr;
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) {
+      return L"unknown";
+    }
+
+    DWORD bytes = 0;
+    GetTokenInformation(token, TokenUser, nullptr, 0, &bytes);
+    std::vector<BYTE> buffer(bytes);
+    if (!bytes || !GetTokenInformation(token, TokenUser, buffer.data(), bytes, &bytes)) {
+      CloseHandle(token);
+      return L"unknown";
+    }
+
+    auto *user = reinterpret_cast<TOKEN_USER *>(buffer.data());
+    wchar_t *sid_text = nullptr;
+    std::wstring result = L"unknown";
+    if (ConvertSidToStringSidW(user->User.Sid, &sid_text)) {
+      result = sid_text;
+      LocalFree(sid_text);
+    }
+    CloseHandle(token);
+    return result;
+  }
+
+  /**
+   * @brief Append an identity-attributed guard line.
+   *
+   * @param message Message to record.
+   */
+  void
+    Log(const wchar_t *message) {
+    if (!EnsureProofDirectory()) {
+      return;
+    }
+
+    wchar_t user[256] = {};
+    DWORD user_count = ARRAYSIZE(user);
+    if (!GetUserNameW(user, &user_count)) {
+      StringCchCopyW(user, ARRAYSIZE(user), L"unknown");
+    }
+
+    SYSTEMTIME now = {};
+    GetLocalTime(&now);
+    wchar_t line[2048] = {};
+    const std::wstring sid = GetCurrentSid();
+    if (FAILED(StringCchPrintfW(
+          line,
+          ARRAYSIZE(line),
+          L"%04hu-%02hu-%02hu %02hu:%02hu:%02hu.%03hu pid=%lu identity=%s sid=%s %s\r\n",
+          now.wYear,
+          now.wMonth,
+          now.wDay,
+          now.wHour,
+          now.wMinute,
+          now.wSecond,
+          now.wMilliseconds,
+          GetCurrentProcessId(),
+          user,
+          sid.c_str(),
+          message
+        ))) {
+      return;
+    }
+
+    const std::wstring path = JoinPath(GetProofDirectory(), L"guard.log");
+    const HANDLE file = CreateFileW(
+      path.c_str(),
+      FILE_APPEND_DATA,
+      FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+      nullptr,
+      OPEN_ALWAYS,
+      FILE_ATTRIBUTE_NORMAL,
+      nullptr
+    );
+    if (file == INVALID_HANDLE_VALUE) {
+      return;
+    }
+
+    char utf8[8192] = {};
+    const int count = WideCharToMultiByte(CP_UTF8, 0, line, -1, utf8, ARRAYSIZE(utf8), nullptr, nullptr);
+    if (count > 1) {
+      DWORD written = 0;
+      WriteFile(file, utf8, static_cast<DWORD>(count - 1), &written, nullptr);
+    }
+    CloseHandle(file);
+  }
