+static bool ObserveDriverOwnedRemoteIddDesktopMode(const MonitorDesc &desc) {
+  const ULONGLONG deadline = GetTickCount64() + 5000;
+  do {
+    std::uint32_t remote_index = 0;
+    for (DWORD index = 0;; ++index) {
+      DISPLAY_DEVICEW adapter {};
+      adapter.cb = sizeof(adapter);
+      if (!EnumDisplayDevicesW(nullptr, index, &adapter, 0)) {
+        break;
+      }
+      if (!IsSunshineRemoteIddDisplayDevice(adapter)) {
+        continue;
+      }
+
+      ++remote_index;
+      if (desc.MonitorIndex != 0 && remote_index != desc.MonitorIndex) {
+        continue;
+      }
+
+      DEVMODEW current_mode {};
+      current_mode.dmSize = sizeof(current_mode);
+      const bool active = (adapter.StateFlags & DISPLAY_DEVICE_ACTIVE) != 0;
+      if (active && EnumDisplaySettingsExW(adapter.DeviceName, ENUM_CURRENT_SETTINGS, &current_mode, 0)) {
+        wprintf(
+          L"Remote IDD driver-owned mode on %ls: %lux%lu@%lu fields=0x%08lx bits=%lu match=%ls\n",
+          adapter.DeviceName,
+          current_mode.dmPelsWidth,
+          current_mode.dmPelsHeight,
+          current_mode.dmDisplayFrequency,
+          current_mode.dmFields,
+          current_mode.dmBitsPerPel,
