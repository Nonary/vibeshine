+  /**
+   * @brief Create the current-boot-only runtime arming key.
+   *
+   * @return True only when a new volatile key and marker were created.
+   */
+  bool CreateRuntimeArm() {
+    HKEY existing = nullptr;
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, kRuntimeArmRegistryPath, 0, KEY_READ, &existing) == ERROR_SUCCESS) {
+      RegCloseKey(existing);
+      return false;
+    }
+
+    PSECURITY_DESCRIPTOR security_descriptor = nullptr;
+    if (!ConvertStringSecurityDescriptorToSecurityDescriptorW(
+          L"D:P(A;;KA;;;SY)(A;;KA;;;BA)(A;;KR;;;NS)",
+          SDDL_REVISION_1,
+          &security_descriptor,
+          nullptr
+        )) {
+      return false;
+    }
+    SECURITY_ATTRIBUTES attributes = {sizeof(attributes), security_descriptor, FALSE};
+
+    HKEY key = nullptr;
+    DWORD disposition = 0;
+    const LSTATUS status = RegCreateKeyExW(
+      HKEY_LOCAL_MACHINE,
+      kRuntimeArmRegistryPath,
+      0,
+      nullptr,
+      REG_OPTION_VOLATILE,
+      KEY_READ | KEY_WRITE,
+      &attributes,
+      &key,
+      &disposition
+    );
+    LocalFree(security_descriptor);
+    if (status != ERROR_SUCCESS || disposition != REG_CREATED_NEW_KEY) {
+      if (key) {
+        RegCloseKey(key);
+      }
+      return false;
+    }
+
+    const bool success = SetDword(key, L"Armed", 1) == ERROR_SUCCESS;
+    RegCloseKey(key);
+    if (!success) {
+      RegDeleteTreeW(HKEY_LOCAL_MACHINE, kRuntimeArmRegistryPath);
+    }
+    return success;
+  }
+
+  /**
+   * @brief Enable the proof listener after verifying its identity and marker.
+   *
+   * @param expected_clsid Exact protocol-manager CLSID permitted for this
+   * activation path.
+   * @return Zero on success.
+   */
+  int EnableListenerForCurrentBoot(const wchar_t *expected_clsid) {
+    HKEY key = nullptr;
+    LSTATUS status = OpenListener(kProofListenerName, KEY_QUERY_VALUE | KEY_SET_VALUE, &key);
+    if (status != ERROR_SUCCESS) {
+      return Fail(L"open proof listener", status);
+    }
+
+    DWORD owned = 0;
+    wchar_t clsid[128] = {};
+    DWORD type = 0;
+    DWORD bytes = sizeof(clsid);
+    const bool identity_matches =
+      QueryDword(key, kProofOwnedMarkerName, &owned) && owned == 1 &&
+      RegQueryValueExW(key, L"LoadableProtocol_Object", nullptr, &type, reinterpret_cast<BYTE *>(clsid), &bytes) == ERROR_SUCCESS &&
+      type == REG_SZ && _wcsicmp(clsid, expected_clsid) == 0;
+    if (!identity_matches) {
+      RegCloseKey(key);
+      return Fail(L"verify proof listener identity", ERROR_INVALID_DATA);
+    }
+
+    if (!CreateRuntimeArm()) {
+      RegCloseKey(key);
+      return Fail(L"create volatile runtime arm", ERROR_ALREADY_EXISTS);
+    }
+
+    status = SetDword(key, L"fLogonDisabled", 0);
+    if (status == ERROR_SUCCESS) {
+      status = SetDword(key, L"WinStationDisabled", 0);
+    }
+    if (status == ERROR_SUCCESS) {
+      status = SetDword(key, L"fEnableWinStation", 1);
+    }
+    RegCloseKey(key);
+    if (status != ERROR_SUCCESS) {
+      DisableListener(kProofListenerName);
+      RegDeleteTreeW(HKEY_LOCAL_MACHINE, kRuntimeArmRegistryPath);
+      return Fail(L"enable proof listener for current boot", status);
+    }
+
+    Log(L"enabled persistent proof listener with volatile current-boot arm");
+    wprintf(L"enabled listener %s for current boot\n", kProofListenerName);
+    return 0;
+  }
+
+  /**
+   * @brief Return whether the expected helper is currently running.
+   *
+   * @param terminate Whether matching processes should be terminated.
+   * @return Number of matching processes encountered.
+   */
+  DWORD
+  FindExpectedHelpers(bool terminate) {
+    const std::wstring expected = NormalizePath(JoinPath(GetProofDirectory(), kProofHelperName));
+    DWORD matches = 0;
+    const HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
+    if (snapshot == INVALID_HANDLE_VALUE) {
+      return 0;
+    }
+
+    PROCESSENTRY32W entry = {};
+    entry.dwSize = sizeof(entry);
+    if (Process32FirstW(snapshot, &entry)) {
+      do {
+        if (_wcsicmp(entry.szExeFile, kProofHelperName) != 0) {
+          continue;
+        }
+
+        const HANDLE process = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION | (terminate ? PROCESS_TERMINATE | SYNCHRONIZE : 0), FALSE, entry.th32ProcessID);
+        if (!process) {
+          continue;
+        }
+        wchar_t path[MAX_PATH] = {};
+        DWORD count = ARRAYSIZE(path);
+        if (QueryFullProcessImageNameW(process, 0, path, &count) && NormalizePath(path) == expected) {
+          ++matches;
+          if (terminate) {
+            TerminateProcess(process, ERROR_OPERATION_ABORTED);
+            WaitForSingleObject(process, 2000);
+          }
+        }
+        CloseHandle(process);
+      } while (Process32NextW(snapshot, &entry));
+    }
+    CloseHandle(snapshot);
+    return matches;
+  }
