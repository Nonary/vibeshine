+
+namespace {
+  void Log(const wchar_t *format, ...) {
+    wchar_t root[MAX_PATH] = {};
+    if (!GetEnvironmentVariableW(L"ProgramData", root, ARRAYSIZE(root))) {
+      StringCchCopyW(root, ARRAYSIZE(root), L"C:\\ProgramData");
+    }
+    wchar_t path[MAX_PATH] = {};
+    StringCchPrintfW(path, ARRAYSIZE(path), L"%s\\Sunshine\\RdpProtocolProvider\\dxgi-hdr-source-pin.log", root);
+
+    wchar_t message[2048] = {};
+    va_list args;
+    va_start(args, format);
+    StringCchVPrintfW(message, ARRAYSIZE(message), format, args);
+    va_end(args);
+
+    DWORD session = 0xffffffff;
+    ProcessIdToSessionId(GetCurrentProcessId(), &session);
+    SYSTEMTIME now = {};
+    GetLocalTime(&now);
+    wchar_t line[2304] = {};
+    StringCchPrintfW(
+      line,
+      ARRAYSIZE(line),
+      L"%04hu-%02hu-%02hu %02hu:%02hu:%02hu.%03hu pid=%lu session=%lu %s\r\n",
+      now.wYear,
+      now.wMonth,
+      now.wDay,
+      now.wHour,
+      now.wMinute,
+      now.wSecond,
+      now.wMilliseconds,
+      GetCurrentProcessId(),
+      session,
+      message
+    );
+    HANDLE file = CreateFileW(
+      path,
+      FILE_APPEND_DATA,
+      FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+      nullptr,
+      OPEN_ALWAYS,
+      FILE_ATTRIBUTE_NORMAL,
+      nullptr
+    );
+    if (file == INVALID_HANDLE_VALUE) {
+      file = CreateFileW(
+        L"C:\\Users\\Public\\Documents\\SunshineRdpDxgiHdrSourcePin.log",
+        FILE_APPEND_DATA,
+        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+        nullptr,
+        OPEN_ALWAYS,
+        FILE_ATTRIBUTE_NORMAL,
+        nullptr
+      );
+    }
+    if (file != INVALID_HANDLE_VALUE) {
+      DWORD bytes = 0;
+      WriteFile(file, line, static_cast<DWORD>(wcslen(line) * sizeof(wchar_t)), &bytes, nullptr);
+      CloseHandle(file);
+    }
+  }
+
+  LRESULT CALLBACK WindowProc(HWND window, UINT message, WPARAM wparam, LPARAM lparam) {
+    return DefWindowProcW(window, message, wparam, lparam);
+  }
+
+  struct DisplayState {
+    bool found = false;
+    bool active = false;
+    bool hdr_supported = false;
+    bool hdr_enabled = false;
+    UINT32 bpc = 0;
+    UINT32 active_mode = 0;
+    UINT32 source_format = 0xffffffff;
+  };
+
+  DisplayState QueryState(const wchar_t *device_name) {
+    DisplayState state = {};
+    constexpr UINT32 flags = QDC_ONLY_ACTIVE_PATHS | QDC_VIRTUAL_MODE_AWARE;
+    UINT32 path_count = 0;
+    UINT32 mode_count = 0;
+    if (GetDisplayConfigBufferSizes(flags, &path_count, &mode_count) != ERROR_SUCCESS) {
+      return state;
+    }
+    std::vector<DISPLAYCONFIG_PATH_INFO> paths(path_count);
+    std::vector<DISPLAYCONFIG_MODE_INFO> modes(mode_count);
+    if (QueryDisplayConfig(flags, &path_count, paths.data(), &mode_count, modes.data(), nullptr) != ERROR_SUCCESS) {
+      return state;
+    }
+    for (UINT32 index = 0; index < path_count; ++index) {
+      DISPLAYCONFIG_SOURCE_DEVICE_NAME source = {};
+      source.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_SOURCE_NAME;
+      source.header.size = sizeof(source);
+      source.header.adapterId = paths[index].sourceInfo.adapterId;
+      source.header.id = paths[index].sourceInfo.id;
+      if (DisplayConfigGetDeviceInfo(&source.header) != ERROR_SUCCESS ||
+          _wcsicmp(source.viewGdiDeviceName, device_name) != 0) {
+        continue;
+      }
+      DISPLAYCONFIG_GET_ADVANCED_COLOR_INFO_2 color = {};
+      color.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_ADVANCED_COLOR_INFO_2;
+      color.header.size = sizeof(color);
+      color.header.adapterId = paths[index].targetInfo.adapterId;
+      color.header.id = paths[index].targetInfo.id;
+      if (DisplayConfigGetDeviceInfo(&color.header) != ERROR_SUCCESS) {
+        continue;
+      }
+      state.found = true;
+      state.active = color.advancedColorActive != 0;
+      state.hdr_supported = color.highDynamicRangeSupported != 0;
+      state.hdr_enabled = color.highDynamicRangeUserEnabled != 0;
+      state.bpc = color.bitsPerColorChannel;
+      state.active_mode = static_cast<UINT32>(color.activeColorMode);
+      const UINT32 mode_index = paths[index].sourceInfo.sourceModeInfoIdx;
+      if (mode_index != DISPLAYCONFIG_PATH_SOURCE_MODE_IDX_INVALID && mode_index < mode_count &&
+          modes[mode_index].infoType == DISPLAYCONFIG_MODE_INFO_TYPE_SOURCE) {
+        state.source_format = static_cast<UINT32>(modes[mode_index].sourceMode.pixelFormat);
+      }
+      break;
+    }
+    return state;
+  }
+
+  void LogState(const wchar_t *label, const wchar_t *device_name) {
+    const auto state = QueryState(device_name);
+    Log(
+      L"%s display=%s found=%d active=%d hdr_supported=%d hdr_enabled=%d bpc=%lu active_mode=%lu source_format=%lu",
+      label,
+      device_name,
+      state.found,
+      state.active,
+      state.hdr_supported,
+      state.hdr_enabled,
+      state.bpc,
+      state.active_mode,
+      state.source_format
+    );
+  }
+
+  int RunD3dKmtOwnerMatrix() {
+    DWORD session = 0xffffffff;
+    ProcessIdToSessionId(GetCurrentProcessId(), &session);
+    Log(L"D3DKMT owner matrix begin process_session=%lu", session);
+
+    constexpr UINT32 flags = QDC_ONLY_ACTIVE_PATHS | QDC_VIRTUAL_MODE_AWARE;
+    UINT32 path_count = 0;
+    UINT32 mode_count = 0;
+    LONG result = GetDisplayConfigBufferSizes(flags, &path_count, &mode_count);
+    if (result != ERROR_SUCCESS) {
+      Log(L"D3DKMT owner matrix GetDisplayConfigBufferSizes result=%ld", result);
+      return 30;
+    }
+    std::vector<DISPLAYCONFIG_PATH_INFO> paths(path_count);
+    std::vector<DISPLAYCONFIG_MODE_INFO> modes(mode_count);
+    result = QueryDisplayConfig(flags, &path_count, paths.data(), &mode_count, modes.data(), nullptr);
+    if (result != ERROR_SUCCESS || path_count != 1) {
+      Log(L"D3DKMT owner matrix QueryDisplayConfig result=%ld paths=%lu", result, path_count);
+      return 31;
+    }
+
+    const LUID adapter_luid = paths[0].sourceInfo.adapterId;
+    const D3DDDI_VIDEO_PRESENT_SOURCE_ID source_id = paths[0].sourceInfo.id;
+    Log(
+      L"D3DKMT owner matrix target adapter=%08lx:%08lx source_id=%lu",
+      adapter_luid.HighPart,
+      adapter_luid.LowPart,
+      source_id
+    );
+
+    D3DKMT_OPENADAPTERFROMLUID open = {};
+    open.AdapterLuid = adapter_luid;
+    NTSTATUS status = D3DKMTOpenAdapterFromLuid(&open);
+    Log(L"D3DKMTOpenAdapterFromLuid status=0x%08lx handle=0x%08lx", status, open.hAdapter);
+    if (status < 0) {
+      return 32;
+    }
+
+    struct OwnerAttempt {
+      D3DKMT_VIDPNSOURCEOWNER_TYPE type;
+      const wchar_t *name;
+    };
+    constexpr OwnerAttempt attempts[] = {
+      {D3DKMT_VIDPNSOURCEOWNER_EMULATED, L"emulated"},
+      {D3DKMT_VIDPNSOURCEOWNER_SHARED, L"shared"},
+      {D3DKMT_VIDPNSOURCEOWNER_EXCLUSIVE, L"exclusive"},
+    };
+
+    for (const auto &attempt : attempts) {
+      D3DKMT_CREATEDEVICE create = {};
+      create.hAdapter = open.hAdapter;
+      status = D3DKMTCreateDevice(&create);
+      Log(L"D3DKMTCreateDevice owner=%s status=0x%08lx handle=0x%08lx", attempt.name, status, create.hDevice);
+      if (status < 0) {
+        continue;
+      }
+
+      const auto owner_type = attempt.type;
+      const auto owner_source_id = source_id;
+      D3DKMT_SETVIDPNSOURCEOWNER owner = {};
+      owner.hDevice = create.hDevice;
+      owner.pType = &owner_type;
+      owner.pVidPnSourceId = &owner_source_id;
+      owner.VidPnSourceCount = 1;
+      status = D3DKMTSetVidPnSourceOwner(&owner);
+      Log(L"D3DKMTSetVidPnSourceOwner owner=%s status=0x%08lx", attempt.name, status);
+      if (status >= 0) {
+        Sleep(250);
+        const NTSTATUS release = D3DKMTReleaseProcessVidPnSourceOwners(GetCurrentProcess());
+        Log(L"D3DKMTReleaseProcessVidPnSourceOwners owner=%s status=0x%08lx", attempt.name, release);
+      }
+      D3DKMT_DESTROYDEVICE destroy = {};
+      destroy.hDevice = create.hDevice;
+      const NTSTATUS destroy_status = D3DKMTDestroyDevice(&destroy);
+      Log(L"D3DKMTDestroyDevice owner=%s status=0x%08lx", attempt.name, destroy_status);
+    }
+
+    D3DKMT_CLOSEADAPTER close = {};
+    close.hAdapter = open.hAdapter;
+    status = D3DKMTCloseAdapter(&close);
+    Log(L"D3DKMT owner matrix complete close_status=0x%08lx", status);
+    return 0;
+  }
+
+  int RunD3dKmtSharedPrimaryInspect() {
+    DWORD session = 0xffffffff;
+    ProcessIdToSessionId(GetCurrentProcessId(), &session);
+    Log(L"D3DKMT shared-primary inspect begin process_session=%lu", session);
+
+    constexpr UINT32 query_flags = QDC_ONLY_ACTIVE_PATHS | QDC_VIRTUAL_MODE_AWARE;
+    UINT32 path_count = 0;
+    UINT32 mode_count = 0;
+    LONG result = GetDisplayConfigBufferSizes(query_flags, &path_count, &mode_count);
+    if (result != ERROR_SUCCESS || path_count != 1) {
+      Log(L"D3DKMT shared-primary GetDisplayConfigBufferSizes result=%ld paths=%lu", result, path_count);
+      return 70;
+    }
+    std::vector<DISPLAYCONFIG_PATH_INFO> paths(path_count);
+    std::vector<DISPLAYCONFIG_MODE_INFO> modes(mode_count);
+    result = QueryDisplayConfig(query_flags, &path_count, paths.data(), &mode_count, modes.data(), nullptr);
+    if (result != ERROR_SUCCESS || path_count != 1) {
+      Log(L"D3DKMT shared-primary QueryDisplayConfig result=%ld paths=%lu", result, path_count);
+      return 71;
+    }
+    const auto &path = paths[0];
+
+    D3DKMT_OPENADAPTERFROMLUID open_adapter = {};
+    open_adapter.AdapterLuid = path.sourceInfo.adapterId;
+    NTSTATUS status = D3DKMTOpenAdapterFromLuid(&open_adapter);
+    Log(
+      L"D3DKMT shared-primary OpenAdapter status=0x%08lx adapter=%08lx:%08lx handle=0x%08lx source=%lu",
+      status,
+      path.sourceInfo.adapterId.HighPart,
+      path.sourceInfo.adapterId.LowPart,
+      open_adapter.hAdapter,
+      path.sourceInfo.id
+    );
+    if (status < 0) {
+      return 72;
+    }
+
+    D3DKMT_CREATEDEVICE create_device = {};
+    create_device.hAdapter = open_adapter.hAdapter;
+    status = D3DKMTCreateDevice(&create_device);
+    Log(L"D3DKMT shared-primary CreateDevice status=0x%08lx handle=0x%08lx", status, create_device.hDevice);
+    if (status < 0) {
+      D3DKMT_CLOSEADAPTER close = {open_adapter.hAdapter};
+      D3DKMTCloseAdapter(&close);
+      return 73;
+    }
+
+    D3DKMT_GETSHAREDPRIMARYHANDLE get_primary = {};
+    get_primary.hAdapter = open_adapter.hAdapter;
+    get_primary.VidPnSourceId = path.sourceInfo.id;
+    status = D3DKMTGetSharedPrimaryHandle(&get_primary);
+    Log(
+      L"D3DKMT shared-primary GetSharedPrimaryHandle status=0x%08lx global=0x%08lx",
+      status,
+      get_primary.hSharedPrimary
+    );
+
+    D3DKMT_HANDLE opened_resource = 0;
+    if (status >= 0 && get_primary.hSharedPrimary != 0) {
+      D3DKMT_QUERYRESOURCEINFO resource_info = {};
