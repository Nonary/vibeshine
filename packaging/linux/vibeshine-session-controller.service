[Unit]
Description=Vibeshine machine session controller
Documentation=https://github.com/Nonary/vibeshine
Wants=display-manager.service systemd-logind.service systemd-user-sessions.service vibeshine-vkms.service
After=display-manager.service systemd-logind.service systemd-user-sessions.service vibeshine-vkms.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/libexec/vibeshine/vibeshine-session-controller run
ExecStopPost=/usr/libexec/vibeshine/vibeshine-session-controller cleanup
Restart=always
RestartSec=1
RestartSteps=7
RestartMaxDelaySec=30
TimeoutStopSec=35
MemoryMax=512M
TasksMax=128
UMask=0077
RuntimeDirectory=vibeshine
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

User=root
SupplementaryGroups=vibeshine
CapabilityBoundingSet=CAP_SETGID CAP_SETUID
AmbientCapabilities=CAP_SETUID
NoNewPrivileges=yes

DevicePolicy=closed
PrivateDevices=yes
PrivateTmp=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/run/user
ProtectProc=invisible
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=~@clock @debug @module @mount @raw-io @reboot @swap
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any

[Install]
WantedBy=graphical.target
