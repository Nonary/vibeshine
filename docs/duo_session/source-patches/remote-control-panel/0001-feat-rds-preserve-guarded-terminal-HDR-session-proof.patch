+  /**
+   * @brief Convert a Win32 status into a process exit code and diagnostic.
+   *
+   * @param operation Operation which failed.
+   * @param status Win32 status.
+   * @return One for failure.
+   */
+  int Fail(const wchar_t *operation, DWORD status) {
+    fwprintf(stderr, L"%s failed error=%lu\n", operation, status);
+    return 1;
